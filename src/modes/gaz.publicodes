# Chaudières gaz (indiv/coll, avec/sans condensation)
# Regroupe ratios, dimensionnement, calculs économiques,
# aides, émissions et bilan pour ce mode de chauffage.

###### Ratios techniques

gaz indiv avec cond:
  description: Chaudière gaz individuelle à condensation
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 33
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        conso auxiliaire ECS:
          valeur: 99.9%
          unité: '%'
        conso auxiliaire chauffage:
          valeur: 99.9%
          unité: '%'
        conso combustible:
          valeur: 0.0970
          unité: Nm3/kWh PCI
        durée de vie:
          valeur: 17
          unité: an
        gros entretien P3:
          par défaut: 70
          unité: €HT
        investissement équipement:
          produit:
            - variations:
                - si: gaz indiv avec cond . installation . gamme de puissance existante <= 12
                  alors: 2660
                - si: gaz indiv avec cond . installation . gamme de puissance existante <= 20
                  alors: 2810
                - si: gaz indiv avec cond . installation . gamme de puissance existante <= 25
                  alors: 2920
                - si: gaz indiv avec cond . installation . gamme de puissance existante <= 30
                  alors: 3220
                - sinon: 3620
            - 1 + ratios économiques . Investissement x TVA
          unité: €TTC
          note: 'Source: Atlantic 2023'
        petit entretien P2:
          par défaut: 143
          unité: €HT/an
        rendement chaudière ECS:
          valeur: 85%
          unité: '%'
        rendement chaudière chauffage:
          valeur: 85%
          unité: '%'
    installation:
      avec:
        production eau chaude sanitaire: Production eau chaude sanitaire
        puissance nécessaire équipement chauffage:
          formule: (Calcul . Chauffage Puissance chauffage appelée / ratios . rendement chaudière chauffage)
          unité: kW
        puissance nécessaire pour ECS avec équipement:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - type de production ECS = 'Avec équipement chauffage'
              alors: ratios . PUIS Coefficient de foisonnement ECS * (Calcul . ECS Puissance ECS appelée / ratios . rendement chaudière ECS)
            - sinon: 0
          unité: kW
        puissance équipement: &inst-puissance-equipement
          somme:
            - puissance nécessaire équipement chauffage
            - puissance nécessaire pour ECS avec équipement
          unité: kW
        gamme de puissance existante: &inst-gamme-de-puissance-existante
          variations:
            - si: puissance équipement <= 12
              alors: 12
            - si: puissance équipement <= 20
              alors: 20
            - si: puissance équipement <= 25
              alors: 25
            - si: puissance équipement <= 30
              alors: 30
            - sinon: 35
          unité: kW
        besoin d'installation supplémentaire pour produire l'ECS: &inst-besoin-d-installation-supplementaire-pour-produire-l-ecs
          toutes ces conditions:
            - Production eau chaude sanitaire
            - puissance nécessaire pour ECS avec équipement <= 0
        volume du ballon ECS: &inst-volume-du-ballon-ecs
          variations:
            - si:
                toutes ces conditions:
                  - besoin d'installation supplémentaire pour produire l'ECS
                  - type de production ECS != "Solaire thermique"
              alors: volume du ballon ECS
            - sinon: 50
          unité: L
        consommation d'électricité chauffe-eau électrique: &inst-consommation-d-electricite-chauffe-eau-electrique
          variations:
            - si:
                toutes ces conditions:
                  - besoin d'installation supplémentaire pour produire l'ECS
                  - type de production ECS != 'Solaire thermique'
              alors: chauffe-eau électrique x consommation d'électricité
            - sinon: 0
          unité: kWh/an
        appoint d'électricité chauffe-eau solaire: &inst-appoint-d-electricite-chauffe-eau-solaire
          variations:
            - si:
                toutes ces conditions:
                  - besoin d'installation supplémentaire pour produire l'ECS
                  - type de production ECS = 'Solaire thermique'
              alors: chauffe-eau solaire x appoint d'électricité
            - sinon: 0
          unité: kWh/an
        consommation combustible chaleur:
          produit:
            - ratios . conso combustible
            - somme:
                - besoins chauffage par appartement /  ratios . rendement chaudière chauffage
                - variations:
                    - si: type de production ECS = 'Avec équipement chauffage'
                      alors: besoins eau chaude sanitaire par appartement / ratios . rendement chaudière ECS
                    - sinon: 0
          unité: Nm3 gaz/an
        consommation combustible froid: &inst-consommation-combustible-froid
          formule: 0
          unité: Nm3 gaz/an
        consommation auxiliaire: &inst-consommation-auxiliaire
          somme:
            - (1 - ratios . conso auxiliaire chauffage) * besoins chauffage par appartement
            - variations:
                - si:
                    toutes ces conditions:
                      - type de production ECS = 'Avec équipement chauffage'
                      - Production eau chaude sanitaire
                  alors: (1 - ratios . conso auxiliaire ECS) * besoins eau chaude sanitaire par appartement
                - sinon: 0
          unité: kWh elec
        consommation combustible hors électricité:
          formule: consommation combustible chaleur
        consommation d'électricité lié au chauffage-refroidissement et à la production d'ECS: &inst-consommation-d-electricite-lie-au-chauffage-refroidissement-et-a-la-production-d-ecs
          variations:
            - si: besoin d'installation supplémentaire pour produire l'ECS
              alors: consommation auxiliaire + consommation d'électricité chauffe-eau électrique
            - sinon: consommation auxiliaire
          unité: kWh/an
        consommation Groupe Froid: calcul consommation Groupe Froid
    coûts:
      avec:
        Investissement équipement Total: &couts-investissement-equipement-total
          produit:
            - ratios . investissement équipement
            - ( 1 + ratios économiques . Investissement x Pose et mise en place de l'installation )
          unité: €TTC
        Investissement équipement par logement type tertiaire: &couts-investissement-equipement-par-logement-type-tertiaire-indiv
          valeur: Investissement équipement Total
          unité: €TTC
        Investissement ballon ECS à accumulation: &couts-investissement-ballon-ecs-a-accumulation
          variations:
            - si: installation . besoin d'installation supplémentaire pour produire l'ECS
              alors: Calcul Eco . Investissement ballon ECS à accumulation
            - sinon: 0
          unité: €TTC
        Investissement ballon ECS solaire panneau inclus: &couts-investissement-ballon-ecs-solaire-panneau-inclus
          applicable si:
            toutes ces conditions:
              - installation . besoin d'installation supplémentaire pour produire l'ECS
              - type de production ECS = "Solaire thermique"
          formule: Calcul Eco . Investissement ballon ECS panneau inclus
          unité: €TTC
        Total investissement avec ballon ECS à accumulation: &couts-total-investissement-avec-ballon-ecs-a-accumulation
          valeur: Investissement équipement par logement type tertiaire + Investissement ballon ECS à accumulation
          unité: €TTC
        Total investissement ballon ECS solaire panneaux: &couts-total-investissement-ballon-ecs-solaire-panneaux
          valeur: Investissement équipement par logement type tertiaire + Investissement ballon ECS solaire panneau inclus
          unité: €TTC

        Coût du combustible abonnement: &couts-cout-du-combustible-abonnement-indiv
          somme:
            - variations:
                - si:
                    toutes ces conditions:
                      - Inclure la climatisation
                      - type de production de froid = 'Réseau de froid'
                  alors: réseau de froid . coûts . Coût du combustible abonnement
                - sinon: 0
            - Calcul Eco . Coût d'achat du combustible . Gaz indiv x Part abonnement
          unité: €TTC/an
          note: 'Coût du combustible abonnement (P1 abo) €TTC/an'
        Coût du combustible consommation: &couts-cout-du-combustible-consommation
          produit:
            - Calcul Eco . Coût d'achat du combustible . Gaz indiv x Part consommation
            - installation . consommation combustible chaleur
            - 1 / ratios . conso combustible
          unité: €TTC/an
          note: 'Coût du combustible consommation (P1 conso) €TTC/an'
        Coût électricité auxiliaire: &couts-cout-electricite-auxiliaire
          produit:
            - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
            - installation . consommation auxiliaire
          unité: €TTC/an
          note: "Coût électricité auxiliaire (P1') €TTC/an"
        Coût combustible pour ballon ECS à accumulation: &couts-cout-combustible-pour-ballon-ecs-a-accumulation
          applicable si: installation . consommation d'électricité chauffe-eau électrique >= 0
          produit:
            - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
            - installation . consommation d'électricité chauffe-eau électrique
          unité: €TTC/an
          note: 'Coût combustible pour ballon ECS à accumulation (P1 ECS) €TTC/an'
        Coût combustible pour ballon ECS solaire: &couts-cout-combustible-pour-ballon-ecs-solaire
          applicable si: installation . appoint d'électricité chauffe-eau solaire >= 0
          produit:
            - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
            - installation . appoint d'électricité chauffe-eau solaire
          unité: €TTC/an
          note: 'Coût combustible pour ballon ECS solaire (P1 ECS)€TTC/an'
        Coût combustible froid: &couts-cout-combustible-froid
          variations:
            - si:
                toutes ces conditions:
                  - Inclure la climatisation
                  - type de production de froid = 'Réseau de froid'
              alors: réseau de froid . coûts . Coût combustible froid
            - sinon:
                produit:
                  - Calcul Eco . Coût d'achat du combustible . Electricité coll x Part consommation
                  - installation . consommation Groupe Froid
          unité: €TTC/an
    entretien:
      avec:
        petit entretien P2: &entretien-petit-entretien-p2-indiv
          produit:
            - ratios . petit entretien P2
            - (1 + Paramètres économiques . Petit entretien P2 . TVA )
          unité: €TTC/an
        gros entretien P3: &entretien-gros-entretien-p3-indiv
          produit:
            - ratios . gros entretien P3
            - (1 + Paramètres économiques . Gros entretien P3 . TVA )
          unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2
        gros entretien P3 par logement tertiaire: gros entretien P3
    aides:
      avec:
        Ma prime renov': &aides-ma-prime-renov
          applicable si:
            est défini: Ma prime renov'
          formule: Ma prime renov'
          unité: €
        Coup de pouce: &aides-coup-de-pouce
          applicable si:
            est défini: Coup de pouce
          formule: Coup de pouce
          unité: €
        CEE: &aides-cee
          formule: 0
          unité: €
        Total: &aides-total
          variations:
            - si: Paramètres économiques . Aides . Éligibilité x Prise en compte des aides
              alors: Ma prime renov' + Coup de pouce + CEE
            - sinon: 0
          unité: €
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement: &env-besoins-de-chauffage-et-ecs-si-meme-equipement
          formule: installation . consommation combustible chaleur / ratios . conso combustible * ratios environnementaux . Emission spé Gaz chaudière
          unité: kgCO2e
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique: &env-auxiliaires-et-combustible-electrique
          formule: installation . consommation auxiliaire * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
          unité: kgCO2e
        ECS solaire thermique:
          formule: installation . appoint d'électricité chauffe-eau solaire * ratios environnementaux . Emission moy Parc électrique francais moyenne ECS
        ECS avec ballon électrique:
          formule: installation . consommation d'électricité chauffe-eau électrique * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
        Scope 2: &env-scope-2
          somme:
            - auxiliaires et combustible électrique
            - ECS solaire thermique
            - ECS avec ballon électrique
        Scope 3: &env-scope-3-indiv
          formule: ratios . CO2 installation * installation . gamme de puissance existante / ratios . durée de vie
        Total: &env-total
          somme:
            - Scope 1
            - Scope 2
            - Scope 3
          unité: kgCO2e/an
    bilan:
      avec:
        P1abo: coûts . Coût du combustible abonnement
        P1conso: coûts . Coût du combustible consommation
        P1prime: coûts . Coût électricité auxiliaire + Calcul Bilan . Surcout Réseau de froid P1prime
        P1ECS: &bilan-p1ecs
          le maximum de:
            - coûts . Coût combustible pour ballon ECS à accumulation
            - coûts . Coût combustible pour ballon ECS solaire
        P1Consofroid: coûts . Coût combustible froid
        P2: entretien . petit entretien P2 par logement tertiaire + Calcul Bilan . Surcout Réseau de froid P2
        P3: entretien . gros entretien P3 par logement tertiaire + Calcul Bilan . Surcout Réseau de froid P3
        P4spec:
          formule: coûts . Investissement équipement par logement type tertiaire * amortissement . facteur GAZ IND COND

        P4ECS Ballon électrique:
          formule: coûts . Investissement ballon ECS à accumulation * amortissement . facteur CHAUF EAU ELEC

        P4ECS Solaire Thermique: &bilan-p4ecs-solaire-thermique
          variations:
            - si: type de production ECS = 'Solaire thermique'
              alors: coûts . Investissement ballon ECS solaire panneau inclus * amortissement . facteur CHAUF EAU SOLAIRE
            - sinon: 0

        P4: &bilan-p4
          somme:
            - P4spec
            - P4ECS Ballon électrique
            - P4ECS Solaire Thermique
            - Calcul Bilan . P4 groupe froid
            - Calcul Bilan . P4 Réseau de froid
        aides spécifiques:
          formule: aides . Total * amortissement . facteur GAZ IND COND

        aides: &bilan-aides
          somme:
            - aides spécifiques
            - Calcul Bilan . aides réseau de froid
        P4 moins aides: &bilan-p4-moins-aides
          le maximum de:
            - P4 - aides
            - 0
        total sans aides: &bilan-total-sans-aides
          somme:
            - P1abo
            - P1conso
            - P1prime
            - P1ECS
            - P1Consofroid
            - P2
            - P3
            - P4
        total avec aides: &bilan-total-avec-aides
          somme:
            - total sans aides
            - (- aides)
gaz indiv sans cond:
  description: Chaudière gaz individuelle sans condensation
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 53.6
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        conso auxiliaire ECS:
          valeur: 99.9%
          unité: '%'
        conso auxiliaire chauffage:
          valeur: 99.9%
          unité: '%'
        conso combustible:
          valeur: 0.0970
          unité: Nm3/kWh PCI
        durée de vie:
          valeur: 17
          unité: an
        gros entretien P3:
          par défaut: 70
          unité: €HT
        investissement équipement:
          produit:
            - variations:
                - si: gaz indiv sans cond . installation . gamme de puissance existante <= 12
                  alors: 2660
                - si: gaz indiv sans cond . installation . gamme de puissance existante <= 20
                  alors: 2810
                - si: gaz indiv sans cond . installation . gamme de puissance existante <= 25
                  alors: 2920
                - si: gaz indiv sans cond . installation . gamme de puissance existante <= 30
                  alors: 3220
                - sinon: 3620
            - 1 + ratios économiques . Investissement x TVA
          unité: €TTC
          note: 'Source: ELCIMAI 2024'
        petit entretien P2:
          par défaut: 143
          unité: €HT/an
        rendement chaudière:
          valeur: 75%
          unité: '%'
    installation:
      avec:
        production eau chaude sanitaire: Production eau chaude sanitaire
        puissance nécessaire équipement chauffage:
          formule: (Calcul . Chauffage Puissance chauffage appelée / ratios . rendement chaudière)
          unité: kW
        puissance nécessaire pour ECS avec équipement:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - type de production ECS = 'Avec équipement chauffage'
              alors: ratios . PUIS Coefficient de foisonnement ECS * (Calcul . ECS Puissance ECS appelée / ratios . rendement chaudière)
            - sinon: 0
          unité: kW
        puissance équipement: *inst-puissance-equipement
        gamme de puissance existante: *inst-gamme-de-puissance-existante
        besoin d'installation supplémentaire pour produire l'ECS: *inst-besoin-d-installation-supplementaire-pour-produire-l-ecs
        volume du ballon ECS: *inst-volume-du-ballon-ecs
        consommation d'électricité chauffe-eau électrique: *inst-consommation-d-electricite-chauffe-eau-electrique
        appoint d'électricité chauffe-eau solaire: *inst-appoint-d-electricite-chauffe-eau-solaire
        consommation combustible chaleur: &inst-consommation-combustible-chaleur
          produit:
            - ratios . conso combustible
            - somme:
                - besoins chauffage par appartement
                - variations:
                    - si: type de production ECS = 'Avec équipement chauffage'
                      alors: besoins eau chaude sanitaire par appartement
                    - sinon: 0
            - 1 / ratios . rendement chaudière
          unité: Nm3 gaz/an
        consommation combustible froid: *inst-consommation-combustible-froid
        consommation auxiliaire: *inst-consommation-auxiliaire
        consommation combustible hors électricité:
          formule: consommation combustible chaleur
        consommation d'électricité lié au chauffage-refroidissement et à la production d'ECS: *inst-consommation-d-electricite-lie-au-chauffage-refroidissement-et-a-la-production-d-ecs
        consommation Groupe Froid: calcul consommation Groupe Froid
    coûts:
      avec:
        Investissement équipement Total: *couts-investissement-equipement-total
        Investissement équipement par logement type tertiaire: *couts-investissement-equipement-par-logement-type-tertiaire-indiv
        Investissement ballon ECS à accumulation: *couts-investissement-ballon-ecs-a-accumulation
        Investissement ballon ECS solaire panneau inclus: *couts-investissement-ballon-ecs-solaire-panneau-inclus
        Total investissement avec ballon ECS à accumulation: *couts-total-investissement-avec-ballon-ecs-a-accumulation
        Total investissement ballon ECS solaire panneaux: *couts-total-investissement-ballon-ecs-solaire-panneaux

        Coût du combustible abonnement: *couts-cout-du-combustible-abonnement-indiv
        Coût du combustible consommation: *couts-cout-du-combustible-consommation
        Coût électricité auxiliaire: *couts-cout-electricite-auxiliaire
        Coût combustible pour ballon ECS à accumulation: *couts-cout-combustible-pour-ballon-ecs-a-accumulation
        Coût combustible pour ballon ECS solaire: *couts-cout-combustible-pour-ballon-ecs-solaire
        Coût combustible froid: *couts-cout-combustible-froid
    entretien:
      avec:
        petit entretien P2: *entretien-petit-entretien-p2-indiv
        gros entretien P3: *entretien-gros-entretien-p3-indiv
        petit entretien P2 par logement tertiaire: petit entretien P2
        gros entretien P3 par logement tertiaire: gros entretien P3
    aides:
      avec:
        Ma prime renov': *aides-ma-prime-renov
        Coup de pouce: *aides-coup-de-pouce
        CEE: *aides-cee
        Total: *aides-total
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement: *env-besoins-de-chauffage-et-ecs-si-meme-equipement
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique: *env-auxiliaires-et-combustible-electrique
        ECS solaire thermique:
          formule: installation . appoint d'électricité chauffe-eau solaire * ratios environnementaux . Emission moy Parc électrique francais moyenne ECS
        ECS avec ballon électrique:
          formule: installation . consommation d'électricité chauffe-eau électrique * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
        Scope 2: *env-scope-2
        Scope 3: *env-scope-3-indiv
        Total: *env-total
    bilan:
      avec:
        P1abo: coûts . Coût du combustible abonnement
        P1conso: coûts . Coût du combustible consommation
        P1prime: coûts . Coût électricité auxiliaire + Calcul Bilan . Surcout Réseau de froid P1prime
        P1ECS: *bilan-p1ecs
        P1Consofroid: coûts . Coût combustible froid
        P2: entretien . petit entretien P2 par logement tertiaire + Calcul Bilan . Surcout Réseau de froid P2
        P3: entretien . gros entretien P3 par logement tertiaire + Calcul Bilan . Surcout Réseau de froid P3
        P4spec:
          formule: coûts . Investissement équipement par logement type tertiaire * amortissement . facteur GAZ IND SCOND

        P4ECS Ballon électrique:
          formule: coûts . Investissement ballon ECS à accumulation * amortissement . facteur CHAUF EAU ELEC

        P4ECS Solaire Thermique: *bilan-p4ecs-solaire-thermique

        P4: *bilan-p4
        aides spécifiques:
          formule: aides . Total * amortissement . facteur GAZ IND SCOND

        aides: *bilan-aides
        P4 moins aides: *bilan-p4-moins-aides
        total sans aides: *bilan-total-sans-aides
        total avec aides: *bilan-total-avec-aides
gaz coll avec cond:
  description: Chaudière gaz collective à condensation
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 25
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        conso auxiliaire ECS:
          valeur: 99%
          unité: '%'
        conso auxiliaire chauffage:
          valeur: 99.8%
          unité: '%'
        conso combustible:
          valeur: 0.0970
          unité: Nm3/kWh PCI
        durée de vie:
          valeur: 22
          unité: an
        gros entretien P3:
          par défaut: 1.72 / 100
          unité: €HT/€d'investissment # %
        investissement équipement:
          produit:
            - variations:
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 35
                  alors: 4800
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 120
                  alors: 15000
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 200
                  alors: 25000
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 300
                  alors: 37500
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 400
                  alors: 40000
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 500
                  alors: 45000
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 600
                  alors: 52335
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 700
                  alors: 61058
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 800
                  alors: 69780
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 900
                  alors: 78503
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 1000
                  alors: 87225
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 1250
                  alors: 109031
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 1500
                  alors: 130838
                - si: gaz coll avec cond . installation . gamme de puissance existante <= 1750
                  alors: 152644
                - sinon: 174450
            - 1 + ratios économiques . Investissement x TVA
          unité: €TTC
          note: 'Source: ELCIMAI 2024 et Atlantic 2024'
        petit entretien P2:
          par défaut: 7.00 * (1 + Paramètres économiques . Petit entretien P2 . TVA)
          unité: €TTC/MWh
        rendement chaudière ECS:
          valeur: 86%
          unité: '%'
        rendement chaudière chauffage:
          valeur: 80%
          unité: '%'
    installation:
      avec:
        production eau chaude sanitaire: Production eau chaude sanitaire
        puissance nécessaire équipement chauffage:
          formule: (Calcul . Chauffage Puissance chauffage appelée / ratios . rendement chaudière chauffage) * nombre de logements dans l'immeuble concerné * ratios . PUIS Coefficient de foisonnement chauffage collectif
          unité: kW
        puissance nécessaire pour ECS avec équipement:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - type de production ECS = 'Avec équipement chauffage'
              alors: ratios . PUIS Coefficient de foisonnement ECS * (Calcul . ECS Puissance ECS appelée / ratios . rendement chaudière ECS) * nombre de logements dans l'immeuble concerné
            - sinon: 0
          unité: kW
        puissance équipement: *inst-puissance-equipement
        gamme de puissance existante:
          variations:
            - si: puissance équipement <= 35
              alors: 35
            - si: puissance équipement < 120
              alors: 120
            - si: puissance équipement < 200
              alors: 200
            - si: puissance équipement < 300
              alors: 300
            - si: puissance équipement < 400
              alors: 400
            - si: puissance équipement < 500
              alors: 500
            - si: puissance équipement < 600
              alors: 600
            - si: puissance équipement < 700
              alors: 700
            - si: puissance équipement < 800
              alors: 800
            - si: puissance équipement < 900
              alors: 900
            - si: puissance équipement < 1000
              alors: 1000
            - si: puissance équipement < 1250
              alors: 1250
            - si: puissance équipement < 1500
              alors: 1500
            - si: puissance équipement < 1750
              alors: 1750
            - sinon: 2000
          unité: kW
          note: La puissance habituelle pour ce genre d'équipement va jusqu'à 2000 kW.
        besoin d'installation supplémentaire pour produire l'ECS: *inst-besoin-d-installation-supplementaire-pour-produire-l-ecs
        volume du ballon ECS: *inst-volume-du-ballon-ecs
        consommation d'électricité chauffe-eau électrique: *inst-consommation-d-electricite-chauffe-eau-electrique
        appoint d'électricité chauffe-eau solaire: *inst-appoint-d-electricite-chauffe-eau-solaire
        consommation combustible chaleur:
          produit:
            - ratios . conso combustible
            - somme:
                - besoins chauffage par appartement / ratios . rendement chaudière chauffage
                - variations:
                    - si: type de production ECS = 'Avec équipement chauffage'
                      alors: besoins eau chaude sanitaire par appartement / ratios . rendement chaudière ECS
                    - sinon: 0
          unité: Nm3 gaz/an
        consommation combustible froid: *inst-consommation-combustible-froid
        consommation auxiliaire: *inst-consommation-auxiliaire
        consommation combustible hors électricité:
          formule: consommation combustible chaleur
        consommation d'électricité lié au chauffage-refroidissement et à la production d'ECS: *inst-consommation-d-electricite-lie-au-chauffage-refroidissement-et-a-la-production-d-ecs
        consommation Groupe Froid: calcul consommation Groupe Froid
    coûts:
      avec:
        Investissement équipement Total: *couts-investissement-equipement-total
        Investissement équipement par logement type tertiaire: &couts-investissement-equipement-par-logement-type-tertiaire-coll
          valeur: Investissement équipement Total / nombre de logements dans l'immeuble concerné
          unité: €TTC
        Investissement ballon ECS à accumulation: *couts-investissement-ballon-ecs-a-accumulation
        Investissement ballon ECS solaire panneau inclus: *couts-investissement-ballon-ecs-solaire-panneau-inclus
        Total investissement avec ballon ECS à accumulation: *couts-total-investissement-avec-ballon-ecs-a-accumulation
        Total investissement ballon ECS solaire panneaux: *couts-total-investissement-ballon-ecs-solaire-panneaux

        Coût du combustible abonnement: &couts-cout-du-combustible-abonnement-coll
          somme:
            - variations:
                - si:
                    toutes ces conditions:
                      - Inclure la climatisation
                      - type de production de froid = 'Réseau de froid'
                  alors: réseau de froid . coûts . Coût du combustible abonnement
                - sinon: 0
            - Calcul Eco . Coût d'achat du combustible . Gaz coll x Part abonnement / nombre de logements dans l'immeuble concerné
          unité: €TTC/an
          note: 'Coût du combustible abonnement (P1 abo) €TTC/an'
        Coût du combustible consommation:
          produit:
            - Calcul Eco . Coût d'achat du combustible . Gaz coll x Part consommation
            - installation . consommation combustible chaleur
            - 1 / ratios . conso combustible
          unité: €TTC/an
          note: 'Coût du combustible consommation (P1 conso) €TTC/an'
        Coût électricité auxiliaire: *couts-cout-electricite-auxiliaire
        Coût combustible pour ballon ECS à accumulation: *couts-cout-combustible-pour-ballon-ecs-a-accumulation
        Coût combustible pour ballon ECS solaire: *couts-cout-combustible-pour-ballon-ecs-solaire
        Coût combustible froid: *couts-cout-combustible-froid
    entretien:
      avec:
        petit entretien P2: &entretien-petit-entretien-p2-coll
          produit:
            - ratios . petit entretien P2
            - (besoins chauffage par appartement + besoins eau chaude sanitaire par appartement)
            - nombre de logements dans l'immeuble concerné / 1000
          unité: €TTC/an
        gros entretien P3: &entretien-gros-entretien-p3-coll
          produit:
            - ratios . gros entretien P3
            - coûts . Investissement équipement Total
          unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2 / nombre de logements dans l'immeuble concerné
        gros entretien P3 par logement tertiaire: gros entretien P3 / nombre de logements dans l'immeuble concerné
    aides:
      avec:
        Ma prime renov': *aides-ma-prime-renov
        Coup de pouce: *aides-coup-de-pouce
        CEE: *aides-cee
        Total: *aides-total
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement: *env-besoins-de-chauffage-et-ecs-si-meme-equipement
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique: *env-auxiliaires-et-combustible-electrique
        ECS solaire thermique:
          formule: installation . appoint d'électricité chauffe-eau solaire * ratios environnementaux . Emission moy Parc électrique francais moyenne ECS
        ECS avec ballon électrique:
          formule: installation . consommation d'électricité chauffe-eau électrique * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
        Scope 2: *env-scope-2
        Scope 3: &env-scope-3-coll
          formule: ratios . CO2 installation * installation . gamme de puissance existante / ratios . durée de vie / nombre de logements dans l'immeuble concerné
        Total: *env-total
    bilan:
      avec:
        P1abo: coûts . Coût du combustible abonnement
        P1conso: coûts . Coût du combustible consommation
        P1prime: coûts . Coût électricité auxiliaire + Calcul Bilan . Surcout Réseau de froid P1prime
        P1ECS: *bilan-p1ecs
        P1Consofroid: coûts . Coût combustible froid
        P2: entretien . petit entretien P2 par logement tertiaire + Calcul Bilan . Surcout Réseau de froid P2
        P3: entretien . gros entretien P3 par logement tertiaire + Calcul Bilan . Surcout Réseau de froid P3
        P4spec:
          formule: coûts . Investissement équipement par logement type tertiaire * amortissement . facteur GAZ COLL COND

        P4ECS Ballon électrique:
          formule: coûts . Investissement ballon ECS à accumulation * amortissement . facteur CHAUF EAU ELEC

        P4ECS Solaire Thermique: *bilan-p4ecs-solaire-thermique

        P4: *bilan-p4
        aides spécifiques:
          formule: aides . Total * amortissement . facteur GAZ COLL COND

        aides: *bilan-aides
        P4 moins aides: *bilan-p4-moins-aides
        total sans aides: *bilan-total-sans-aides
        total avec aides: *bilan-total-avec-aides
gaz coll sans cond:
  description: Chaudière gaz collective sans condensation
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 25
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        conso auxiliaire ECS:
          valeur: 99%
          unité: '%'
        conso auxiliaire chauffage:
          valeur: 99.8%
          unité: '%'
        conso combustible:
          valeur: 0.0970
          unité: Nm3/kWh PCI
        durée de vie:
