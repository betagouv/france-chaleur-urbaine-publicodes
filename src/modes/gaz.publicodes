###### Ratios économiques (investissement)

ratios économiques . Gaz x indiv avec cond:
  # B59 =XLOOKUP($D$27,'Ratios économiques - Coûts'!$B$81:$B$85,'Ratios économiques - Coûts'!$C$81:$C$85,,1)*(1+$D$50)
  produit:
    - variations:
        - si: gaz indiv avec cond . installation . gamme de puissance existante <= 12
          alors: 2660
        - si: gaz indiv avec cond . installation . gamme de puissance existante <= 20
          alors: 2810
        - si: gaz indiv avec cond . installation . gamme de puissance existante <= 25
          alors: 2920
        - si: gaz indiv avec cond . installation . gamme de puissance existante <= 30
          alors: 3220
        - sinon: 3620
    - 1 + ratios économiques . Investissement x TVA
  unité: €TTC
  note: 'Source: Atlantic 2023'

ratios économiques . Gaz x indiv sans cond:
  produit:
    - variations:
        - si: gaz indiv sans cond . installation . gamme de puissance existante <= 12
          alors: 2660
        - si: gaz indiv sans cond . installation . gamme de puissance existante <= 20
          alors: 2810
        - si: gaz indiv sans cond . installation . gamme de puissance existante <= 25
          alors: 2920
        - si: gaz indiv sans cond . installation . gamme de puissance existante <= 30
          alors: 3220
        - sinon: 3620
    - 1 + ratios économiques . Investissement x TVA
  unité: €TTC
  note: 'Source: ELCIMAI 2024'

ratios économiques . Gaz x coll avec cond:
  produit:
    - variations:
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 35
          alors: 4800
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 120
          alors: 15000
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 200
          alors: 25000
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 300
          alors: 37500
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 400
          alors: 40000
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 500
          alors: 45000
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 600
          alors: 52335
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 700
          alors: 61058
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 800
          alors: 69780
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 900
          alors: 78503
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 1000
          alors: 87225
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 1250
          alors: 109031
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 1500
          alors: 130838
        - si: gaz coll avec cond . installation . gamme de puissance existante <= 1750
          alors: 152644
        - sinon: 174450
    - 1 + ratios économiques . Investissement x TVA
  unité: €TTC
  note: 'Source: ELCIMAI 2024 et Atlantic 2024'

ratios économiques . Gaz x coll sans cond:
  produit:
    - variations:
        - si: gaz coll sans cond . installation . gamme de puissance existante <= 35
          alors: 4800
        - si: gaz coll sans cond . installation . gamme de puissance existante <= 120
          alors: 15000
