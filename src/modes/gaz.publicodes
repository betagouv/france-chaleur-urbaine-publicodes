# Chaudières gaz (indiv/coll, avec/sans condensation)
# Regroupe ratios, dimensionnement, calculs économiques,
# aides, émissions et bilan pour ce mode de chauffage.

###### Ratios techniques

gaz indiv avec cond:
  description: Chaudière gaz individuelle à condensation
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 33
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        conso auxiliaire ECS:
          valeur: 99.9%
          unité: '%'
        conso auxiliaire chauffage:
          valeur: 99.9%
          unité: '%'
        conso combustible:
          valeur: 0.0970
          unité: Nm3/kWh PCI
        durée de vie:
          valeur: 17
          unité: an
        gros entretien P3:
          par défaut: 70
          unité: €HT
        investissement équipement:
          produit:
            - variations:
                - si: gaz indiv avec cond . installation . puissance retenue <= 12
                  alors: 2660
                - si: gaz indiv avec cond . installation . puissance retenue <= 20
                  alors: 2810
                - si: gaz indiv avec cond . installation . puissance retenue <= 25
                  alors: 2920
                - si: gaz indiv avec cond . installation . puissance retenue <= 30
                  alors: 3220
                - sinon: 3620
            - 1 + investissement . TVA
          unité: €TTC
          note: 'Source: Atlantic 2023'
        petit entretien P2:
          par défaut: 143
          unité: €HT/an
        rendement chaudière ECS:
          valeur: 85%
          unité: '%'
        rendement chaudière chauffage:
          valeur: 85%
          unité: '%'
    facteur d'annuité: &facteur-annuite-gaz
      description: Annuité pour 1 € investi sur la durée de vie de l'équipement (fonction Excel PMT)
      variations:
        - si: amortissement . taux d'actualisation != 0
          alors: amortissement . taux d'actualisation * ((1 + amortissement . taux d'actualisation) ** ratios . durée de vie) / ((1 + amortissement . taux d'actualisation) ** ratios . durée de vie - 1)
        - sinon: 1 / ratios . durée de vie
    installation:
      avec:
        production eau chaude sanitaire: Production eau chaude sanitaire
        puissance chauffage:
          formule: (dimensionnement . puissance chauffage appelée / ratios . rendement chaudière chauffage)
          unité: kW
        puissance ECS:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - type de production ECS = 'Avec équipement chauffage'
              alors: ratios . PUIS Coefficient de foisonnement ECS * (dimensionnement . puissance ECS appelée / ratios . rendement chaudière ECS)
            - sinon: 0
          unité: kW
        puissance équipement: &inst-puissance-equipement
          somme:
            - puissance chauffage
            - puissance ECS
          unité: kW
        puissance retenue: &inst-gamme-de-puissance-existante
          variations:
            - si: puissance équipement <= 12
              alors: 12
            - si: puissance équipement <= 20
              alors: 20
            - si: puissance équipement <= 25
              alors: 25
            - si: puissance équipement <= 30
              alors: 30
            - sinon: 35
          unité: kW
        ECS additionnelle nécessaire: &inst-besoin-d-installation-supplementaire-pour-produire-l-ecs
          toutes ces conditions:
            - Production eau chaude sanitaire
            - puissance ECS <= 0
        volume du ballon ECS: &inst-volume-du-ballon-ecs
          variations:
            - si:
                toutes ces conditions:
                  - ECS additionnelle nécessaire
                  - type de production ECS != "Solaire thermique"
              alors: volume du ballon ECS
            - sinon: 50
          unité: L
        consommation chauffe-eau électrique: &inst-consommation-d-electricite-chauffe-eau-electrique
          variations:
            - si:
                toutes ces conditions:
                  - ECS additionnelle nécessaire
                  - type de production ECS != 'Solaire thermique'
              alors: ecs additionnelle . consommation chauffe-eau électrique
            - sinon: 0
          unité: kWh/an
        appoint chauffe-eau solaire: &inst-appoint-d-electricite-chauffe-eau-solaire
          variations:
            - si:
                toutes ces conditions:
                  - ECS additionnelle nécessaire
                  - type de production ECS = 'Solaire thermique'
              alors: ecs additionnelle . appoint chauffe-eau solaire
            - sinon: 0
          unité: kWh/an
        consommation combustible chaleur:
          produit:
            - ratios . conso combustible
            - somme:
                - besoins chauffage par appartement /  ratios . rendement chaudière chauffage
                - variations:
                    - si: type de production ECS = 'Avec équipement chauffage'
                      alors: besoins eau chaude sanitaire par appartement / ratios . rendement chaudière ECS
                    - sinon: 0
          unité: Nm3 gaz/an
        consommation combustible froid: &inst-consommation-combustible-froid
          formule: 0
          unité: Nm3 gaz/an
        consommation auxiliaire: &inst-consommation-auxiliaire
          somme:
            - (1 - ratios . conso auxiliaire chauffage) * besoins chauffage par appartement
            - variations:
                - si:
                    toutes ces conditions:
                      - type de production ECS = 'Avec équipement chauffage'
                      - Production eau chaude sanitaire
                  alors: (1 - ratios . conso auxiliaire ECS) * besoins eau chaude sanitaire par appartement
                - sinon: 0
          unité: kWh elec
        consommation hors électricité:
          formule: consommation combustible chaleur
        consommation électricité: &inst-consommation-d-electricite-lie-au-chauffage-refroidissement-et-a-la-production-d-ecs
          variations:
            - si: ECS additionnelle nécessaire
              alors: consommation auxiliaire + consommation chauffe-eau électrique
            - sinon: consommation auxiliaire
          unité: kWh/an
        consommation Groupe Froid: froid . consommation groupe froid
    coûts:
      avec:
        investissement équipement: &couts-investissement-equipement-total
          produit:
            - ratios . investissement équipement
            - ( 1 + investissement . pose et mise en place )
          unité: €TTC
        investissement par logement: &couts-investissement-equipement-par-logement-type-tertiaire-indiv
          valeur: investissement équipement
          unité: €TTC
        investissement ballon ECS: &couts-investissement-ballon-ecs-a-accumulation
          variations:
            - si: installation . ECS additionnelle nécessaire
              alors: ecs additionnelle . investissement ballon ECS
            - sinon: 0
          unité: €TTC
        investissement chauffe-eau solaire: &couts-investissement-ballon-ecs-solaire-panneau-inclus
          applicable si:
            toutes ces conditions:
              - installation . ECS additionnelle nécessaire
              - type de production ECS = "Solaire thermique"
          formule: ecs additionnelle . investissement chauffe-eau solaire
          unité: €TTC
        investissement total avec ballon ECS: &couts-total-investissement-avec-ballon-ecs-a-accumulation
          valeur: investissement par logement + investissement ballon ECS
          unité: €TTC
        investissement total avec chauffe-eau solaire: &couts-total-investissement-ballon-ecs-solaire-panneaux
          valeur: investissement par logement + investissement chauffe-eau solaire
          unité: €TTC

        P1 abonnement: &couts-cout-du-combustible-abonnement-indiv
          somme:
            - variations:
                - si:
                    toutes ces conditions:
                      - Inclure la climatisation
                      - type de production de froid = 'Réseau de froid'
                  alors: réseau de froid . coûts . P1 abonnement
                - sinon: 0
            - combustibles . gaz . abonnement individuel
          unité: €TTC/an
        P1 consommation: &couts-cout-du-combustible-consommation
          produit:
            - combustibles . gaz . consommation individuel
            - installation . consommation combustible chaleur
            - 1 / ratios . conso combustible
          unité: €TTC/an
        P1 auxiliaires: &couts-cout-electricite-auxiliaire
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation auxiliaire
          unité: €TTC/an) €TTC/an"
        P1 ballon ECS: &couts-cout-combustible-pour-ballon-ecs-a-accumulation
          applicable si: installation . consommation chauffe-eau électrique >= 0
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation chauffe-eau électrique
          unité: €TTC/an
        P1 chauffe-eau solaire: &couts-cout-combustible-pour-ballon-ecs-solaire
          applicable si: installation . appoint chauffe-eau solaire >= 0
          produit:
            - combustibles . électricité . consommation individuel
            - installation . appoint chauffe-eau solaire
          unité: €TTC/an
        P1 froid: &couts-cout-combustible-froid
          variations:
            - si:
                toutes ces conditions:
                  - Inclure la climatisation
                  - type de production de froid = 'Réseau de froid'
              alors: réseau de froid . coûts . P1 froid
            - sinon:
                produit:
                  - combustibles . électricité . consommation collectif
                  - installation . consommation Groupe Froid
          unité: €TTC/an
        petit entretien P2: &entretien-petit-entretien-p2-indiv
          produit:
            - ratios . petit entretien P2
            - (1 + Paramètres économiques . Petit entretien P2 . TVA )
          unité: €TTC/an
        gros entretien P3: &entretien-gros-entretien-p3-indiv
          produit:
            - ratios . gros entretien P3
            - (1 + Paramètres économiques . Gros entretien P3 . TVA )
          unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2
        gros entretien P3 par logement tertiaire: gros entretien P3
    aides:
      avec:
        Ma prime renov': &aides-ma-prime-renov
          applicable si:
            est défini: Ma prime renov'
          formule: Ma prime renov'
          unité: €
        Coup de pouce: &aides-coup-de-pouce
          applicable si:
            est défini: Coup de pouce
          formule: Coup de pouce
          unité: €
        CEE: &aides-cee
          formule: 0
          unité: €
        Total: &aides-total
          variations:
            - si: aides . éligibilité . prise en compte des aides
              alors: Ma prime renov' + Coup de pouce + CEE
            - sinon: 0
          unité: €
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement: &env-besoins-de-chauffage-et-ecs-si-meme-equipement
          formule: installation . consommation combustible chaleur / ratios . conso combustible * facteurs d'émission . gaz chaudière
          unité: kgCO2e
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique: &env-auxiliaires-et-combustible-electrique
          formule: installation . consommation auxiliaire * facteurs d'émission . électricité chauffage
          unité: kgCO2e
        ECS solaire thermique:
          formule: installation . appoint chauffe-eau solaire * facteurs d'émission . électricité ECS
        ECS avec ballon électrique:
          formule: installation . consommation chauffe-eau électrique * facteurs d'émission . électricité chauffage
        Scope 2: &env-scope-2
          somme:
            - auxiliaires et combustible électrique
            - ECS solaire thermique
            - ECS avec ballon électrique
        Scope 3: &env-scope-3-indiv
          formule: ratios . CO2 installation * installation . puissance retenue / ratios . durée de vie
        Total: &env-total
          somme:
            - Scope 1
            - Scope 2
            - Scope 3
          unité: kgCO2e/an
    bilan:
      avec:
        P1abo: coûts . P1 abonnement
        P1conso: coûts . P1 consommation
        P1prime: coûts . P1 auxiliaires + froid . surcoût P1 auxiliaires
        P1ECS: &bilan-p1ecs
          le maximum de:
            - coûts . P1 ballon ECS
            - coûts . P1 chauffe-eau solaire
        P1Consofroid: coûts . P1 froid
        P2: coûts . petit entretien P2 par logement tertiaire + froid . surcoût P2
        P3: coûts . gros entretien P3 par logement tertiaire + froid . surcoût P3
        P4 équipement:
          formule: coûts . investissement par logement * facteur d'annuité

        P4 ballon ECS:
          formule: coûts . investissement ballon ECS * ecs additionnelle . facteur d'annuité chauffe-eau électrique

        P4 chauffe-eau solaire: &bilan-p4ecs-solaire-thermique
          variations:
            - si: type de production ECS = 'Solaire thermique'
              alors: coûts . investissement chauffe-eau solaire * ecs additionnelle . facteur d'annuité chauffe-eau solaire
            - sinon: 0

        P4: &bilan-p4
          somme:
            - P4 équipement
            - P4 ballon ECS
            - P4 chauffe-eau solaire
            - froid . P4 groupe froid
            - froid . P4 réseau de froid
        aides spécifiques:
          formule: aides . Total * facteur d'annuité

        aides: &bilan-aides
          somme:
            - aides spécifiques
            - froid . aides réseau de froid
        P4 moins aides: &bilan-p4-moins-aides
          le maximum de:
            - P4 - aides
            - 0
        total sans aides: &bilan-total-sans-aides
          somme:
            - P1abo
            - P1conso
            - P1prime
            - P1ECS
            - P1Consofroid
            - P2
            - P3
            - P4
        total avec aides: &bilan-total-avec-aides
          somme:
            - total sans aides
            - (- aides)
gaz indiv sans cond:
  description: Chaudière gaz individuelle sans condensation
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 53.6
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        conso auxiliaire ECS:
          valeur: 99.9%
          unité: '%'
        conso auxiliaire chauffage:
          valeur: 99.9%
          unité: '%'
        conso combustible:
          valeur: 0.0970
          unité: Nm3/kWh PCI
        durée de vie:
          valeur: 17
          unité: an
        gros entretien P3:
          par défaut: 70
          unité: €HT
        investissement équipement:
          produit:
            - variations:
                - si: gaz indiv sans cond . installation . puissance retenue <= 12
                  alors: 2660
                - si: gaz indiv sans cond . installation . puissance retenue <= 20
                  alors: 2810
                - si: gaz indiv sans cond . installation . puissance retenue <= 25
                  alors: 2920
                - si: gaz indiv sans cond . installation . puissance retenue <= 30
                  alors: 3220
                - sinon: 3620
            - 1 + investissement . TVA
          unité: €TTC
          note: 'Source: ELCIMAI 2024'
        petit entretien P2:
          par défaut: 143
          unité: €HT/an
        rendement chaudière:
          valeur: 75%
          unité: '%'
    facteur d'annuité: *facteur-annuite-gaz
    installation:
      avec:
        production eau chaude sanitaire: Production eau chaude sanitaire
        puissance chauffage:
          formule: (dimensionnement . puissance chauffage appelée / ratios . rendement chaudière)
          unité: kW
        puissance ECS:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - type de production ECS = 'Avec équipement chauffage'
              alors: ratios . PUIS Coefficient de foisonnement ECS * (dimensionnement . puissance ECS appelée / ratios . rendement chaudière)
            - sinon: 0
          unité: kW
        puissance équipement: *inst-puissance-equipement
        puissance retenue: *inst-gamme-de-puissance-existante
        ECS additionnelle nécessaire: *inst-besoin-d-installation-supplementaire-pour-produire-l-ecs
        volume du ballon ECS: *inst-volume-du-ballon-ecs
        consommation chauffe-eau électrique: *inst-consommation-d-electricite-chauffe-eau-electrique
        appoint chauffe-eau solaire: *inst-appoint-d-electricite-chauffe-eau-solaire
        consommation combustible chaleur: &inst-consommation-combustible-chaleur
          produit:
            - ratios . conso combustible
            - somme:
                - besoins chauffage par appartement
                - variations:
                    - si: type de production ECS = 'Avec équipement chauffage'
                      alors: besoins eau chaude sanitaire par appartement
                    - sinon: 0
            - 1 / ratios . rendement chaudière
          unité: Nm3 gaz/an
        consommation combustible froid: *inst-consommation-combustible-froid
        consommation auxiliaire: *inst-consommation-auxiliaire
        consommation hors électricité:
          formule: consommation combustible chaleur
        consommation électricité: *inst-consommation-d-electricite-lie-au-chauffage-refroidissement-et-a-la-production-d-ecs
        consommation Groupe Froid: froid . consommation groupe froid
    coûts:
      avec:
        investissement équipement: *couts-investissement-equipement-total
        investissement par logement: *couts-investissement-equipement-par-logement-type-tertiaire-indiv
        investissement ballon ECS: *couts-investissement-ballon-ecs-a-accumulation
        investissement chauffe-eau solaire: *couts-investissement-ballon-ecs-solaire-panneau-inclus
        investissement total avec ballon ECS: *couts-total-investissement-avec-ballon-ecs-a-accumulation
        investissement total avec chauffe-eau solaire: *couts-total-investissement-ballon-ecs-solaire-panneaux

        P1 abonnement: *couts-cout-du-combustible-abonnement-indiv
        P1 consommation: *couts-cout-du-combustible-consommation
        P1 auxiliaires: *couts-cout-electricite-auxiliaire
        P1 ballon ECS: *couts-cout-combustible-pour-ballon-ecs-a-accumulation
        P1 chauffe-eau solaire: *couts-cout-combustible-pour-ballon-ecs-solaire
        P1 froid: *couts-cout-combustible-froid
        petit entretien P2: *entretien-petit-entretien-p2-indiv
        gros entretien P3: *entretien-gros-entretien-p3-indiv
        petit entretien P2 par logement tertiaire: petit entretien P2
        gros entretien P3 par logement tertiaire: gros entretien P3
    aides:
      avec:
        Ma prime renov': *aides-ma-prime-renov
        Coup de pouce: *aides-coup-de-pouce
        CEE: *aides-cee
        Total: *aides-total
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement: *env-besoins-de-chauffage-et-ecs-si-meme-equipement
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique: *env-auxiliaires-et-combustible-electrique
        ECS solaire thermique:
          formule: installation . appoint chauffe-eau solaire * facteurs d'émission . électricité ECS
        ECS avec ballon électrique:
          formule: installation . consommation chauffe-eau électrique * facteurs d'émission . électricité chauffage
        Scope 2: *env-scope-2
        Scope 3: *env-scope-3-indiv
        Total: *env-total
    bilan:
      avec:
        P1abo: coûts . P1 abonnement
        P1conso: coûts . P1 consommation
        P1prime: coûts . P1 auxiliaires + froid . surcoût P1 auxiliaires
        P1ECS: *bilan-p1ecs
        P1Consofroid: coûts . P1 froid
        P2: coûts . petit entretien P2 par logement tertiaire + froid . surcoût P2
        P3: coûts . gros entretien P3 par logement tertiaire + froid . surcoût P3
        P4 équipement:
          formule: coûts . investissement par logement * facteur d'annuité

        P4 ballon ECS:
          formule: coûts . investissement ballon ECS * ecs additionnelle . facteur d'annuité chauffe-eau électrique

        P4 chauffe-eau solaire: *bilan-p4ecs-solaire-thermique

        P4: *bilan-p4
        aides spécifiques:
          formule: aides . Total * facteur d'annuité

        aides: *bilan-aides
        P4 moins aides: *bilan-p4-moins-aides
        total sans aides: *bilan-total-sans-aides
        total avec aides: *bilan-total-avec-aides
gaz coll avec cond:
  description: Chaudière gaz collective à condensation
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 25
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        conso auxiliaire ECS:
          valeur: 99%
          unité: '%'
        conso auxiliaire chauffage:
          valeur: 99.8%
          unité: '%'
        conso combustible:
          valeur: 0.0970
          unité: Nm3/kWh PCI
        durée de vie:
          valeur: 22
          unité: an
        gros entretien P3:
          par défaut: 1.72 / 100
          unité: €HT/€d'investissment # %
        investissement équipement:
          produit:
            - variations:
                - si: gaz coll avec cond . installation . puissance retenue <= 35
                  alors: 4800
                - si: gaz coll avec cond . installation . puissance retenue <= 120
                  alors: 15000
                - si: gaz coll avec cond . installation . puissance retenue <= 200
                  alors: 25000
                - si: gaz coll avec cond . installation . puissance retenue <= 300
                  alors: 37500
                - si: gaz coll avec cond . installation . puissance retenue <= 400
                  alors: 40000
                - si: gaz coll avec cond . installation . puissance retenue <= 500
                  alors: 45000
                - si: gaz coll avec cond . installation . puissance retenue <= 600
                  alors: 52335
                - si: gaz coll avec cond . installation . puissance retenue <= 700
                  alors: 61058
                - si: gaz coll avec cond . installation . puissance retenue <= 800
                  alors: 69780
                - si: gaz coll avec cond . installation . puissance retenue <= 900
                  alors: 78503
                - si: gaz coll avec cond . installation . puissance retenue <= 1000
                  alors: 87225
                - si: gaz coll avec cond . installation . puissance retenue <= 1250
                  alors: 109031
                - si: gaz coll avec cond . installation . puissance retenue <= 1500
                  alors: 130838
                - si: gaz coll avec cond . installation . puissance retenue <= 1750
                  alors: 152644
                - sinon: 174450
            - 1 + investissement . TVA
          unité: €TTC
          note: 'Source: ELCIMAI 2024 et Atlantic 2024'
        petit entretien P2:
          par défaut: 7.00 * (1 + Paramètres économiques . Petit entretien P2 . TVA)
          unité: €TTC/MWh
        rendement chaudière ECS:
          valeur: 86%
          unité: '%'
        rendement chaudière chauffage:
          valeur: 80%
          unité: '%'
    facteur d'annuité: *facteur-annuite-gaz
    installation:
      avec:
        production eau chaude sanitaire: Production eau chaude sanitaire
        puissance chauffage:
          formule: (dimensionnement . puissance chauffage appelée / ratios . rendement chaudière chauffage) * nombre de logements dans l'immeuble concerné * ratios . PUIS Coefficient de foisonnement chauffage collectif
          unité: kW
        puissance ECS:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - type de production ECS = 'Avec équipement chauffage'
              alors: ratios . PUIS Coefficient de foisonnement ECS * (dimensionnement . puissance ECS appelée / ratios . rendement chaudière ECS) * nombre de logements dans l'immeuble concerné
            - sinon: 0
          unité: kW
        puissance équipement: *inst-puissance-equipement
        puissance retenue:
          variations:
            - si: puissance équipement <= 35
              alors: 35
            - si: puissance équipement < 120
              alors: 120
            - si: puissance équipement < 200
              alors: 200
            - si: puissance équipement < 300
              alors: 300
            - si: puissance équipement < 400
              alors: 400
            - si: puissance équipement < 500
              alors: 500
            - si: puissance équipement < 600
              alors: 600
            - si: puissance équipement < 700
              alors: 700
            - si: puissance équipement < 800
              alors: 800
            - si: puissance équipement < 900
              alors: 900
            - si: puissance équipement < 1000
              alors: 1000
            - si: puissance équipement < 1250
              alors: 1250
            - si: puissance équipement < 1500
              alors: 1500
            - si: puissance équipement < 1750
              alors: 1750
            - sinon: 2000
          unité: kW
          note: La puissance habituelle pour ce genre d'équipement va jusqu'à 2000 kW.
        ECS additionnelle nécessaire: *inst-besoin-d-installation-supplementaire-pour-produire-l-ecs
        volume du ballon ECS: *inst-volume-du-ballon-ecs
        consommation chauffe-eau électrique: *inst-consommation-d-electricite-chauffe-eau-electrique
        appoint chauffe-eau solaire: *inst-appoint-d-electricite-chauffe-eau-solaire
        consommation combustible chaleur:
          produit:
            - ratios . conso combustible
            - somme:
                - besoins chauffage par appartement / ratios . rendement chaudière chauffage
                - variations:
                    - si: type de production ECS = 'Avec équipement chauffage'
                      alors: besoins eau chaude sanitaire par appartement / ratios . rendement chaudière ECS
                    - sinon: 0
          unité: Nm3 gaz/an
        consommation combustible froid: *inst-consommation-combustible-froid
        consommation auxiliaire: *inst-consommation-auxiliaire
        consommation hors électricité:
          formule: consommation combustible chaleur
        consommation électricité: *inst-consommation-d-electricite-lie-au-chauffage-refroidissement-et-a-la-production-d-ecs
        consommation Groupe Froid: froid . consommation groupe froid
    coûts:
      avec:
        investissement équipement: *couts-investissement-equipement-total
        investissement par logement: &couts-investissement-equipement-par-logement-type-tertiaire-coll
          valeur: investissement équipement / nombre de logements dans l'immeuble concerné
          unité: €TTC
        investissement ballon ECS: *couts-investissement-ballon-ecs-a-accumulation
        investissement chauffe-eau solaire: *couts-investissement-ballon-ecs-solaire-panneau-inclus
        investissement total avec ballon ECS: *couts-total-investissement-avec-ballon-ecs-a-accumulation
        investissement total avec chauffe-eau solaire: *couts-total-investissement-ballon-ecs-solaire-panneaux

        P1 abonnement: &couts-cout-du-combustible-abonnement-coll
          somme:
            - variations:
                - si:
                    toutes ces conditions:
                      - Inclure la climatisation
                      - type de production de froid = 'Réseau de froid'
                  alors: réseau de froid . coûts . P1 abonnement
                - sinon: 0
            - combustibles . gaz . abonnement collectif / nombre de logements dans l'immeuble concerné
          unité: €TTC/an
        P1 consommation:
          produit:
            - combustibles . gaz . consommation collectif
            - installation . consommation combustible chaleur
            - 1 / ratios . conso combustible
          unité: €TTC/an
        P1 auxiliaires: *couts-cout-electricite-auxiliaire
        P1 ballon ECS: *couts-cout-combustible-pour-ballon-ecs-a-accumulation
        P1 chauffe-eau solaire: *couts-cout-combustible-pour-ballon-ecs-solaire
        P1 froid: *couts-cout-combustible-froid
        petit entretien P2: &entretien-petit-entretien-p2-coll
          produit:
            - ratios . petit entretien P2
            - (besoins chauffage par appartement + besoins eau chaude sanitaire par appartement)
            - nombre de logements dans l'immeuble concerné / 1000
          unité: €TTC/an
        gros entretien P3: &entretien-gros-entretien-p3-coll
          produit:
            - ratios . gros entretien P3
            - coûts . investissement équipement
          unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2 / nombre de logements dans l'immeuble concerné
        gros entretien P3 par logement tertiaire: gros entretien P3 / nombre de logements dans l'immeuble concerné
    aides:
      avec:
        Ma prime renov': *aides-ma-prime-renov
        Coup de pouce: *aides-coup-de-pouce
        CEE: *aides-cee
        Total: *aides-total
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement: *env-besoins-de-chauffage-et-ecs-si-meme-equipement
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique: *env-auxiliaires-et-combustible-electrique
        ECS solaire thermique:
          formule: installation . appoint chauffe-eau solaire * facteurs d'émission . électricité ECS
        ECS avec ballon électrique:
          formule: installation . consommation chauffe-eau électrique * facteurs d'émission . électricité chauffage
        Scope 2: *env-scope-2
        Scope 3: &env-scope-3-coll
          formule: ratios . CO2 installation * installation . puissance retenue / ratios . durée de vie / nombre de logements dans l'immeuble concerné
        Total: *env-total
    bilan:
      avec:
        P1abo: coûts . P1 abonnement
        P1conso: coûts . P1 consommation
        P1prime: coûts . P1 auxiliaires + froid . surcoût P1 auxiliaires
        P1ECS: *bilan-p1ecs
        P1Consofroid: coûts . P1 froid
        P2: coûts . petit entretien P2 par logement tertiaire + froid . surcoût P2
        P3: coûts . gros entretien P3 par logement tertiaire + froid . surcoût P3
        P4 équipement:
          formule: coûts . investissement par logement * facteur d'annuité

        P4 ballon ECS:
          formule: coûts . investissement ballon ECS * ecs additionnelle . facteur d'annuité chauffe-eau électrique

        P4 chauffe-eau solaire: *bilan-p4ecs-solaire-thermique

        P4: *bilan-p4
        aides spécifiques:
          formule: aides . Total * facteur d'annuité

        aides: *bilan-aides
        P4 moins aides: *bilan-p4-moins-aides
        total sans aides: *bilan-total-sans-aides
        total avec aides: *bilan-total-avec-aides
gaz coll sans cond:
  description: Chaudière gaz collective sans condensation
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 25
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        conso auxiliaire ECS:
          valeur: 99%
          unité: '%'
        conso auxiliaire chauffage:
          valeur: 99.8%
          unité: '%'
        conso combustible:
          valeur: 0.0970
          unité: Nm3/kWh PCI
        durée de vie:
          valeur: 22
          unité: an
        gros entretien P3:
          par défaut: 1.72 / 100
          unité: €HT/€d'investissment # %
        investissement équipement:
          produit:
            - variations:
                - si: gaz coll sans cond . installation . puissance retenue <= 35
                  alors: 4800
                - si: gaz coll sans cond . installation . puissance retenue <= 120
                  alors: 15000
                - si: gaz coll sans cond . installation . puissance retenue <= 200
                  alors: 25000
                - si: gaz coll sans cond . installation . puissance retenue <= 300
                  alors: 37500
                - si: gaz coll sans cond . installation . puissance retenue <= 400
                  alors: 40000
                - si: gaz coll sans cond . installation . puissance retenue <= 500
                  alors: 45000
                - si: gaz coll sans cond . installation . puissance retenue <= 600
                  alors: 52335
                - si: gaz coll sans cond . installation . puissance retenue <= 700
                  alors: 61058
                - si: gaz coll sans cond . installation . puissance retenue <= 800
                  alors: 69780
                - si: gaz coll sans cond . installation . puissance retenue <= 900
                  alors: 78503
                - si: gaz coll sans cond . installation . puissance retenue <= 1000
                  alors: 87225
                - si: gaz coll sans cond . installation . puissance retenue <= 1250
                  alors: 109031
                - si: gaz coll sans cond . installation . puissance retenue <= 1500
                  alors: 130838
                - si: gaz coll sans cond . installation . puissance retenue <= 1750
                  alors: 152644
                - sinon: 174450
            - 1 + investissement . TVA
          unité: €TTC
          note: 'Source: ELCIMAI 2024'
        petit entretien P2:
          par défaut: 7.00 * (1 + Paramètres économiques . Petit entretien P2 . TVA)
          unité: €TTC/MWh
        rendement chaudière:
          valeur: 73%
          unité: '%'
    facteur d'annuité: *facteur-annuite-gaz
    installation:
      avec:
        production eau chaude sanitaire: Production eau chaude sanitaire
        puissance chauffage:
          formule: (dimensionnement . puissance chauffage appelée / ratios . rendement chaudière) * nombre de logements dans l'immeuble concerné * ratios . PUIS Coefficient de foisonnement chauffage collectif
          unité: kW
        puissance ECS:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - type de production ECS = 'Avec équipement chauffage'
              alors: ratios . PUIS Coefficient de foisonnement ECS * (dimensionnement . puissance ECS appelée / ratios . rendement chaudière) * nombre de logements dans l'immeuble concerné
            - sinon: 0
          unité: kW
        puissance équipement: *inst-puissance-equipement
        puissance retenue:
          variations:
            - si: puissance équipement <= 35
              alors: 35
            - si: puissance équipement <= 120
              alors: 120
            - si: puissance équipement <= 200
              alors: 200
            - si: puissance équipement <= 300
              alors: 300
            - si: puissance équipement <= 400
              alors: 400
            - si: puissance équipement <= 500
              alors: 500
            - si: puissance équipement <= 600
              alors: 600
            - si: puissance équipement <= 700
              alors: 700
            - si: puissance équipement <= 800
              alors: 800
            - si: puissance équipement <= 900
              alors: 900
            - si: puissance équipement <= 1000
              alors: 1000
            - si: puissance équipement <= 1250
              alors: 1250
            - si: puissance équipement <= 1500
              alors: 1500
            - si: puissance équipement <= 1750
              alors: 1750
            - sinon: 2000
          unité: kW
        ECS additionnelle nécessaire: *inst-besoin-d-installation-supplementaire-pour-produire-l-ecs
        volume du ballon ECS: *inst-volume-du-ballon-ecs
        consommation chauffe-eau électrique: *inst-consommation-d-electricite-chauffe-eau-electrique
        appoint chauffe-eau solaire: *inst-appoint-d-electricite-chauffe-eau-solaire
        consommation combustible chaleur: *inst-consommation-combustible-chaleur
        consommation combustible froid: *inst-consommation-combustible-froid
        consommation auxiliaire: *inst-consommation-auxiliaire
        consommation hors électricité:
          formule: consommation combustible chaleur
        consommation électricité: *inst-consommation-d-electricite-lie-au-chauffage-refroidissement-et-a-la-production-d-ecs
        consommation Groupe Froid: froid . consommation groupe froid
    coûts:
      avec:
        investissement équipement: *couts-investissement-equipement-total
        investissement par logement: *couts-investissement-equipement-par-logement-type-tertiaire-coll
        investissement ballon ECS: *couts-investissement-ballon-ecs-a-accumulation
        investissement chauffe-eau solaire: *couts-investissement-ballon-ecs-solaire-panneau-inclus
        investissement total avec ballon ECS: *couts-total-investissement-avec-ballon-ecs-a-accumulation
        investissement total avec chauffe-eau solaire: *couts-total-investissement-ballon-ecs-solaire-panneaux

        P1 abonnement: *couts-cout-du-combustible-abonnement-coll
        P1 consommation:
          P1 consommation:
          produit:
            - combustibles . gaz . consommation collectif
            - installation . consommation combustible chaleur
            - 1 / ratios . conso combustible
          unité: €TTC/an
        P1 auxiliaires: *couts-cout-electricite-auxiliaire
        P1 ballon ECS: *couts-cout-combustible-pour-ballon-ecs-a-accumulation
        P1 chauffe-eau solaire: *couts-cout-combustible-pour-ballon-ecs-solaire
        P1 froid: *couts-cout-combustible-froid
        petit entretien P2: *entretien-petit-entretien-p2-coll
        gros entretien P3: *entretien-gros-entretien-p3-coll
        petit entretien P2 par logement tertiaire: petit entretien P2 / nombre de logements dans l'immeuble concerné
        gros entretien P3 par logement tertiaire: gros entretien P3 / nombre de logements dans l'immeuble concerné
    aides:
      avec:
        Ma prime renov': *aides-ma-prime-renov
        Coup de pouce: *aides-coup-de-pouce
        CEE: *aides-cee
        Total: *aides-total
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement: *env-besoins-de-chauffage-et-ecs-si-meme-equipement
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique: *env-auxiliaires-et-combustible-electrique
        ECS solaire thermique:
          formule: installation . appoint chauffe-eau solaire * facteurs d'émission . électricité ECS
        ECS avec ballon électrique:
          formule: installation . consommation chauffe-eau électrique * facteurs d'émission . électricité chauffage
        Scope 2: *env-scope-2
        Scope 3: *env-scope-3-coll
        Total: *env-total
    bilan:
      avec:
        P1abo: coûts . P1 abonnement
        P1conso: coûts . P1 consommation
        P1prime: coûts . P1 auxiliaires + froid . surcoût P1 auxiliaires
        P1ECS: *bilan-p1ecs
        P1Consofroid: coûts . P1 froid
        P2: coûts . petit entretien P2 par logement tertiaire + froid . surcoût P2
        P3: coûts . gros entretien P3 par logement tertiaire + froid . surcoût P3
        P4 équipement:
          formule: coûts . investissement par logement * gaz coll avec cond . facteur d'annuité  # bug figé : durée de vie de la variante avec condensation

        P4 ballon ECS:
          formule: coûts . investissement ballon ECS * ecs additionnelle . facteur d'annuité chauffe-eau électrique

        P4 chauffe-eau solaire: *bilan-p4ecs-solaire-thermique

        P4: *bilan-p4
        aides spécifiques:
          formule: aides . Total * gaz coll avec cond . facteur d'annuité  # bug figé : durée de vie de la variante avec condensation

        aides: *bilan-aides
        P4 moins aides: *bilan-p4-moins-aides
        total sans aides: *bilan-total-sans-aides
        total avec aides: *bilan-total-avec-aides

