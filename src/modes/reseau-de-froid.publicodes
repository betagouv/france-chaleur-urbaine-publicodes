# Réseau de froid urbain (RFU)
# Regroupe ratios, dimensionnement, calculs économiques,
# aides, émissions et bilan pour ce mode de chauffage.

###### Ratios techniques

réseau de froid:
  description: Raccordement à un réseau de froid urbain
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        durée de vie:
          valeur: 30
          unité: an
        conso auxiliaire:
          valeur: 99.8%
          unité: '%'
        gros entretien P3:
          par défaut: 0.75 / 100
          unité: €HT/€d'investissment # %
        petit entretien P2:
          par défaut: 1.5 / 100
          unité: €HT/€d'investissment # %
        rendement sous station:
          valeur: 93%
          unité: '%'
    facteur d'annuité:
      description: Annuité pour 1 € investi sur la durée de vie de l'équipement (fonction Excel PMT)
      variations:
        - si: ratios économiques . Amortissement x Taux actualisation != 0
          alors: ratios économiques . Amortissement x Taux actualisation * ((1 + ratios économiques . Amortissement x Taux actualisation) ** ratios . durée de vie) / ((1 + ratios économiques . Amortissement x Taux actualisation) ** ratios . durée de vie - 1)
        - sinon: 1 / ratios . durée de vie
    installation:
      avec:
        production eau chaude sanitaire: non
        puissance refroidissement:
          formule: dimensionnement . puissance refroidissement appelée / ratios . rendement sous station * nombre de logements dans l'immeuble concerné
          # unité: kW # corrigé pour faire fonctionner la division
          # QUESTION : Quelle est l'unité ? Peut-on changer l'unité pour kW ?
          unité: kW
        puissance équipement:
          somme:
            - puissance refroidissement
          unité: kW
        puissance retenue:
          formule: puissance équipement
          unité: kW
        consommation combustible froid:
          formule: besoins en climatisation par appartement / ratios . rendement sous station
          unité: kWh
        consommation auxiliaire:
          formule: (1 - ratios . conso auxiliaire) * besoins en climatisation par appartement
          unité: kWh elec
    coûts:
      avec:
        investissement équipement:
          formule: Investissement x frais de raccordement au réseaux x RFU
          unité: €TTC
        investissement par logement:
          valeur: investissement équipement / nombre de logements dans l'immeuble concerné
          unité: €TTC
        P1 abonnement:
          produit:
            - combustibles . réseau de froid . abonnement
            - installation . consommation combustible froid
          unité: €TTC/an
        P1 auxiliaires:
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation auxiliaire
          unité: €TTC/an) €TTC/an"
        P1 froid:
          produit:
            - combustibles . réseau de froid . consommation
            - installation . consommation combustible froid
          unité: €TTC/an
        petit entretien P2:
            variations:
              - si: Inclure la climatisation
                alors:
                  produit:
                    - ratios . petit entretien P2
                    - (1 + Paramètres économiques . Petit entretien P2 . TVA)
                    - ratios économiques . Réseaux x Coût Investissement SST RFU
                  unité: €TTC/an
              - sinon: 0
            unité: €TTC/an
        gros entretien P3:
            variations:
              - si: Inclure la climatisation
                alors:
                  produit:
                    - ratios . gros entretien P3
                    - (1 + Paramètres économiques . Gros entretien P3 . TVA)
                    - ratios économiques . Réseaux x Coût Investissement SST RFU
              - sinon: 0
            unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2 / nombre de logements dans l'immeuble concerné
        gros entretien P3 par logement tertiaire: gros entretien P3 / nombre de logements dans l'immeuble concerné
    aides:
      avec:
        Ma prime renov':
          variations:
            - si:
                toutes ces conditions:
                  - Paramètres économiques . Aides . Aides x Éligible Ma prime renov'
                  - Paramètres économiques . Aides . Éligibilité x Ressources du ménage = "Très modeste"
              alors: 1200 €
            - si:
                toutes ces conditions:
                  - Paramètres économiques . Aides . Aides x Éligible Ma prime renov'
                  - Paramètres économiques . Aides . Éligibilité x Ressources du ménage = "Modeste"
              alors: 800 €
            - si:
                toutes ces conditions:
                  - Paramètres économiques . Aides . Aides x Éligible Ma prime renov'
                  - Paramètres économiques . Aides . Éligibilité x Ressources du ménage = "Intermédiaire"
              alors: 400 €
          unité: €
          note: "source : MaPrimeRénov' 2024 | Service-Public.fr"
        Coup de pouce:
          applicable si:
            est défini: Coup de pouce
          formule: Coup de pouce
          unité: €
        CEE:
          variations:
            - si: Paramètres économiques . Aides . Aides x Éligible CEE
              alors:
                variations:
                  - si: type de bâtiment = 'résidentiel'
                    alors: 0
                  - sinon: ratios économiques x aides . Tertiaire . CEE x RFU x montant * ratios économiques x aides . Tertiaire . CEE x RFU x facteur correctif * installation . puissance retenue * Paramètres économiques . Aides . Valeur CEE
            - sinon: 0
          unité: €
        Total:
          variations:
            - si: Paramètres économiques . Aides . Éligibilité x Prise en compte des aides
              alors: Ma prime renov' + Coup de pouce + CEE
            - sinon: 0
          unité: €

###### Ratios économiques (investissement)

ratios économiques . Réseaux x Coût Investissement SST RFU:
  variations:
    - si: réseau de froid . installation . puissance retenue < 100
      alors: 28000
    - si: réseau de froid . installation . puissance retenue < 150
      alors: 29500
    - si: réseau de froid . installation . puissance retenue < 200
      alors: 30500
    - si: réseau de froid . installation . puissance retenue < 250
      alors: 32000
    - si: réseau de froid . installation . puissance retenue < 300
      alors: 33000
    - si: réseau de froid . installation . puissance retenue < 350
      alors: 34000
    - si: réseau de froid . installation . puissance retenue < 400
      alors: 35000
    - si: réseau de froid . installation . puissance retenue < 500
      alors: 36500
    - sinon: 39000
  unité: €HT
  note: 'ELCIMAI'

ratios économiques . Réseaux x Coût raccordement RFU x Résidentiel:
  variations:
    - si: nombre de logements dans l'immeuble concerné <= 25
      alors: 4822 * 25 / nombre de logements dans l'immeuble concerné
    - si: nombre de logements dans l'immeuble concerné <= 42
      alors: 4822
    - si: nombre de logements dans l'immeuble concerné <= 58
      alors: 3074
    - si: nombre de logements dans l'immeuble concerné <= 83
      alors: 2402
    - si: nombre de logements dans l'immeuble concerné <= 125
      alors: 1811
    - si: nombre de logements dans l'immeuble concerné <= 167
      alors: 1335
    - si: nombre de logements dans l'immeuble concerné <= 250
      alors: 1114
    - si: nombre de logements dans l'immeuble concerné <= 333
      alors: 911
    - sinon: 790
  unité: €HT/logement
  note: 'source: ELCIMAI'

ratios économiques . Réseaux x Coût raccordement RFU x Tertiaire:
  variations:
    - si: surface logement type tertiaire < 2500
      alors: 120543
    - si: surface logement type tertiaire < 3500
      alors: 129097
    - si: surface logement type tertiaire < 5000
      alors: 139290
    - si: surface logement type tertiaire < 7500
      alors: 150307
    - si: surface logement type tertiaire < 10000
      alors: 166917
    - si: surface logement type tertiaire < 15000
      alors: 185994
    - sinon: 227764
  unité: €HT
  note: 'Source: ELCIMAI'

