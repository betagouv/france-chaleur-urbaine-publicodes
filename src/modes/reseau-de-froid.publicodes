# Réseau de froid urbain (RFU)
# Regroupe ratios, dimensionnement, calculs économiques,
# aides, émissions et bilan pour ce mode de chauffage.

###### Ratios techniques

réseau de froid:
  description: Raccordement à un réseau de froid urbain
  avec:
    installation:
      avec:
        production eau chaude sanitaire: non
        puissance nécessaire pour refroidissement équipement:
          formule: Calcul . Climatisation Puissance refroidissement appelée / ratios . RFU Rendement sous station * nombre de logements dans l'immeuble concerné
          # unité: kW # corrigé pour faire fonctionner la division
          # QUESTION : Quelle est l'unité ? Peut-on changer l'unité pour kW ?
          unité: kW
        puissance équipement:
          somme:
            - puissance nécessaire pour refroidissement équipement
          unité: kW
        gamme de puissance existante:
          formule: puissance équipement
          unité: kW
        consommation combustible froid:
          # =Besoin_raf/Rend_RFU
          formule: besoins en climatisation par appartement / ratios . RFU Rendement sous station
          unité: kWh
        consommation auxiliaire:
          # =(1-Conso_aux_RFU)*Besoin_raf
          formule: (1 - ratios . RFU Conso auxiliaire) * besoins en climatisation par appartement
          unité: kWh elec
    coûts:
      avec:
        # P4 - Investissement total (sans aide) €TTC
        Investissement équipement Total:
          formule: Investissement x frais de raccordement au réseaux x RFU
          unité: €TTC
        Investissement équipement par logement type tertiaire:
          valeur: Investissement équipement Total / nombre de logements dans l'immeuble concerné
          unité: €TTC
        # P1 - Coût du combustible par lgt type / tertiaire
        Coût du combustible abonnement:
          produit:
            - Calcul Eco . Coût d'achat du combustible . Froid RFU x Part abonnement
            - installation . consommation combustible froid
          unité: €TTC/an
          note: 'Coût du combustible abonnement (P1 abo) €TTC/an'
        Coût électricité auxiliaire:
          produit:
            - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
            - installation . consommation auxiliaire
          unité: €TTC/an
          note: "Coût électricité auxiliaire (P1') €TTC/an"
        Coût combustible froid:
          produit:
            - Calcul Eco . Coût d'achat du combustible . Froid RFU x Part consommation
            - installation . consommation combustible froid
          unité: €TTC/an
    entretien:
      avec:
        petit entretien P2:
          # C68 ='Paramètres économiques'!D160*(1+TVA_P2)*VLOOKUP('Paramètres économiques'!$D$20;'Ratios économiques - Coûts'!$B$386:$C$394;2;VRAI)
          variations:
            - si: Inclure la climatisation
              alors:
                produit:
                  - Paramètres économiques . Petit entretien P2 . RFU
                  - (1 + Paramètres économiques . Petit entretien P2 . TVA)
                  - ratios économiques . Réseaux x Coût Investissement SST RFU
                unité: €TTC/an
            - sinon: 0
          unité: €TTC/an
        gros entretien P3:
          variations:
            - si: Inclure la climatisation
              alors:
                produit:
                  - Paramètres économiques . Gros entretien P3 . RFU
                  - (1 + Paramètres économiques . Gros entretien P3 . TVA)
                  - ratios économiques . Réseaux x Coût Investissement SST RFU
            - sinon: 0
          unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2 / nombre de logements dans l'immeuble concerné
        gros entretien P3 par logement tertiaire: gros entretien P3 / nombre de logements dans l'immeuble concerné
    aides:
      avec:
        Ma prime renov':
          applicable si:
            est défini: Ma prime renov'
          formule: Ma prime renov'
          unité: €
        Coup de pouce:
          applicable si:
            est défini: Coup de pouce
          formule: Coup de pouce
          unité: €
        CEE:
          # =IF($B$93="Eligible",IF('Paramètres économiques'!$C$7="Résidentiel",0,XLOOKUP('Paramètres économiques'!$C$11,'Ratios économiques - Aides'!$B$334:$B$342,'Ratios économiques - Aides'!$C$334:$C$342)*XLOOKUP('Paramètres économiques'!$C$13,'Ratios économiques - Aides'!$B$331:$B$333,'Ratios économiques - Aides'!$C$331:$C$333)*'Paramètres économiques'!$C$21*$B$94),0)
          variations:
            - si: Paramètres économiques . Aides . Aides x Éligible CEE
              alors:
                variations:
                  - si: type de bâtiment = 'résidentiel'
                    alors: 0
                  - sinon: ratios économiques x aides . Tertiaire . CEE x RFU x montant * ratios économiques x aides . Tertiaire . CEE x RFU x facteur correctif * installation . gamme de puissance existante * Paramètres économiques . Aides . Valeur CEE
            - sinon: 0
          unité: €
        Total:
          variations:
            - si: Paramètres économiques . Aides . Éligibilité x Prise en compte des aides
              alors: Ma prime renov' + Coup de pouce + CEE
            - sinon: 0
          unité: €

ratios . RFU Rendement sous station:
  valeur: 93%
  unité: '%'

ratios . RFU Conso auxiliaire:
  valeur: 99.8%
  unité: '%'

ratios . RFU Durée de vie:
  valeur: 30
  unité: an

###### Ratios économiques (investissement)

ratios économiques . Réseaux x Coût Investissement SST RFU:
  # =VLOOKUP('Paramètres économiques'!$D$20;'Ratios économiques - Coûts'!$B$386:$C$394;2;TRUE)
  variations:
    - si: réseau de froid . installation . gamme de puissance existante < 100
      alors: 28000
    - si: réseau de froid . installation . gamme de puissance existante < 150
      alors: 29500
    - si: réseau de froid . installation . gamme de puissance existante < 200
      alors: 30500
    - si: réseau de froid . installation . gamme de puissance existante < 250
      alors: 32000
    - si: réseau de froid . installation . gamme de puissance existante < 300
      alors: 33000
    - si: réseau de froid . installation . gamme de puissance existante < 350
      alors: 34000
    - si: réseau de froid . installation . gamme de puissance existante < 400
      alors: 35000
    - si: réseau de froid . installation . gamme de puissance existante < 500
      alors: 36500
    - sinon: 39000
  unité: €HT
  note: 'ELCIMAI'

ratios économiques . Réseaux x Coût raccordement RFU x Résidentiel:
  variations:
    - si: nombre de logements dans l'immeuble concerné <= 25
      alors: 4822 * 25 / nombre de logements dans l'immeuble concerné
    - si: nombre de logements dans l'immeuble concerné <= 42
      alors: 4822
    - si: nombre de logements dans l'immeuble concerné <= 58
      alors: 3074
    - si: nombre de logements dans l'immeuble concerné <= 83
      alors: 2402
    - si: nombre de logements dans l'immeuble concerné <= 125
      alors: 1811
    - si: nombre de logements dans l'immeuble concerné <= 167
      alors: 1335
    - si: nombre de logements dans l'immeuble concerné <= 250
      alors: 1114
    - si: nombre de logements dans l'immeuble concerné <= 333
      alors: 911
    - sinon: 790
  unité: €HT/logement
  note: 'source: ELCIMAI'

ratios économiques . Réseaux x Coût raccordement RFU x Tertiaire:
  variations:
    - si: surface logement type tertiaire < 2500
      alors: 120543
    - si: surface logement type tertiaire < 3500
      alors: 129097
    - si: surface logement type tertiaire < 5000
      alors: 139290
    - si: surface logement type tertiaire < 7500
      alors: 150307
    - si: surface logement type tertiaire < 10000
      alors: 166917
    - si: surface logement type tertiaire < 15000
      alors: 185994
    - sinon: 227764
  unité: €HT
  note: 'Source: ELCIMAI'

