# Granulés : poêle individuel et chaudière collective
# Regroupe ratios, dimensionnement, calculs économiques,
# aides, émissions et bilan pour ce mode de chauffage.

poêle à granulés:
  description: Poêle à granulés individuel
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 122
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        conso combustible:
          valeur: 0.217391304
          unité: kg granulés/an/kWh
        durée de vie:
          valeur: 16
          unité: an
        gros entretien P3:
          par défaut: 0.00 / 100
          unité: €HT/€d'investissment # %
        investissement équipement:
          par défaut:
            produit:
              - poêle à granulés . ratios . coût équipement 12 kW
              - 1 + investissement . TVA
          unité: €TTC
        petit entretien P2:
          par défaut: 35 * (1 + Paramètres économiques . Petit entretien P2 . TVA)
          unité: €TTC/MWh
        rendement poêle chauffage:
          valeur: 80%
          unité: '%'

        coût équipement 12 kW:
          valeur: 5600
          unité: €HT
          note: 'Source: Invicta 2024'
    facteur d'annuité: &facteur-annuite-granules
      description: Annuité pour 1 € investi sur la durée de vie de l'équipement (fonction Excel PMT)
      variations:
        - si: amortissement . taux d'actualisation != 0
          alors: amortissement . taux d'actualisation * ((1 + amortissement . taux d'actualisation) ** ratios . durée de vie) / ((1 + amortissement . taux d'actualisation) ** ratios . durée de vie - 1)
        - sinon: 1 / ratios . durée de vie
    installation:
      avec:
        production eau chaude sanitaire: non
        puissance chauffage:
          formule: (dimensionnement . puissance chauffage appelée / ratios . rendement poêle chauffage)
          unité: kW
        puissance ECS:
          formule: 0
          unité: kW
        puissance équipement:
          somme:
            - puissance chauffage
          unité: kW
        puissance retenue:
          variations:
            - si: puissance équipement < 12
              alors: 12
            - sinon: 0 # Apparement non applicable . Calculs techniques H49 référence une cellule non existante $F$548
          unité: kW
        ECS additionnelle nécessaire: &inst-ecs-additionnelle-necessaire
          toutes ces conditions:
            - Production eau chaude sanitaire
            - puissance ECS <= 0
        volume du ballon ECS: &inst-volume-du-ballon-ecs
          variations:
            - si:
                toutes ces conditions:
                  - ECS additionnelle nécessaire
                  - type de production ECS != "Solaire thermique"
              alors: volume du ballon ECS
            - sinon: 50
          unité: L
        consommation chauffe-eau électrique: &inst-consommation-chauffe-eau-electrique
          variations:
            - si:
                toutes ces conditions:
                  - ECS additionnelle nécessaire
                  - type de production ECS != 'Solaire thermique'
              alors: ecs additionnelle . consommation chauffe-eau électrique
            - sinon: 0
          unité: kWh/an
        appoint chauffe-eau solaire: &inst-appoint-chauffe-eau-solaire
          variations:
            - si:
                toutes ces conditions:
                  - ECS additionnelle nécessaire
                  - type de production ECS = 'Solaire thermique'
              alors: ecs additionnelle . appoint chauffe-eau solaire
            - sinon: 0
          unité: kWh/an
        consommation combustible chaleur:
          formule: ratios . conso combustible * (besoins chauffage par appartement / ratios . rendement poêle chauffage)
          unité: kg granulés/an
        consommation combustible froid: &inst-consommation-combustible-froid
          formule: 0
          unité: kg granulés/an
        consommation auxiliaire:
          formule: 0
          unité: kWh elec
        consommation hors électricité:
          formule: consommation combustible chaleur
        consommation électricité:
          variations:
            - si: ECS additionnelle nécessaire
              alors: consommation auxiliaire + consommation chauffe-eau électrique
            - sinon: 0
          unité: kWh/an
        consommation groupe froid: froid . consommation groupe froid
    coûts:
      avec:
        investissement équipement: &couts-investissement-equipement
          produit:
            - ratios . investissement équipement
            - ( 1 + investissement . pose et mise en place )
          unité: €TTC
        investissement par logement:
          valeur: investissement équipement
          unité: €TTC
        investissement ballon ECS: &couts-investissement-ballon-ecs
          variations:
            - si: installation . ECS additionnelle nécessaire
              alors: ecs additionnelle . investissement ballon ECS
            - sinon: 0
          unité: €TTC
        investissement chauffe-eau solaire: &couts-investissement-chauffe-eau-solaire
          applicable si:
            toutes ces conditions:
              - installation . ECS additionnelle nécessaire
              - type de production ECS = "Solaire thermique"
          formule: ecs additionnelle . investissement chauffe-eau solaire
          unité: €TTC
        investissement total avec ballon ECS: &couts-investissement-total-avec-ballon-ecs
          valeur: investissement par logement + investissement ballon ECS
          unité: €TTC
        investissement total avec chauffe-eau solaire: &couts-investissement-total-avec-chauffe-eau-solaire
          valeur: investissement par logement + investissement chauffe-eau solaire
          unité: €TTC

        P1 abonnement: &couts-p1-abonnement
          variations:
            - si:
                toutes ces conditions:
                  - Inclure la climatisation
                  - type de production de froid = 'Réseau de froid'
              alors: réseau de froid . coûts . P1 abonnement
            - sinon: 0
          unité: €TTC/an
        P1 consommation: &couts-p1-consommation
          produit:
            - combustibles . granulés . consommation
            - installation . consommation combustible chaleur
          unité: €TTC/an
        P1 auxiliaires: &couts-p1-auxiliaires
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation auxiliaire
          unité: €TTC/an
        P1 ballon ECS: &couts-p1-ballon-ecs
          applicable si: installation . consommation chauffe-eau électrique >= 0
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation chauffe-eau électrique
          unité: €TTC/an
        P1 chauffe-eau solaire: &couts-p1-chauffe-eau-solaire
          applicable si: installation . appoint chauffe-eau solaire >= 0
          produit:
            - combustibles . électricité . consommation individuel
            - installation . appoint chauffe-eau solaire
          unité: €TTC/an
        P1 froid: &couts-p1-froid
          variations:
            - si:
                toutes ces conditions:
                  - Inclure la climatisation
                  - type de production de froid = 'Réseau de froid'
              alors: réseau de froid . coûts . P1 froid
            - sinon:
                produit:
                  - combustibles . électricité . consommation collectif
                  - installation . consommation groupe froid
          unité: €TTC/an
        petit entretien P2:
            produit:
              - ratios . petit entretien P2
              - besoins chauffage par appartement / 1000
            unité: €TTC/an
        gros entretien P3: &couts-gros-entretien-p3
          produit:
            - ratios . gros entretien P3
            - coûts . investissement équipement
          unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2
        gros entretien P3 par logement tertiaire: gros entretien P3
    aides:
      avec:
        Ma prime renov':
          variations:
            - si:
                toutes ces conditions:
                  - aides . éligibilité . éligible Ma prime renov'
                  - aides . éligibilité . ressources du ménage = "Très modeste"
              alors: 1800 €
            - si:
                toutes ces conditions:
                  - aides . éligibilité . éligible Ma prime renov'
                  - aides . éligibilité . ressources du ménage = "Modeste"
              alors: 1500 €
            - si:
                toutes ces conditions:
                  - aides . éligibilité . éligible Ma prime renov'
                  - aides . éligibilité . ressources du ménage = "Intermédiaire"
              alors: 1000 €
          unité: €
          note: "source : MaPrimeRénov' 2024 | Service-Public.fr"
        Coup de pouce: &aides-coup-de-pouce
          applicable si:
            est défini: Coup de pouce
          formule: Coup de pouce
          unité: €
        CEE: &aides-cee
          formule: 0
          unité: €
        Total: &aides-total
          variations:
            - si: aides . éligibilité . prise en compte des aides
              alors: Ma prime renov' + Coup de pouce + CEE
            - sinon: 0
          unité: €
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement:
          formule: (installation . consommation combustible chaleur / ratios . conso combustible) * facteurs d'émission . granulés poêle
          unité: kgCO2e
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique:
          valeur: 0
          unité: kgCO2e
        ECS solaire thermique:
          formule: installation . appoint chauffe-eau solaire * facteurs d'émission . électricité ECS
        ECS avec ballon électrique:
          formule: installation . consommation chauffe-eau électrique * facteurs d'émission . électricité chauffage
        Scope 2: &env-scope-2
          somme:
            - auxiliaires et combustible électrique
            - ECS solaire thermique
            - ECS avec ballon électrique
        Scope 3:
          formule: ratios . CO2 installation * installation . puissance retenue / ratios . durée de vie
        Total: &env-total
          somme:
            - Scope 1
            - Scope 2
            - Scope 3
          unité: kgCO2e/an
    bilan:
      avec:
        P1abo: coûts . P1 abonnement
        P1conso: coûts . P1 consommation
        P1prime: coûts . P1 auxiliaires + froid . surcoût P1 auxiliaires
        P1ECS: &bilan-p1ecs
          le maximum de:
            - coûts . P1 ballon ECS
            - coûts . P1 chauffe-eau solaire
        P1Consofroid: coûts . P1 froid
        P2: coûts . petit entretien P2 par logement tertiaire + froid . surcoût P2
        P3: coûts . gros entretien P3 par logement tertiaire + froid . surcoût P3
        P4 équipement:
          formule: coûts . investissement par logement * facteur d'annuité

        P4 ballon ECS:
          formule: coûts . investissement ballon ECS * ecs additionnelle . facteur d'annuité chauffe-eau électrique

        P4 chauffe-eau solaire: &bilan-p4-chauffe-eau-solaire
          variations:
            - si: type de production ECS = 'Solaire thermique'
              alors: coûts . investissement chauffe-eau solaire * ecs additionnelle . facteur d'annuité chauffe-eau solaire
            - sinon: 0

        P4: &bilan-p4
          somme:
            - P4 équipement
            - P4 ballon ECS
            - P4 chauffe-eau solaire
            - froid . P4 groupe froid
            - froid . P4 réseau de froid
        aides spécifiques:
          formule: aides . Total * facteur d'annuité

        aides: &bilan-aides
          somme:
            - aides spécifiques
            - froid . aides réseau de froid
        P4 moins aides: &bilan-p4-moins-aides
          le maximum de:
            - P4 - aides
            - 0
        total sans aides: &bilan-total-sans-aides
          somme:
            - P1abo
            - P1conso
            - P1prime
            - P1ECS
            - P1Consofroid
            - P2
            - P3
            - P4
        total avec aides: &bilan-total-avec-aides
          somme:
            - total sans aides
            - (- aides)
        total sans installation: &bilan-total-sans-installation
          somme:
            - total sans aides
            - (- P4)

chaudière à granulés:
  description: Chaudière à granulés collective
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 88.5
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        conso auxiliaire:
          valeur: 99.8%
          unité: '%'
        conso combustible:
          valeur: 0.217391304
          unité: kg granulés/an/kWh
        durée de vie:
          valeur: 17
          unité: an
        gros entretien P3:
          par défaut: 0.00 / 100
          unité: €HT/€d'investissment # %
        investissement équipement:
          par défaut:
            produit:
              - chaudière à granulés . ratios . coût équipement
              - 1 + investissement . TVA
          unité: €TTC
        petit entretien P2:
          par défaut: 22.000 * (1 + Paramètres économiques . Petit entretien P2 . TVA)
          unité: €TTC/MWh
        rendement chaudière chauffage:
          valeur: 82%
          unité: '%'

        coût équipement:
          variations:
            - si: chaudière à granulés . installation . puissance retenue < 25
              alors: 750 * chaudière à granulés . installation . puissance retenue
            - si: chaudière à granulés . installation . puissance retenue = 25
              alors: 20000
            - si: chaudière à granulés . installation . puissance retenue <= 30
              alors: 26250
            - si: chaudière à granulés . installation . puissance retenue <= 40
              alors: 29750
            - si: chaudière à granulés . installation . puissance retenue <= 50
              alors: 37500
            - sinon: 750 * chaudière à granulés . installation . puissance retenue
          note: 'Source: Hargassner - coûts pour P != 50kW, ELCIMAI pour 50kW'
    facteur d'annuité: *facteur-annuite-granules
    installation:
      avec:
        production eau chaude sanitaire: Production eau chaude sanitaire
        puissance chauffage:
          formule: (dimensionnement . puissance chauffage appelée / ratios . rendement chaudière chauffage) * nombre de logements dans l'immeuble concerné * ratios . PUIS Coefficient de foisonnement chauffage collectif
          unité: kW
        puissance ECS:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - type de production ECS = 'Avec équipement chauffage'
              alors: ratios . PUIS Coefficient de foisonnement ECS * (dimensionnement . puissance ECS appelée / ratios . rendement chaudière chauffage) * nombre de logements dans l'immeuble concerné
            - sinon: 0
          unité: kW
        puissance équipement:
          somme:
            - puissance chauffage
            - puissance ECS
          unité: kW
        puissance retenue:
          variations:
            - si: puissance équipement < 75
              alors: 50
            - si: puissance équipement < 125
              alors: 100
            - si: puissance équipement < 175
              alors: 150
            - si: puissance équipement < 225
              alors: 200
            - si: puissance équipement < 275
              alors: 250
            - si: puissance équipement < 325
              alors: 300
            - si: puissance équipement < 375
              alors: 350
            - si: puissance équipement < 425
              alors: 400
            - si: puissance équipement < 475
              alors: 450
            - si: puissance équipement < 525
              alors: 500
            - si: puissance équipement < 575
              alors: 550
            - si: puissance équipement < 625
              alors: 600
            - si: puissance équipement < 675
              alors: 650
            - si: puissance équipement < 725
              alors: 700
            - si: puissance équipement < 775
              alors: 750
            - si: puissance équipement < 825
              alors: 800
            - si: puissance équipement < 875
              alors: 850
            - si: puissance équipement < 925
              alors: 900
            - si: puissance équipement < 975
              alors: 950
            - si: puissance équipement < 1025
              alors: 1000
            - si: puissance équipement < 1075
              alors: 1050
            - si: puissance équipement < 1125
              alors: 1100
            - si: puissance équipement < 1175
              alors: 1150
            - si: puissance équipement < 1225
              alors: 1200
            - si: puissance équipement < 1275
              alors: 1250
            - si: puissance équipement < 1325
              alors: 1300
            - si: puissance équipement < 1375
              alors: 1350
            - si: puissance équipement < 1425
              alors: 1400
            - si: puissance équipement < 1475
              alors: 1450
            - si: puissance équipement < 1525
              alors: 1500
            - si: puissance équipement < 1575
              alors: 1550
            - si: puissance équipement < 1625
              alors: 1600
            - si: puissance équipement < 1675
              alors: 1650
            - si: puissance équipement < 1725
              alors: 1700
            - si: puissance équipement < 1775
              alors: 1750
            - si: puissance équipement < 1825
              alors: 1800
            - si: puissance équipement < 1875
              alors: 1850
            - si: puissance équipement < 1925
              alors: 1900
            - si: puissance équipement < 1975
              alors: 1950
            - sinon: 2000
          unité: kW
        ECS additionnelle nécessaire: *inst-ecs-additionnelle-necessaire
        volume du ballon ECS: *inst-volume-du-ballon-ecs
        consommation chauffe-eau électrique: *inst-consommation-chauffe-eau-electrique
        appoint chauffe-eau solaire: *inst-appoint-chauffe-eau-solaire
        consommation combustible chaleur:
          # formule: ratios . conso combustible * (besoins chauffage par appartement + besoins eau chaude sanitaire par appartement) / ratios . rendement chaudière chauffage
          produit:
            - ratios . conso combustible
            - somme:
                - besoins chauffage par appartement
                - variations:
                    - si: type de production ECS = 'Avec équipement chauffage'
                      alors: besoins eau chaude sanitaire par appartement
                    - sinon: 0
            - 1 / ratios . rendement chaudière chauffage
          unité: kg granulés/an
        consommation combustible froid: *inst-consommation-combustible-froid
        consommation auxiliaire:
          somme:
            - (1 - ratios . conso auxiliaire) * besoins chauffage par appartement
            - variations:
                - si:
                    toutes ces conditions:
                      - type de production ECS = 'Avec équipement chauffage'
                      - Production eau chaude sanitaire
                  alors: (1 - ratios . conso auxiliaire) * besoins eau chaude sanitaire par appartement
                - sinon: 0
          unité: kWh elec
        consommation hors électricité:
          formule: consommation combustible chaleur
        consommation électricité:
          variations:
            - si: ECS additionnelle nécessaire
              alors: consommation auxiliaire + consommation chauffe-eau électrique
            - sinon: consommation auxiliaire
          unité: kWh/an
        consommation groupe froid: froid . consommation groupe froid
    coûts:
      avec:
        investissement équipement: *couts-investissement-equipement
        investissement par logement:
          valeur: investissement équipement / nombre de logements dans l'immeuble concerné
          unité: €TTC
        investissement ballon ECS: *couts-investissement-ballon-ecs
        investissement chauffe-eau solaire: *couts-investissement-chauffe-eau-solaire
        investissement total avec ballon ECS: *couts-investissement-total-avec-ballon-ecs
        investissement total avec chauffe-eau solaire: *couts-investissement-total-avec-chauffe-eau-solaire

        P1 abonnement: *couts-p1-abonnement
        P1 consommation: *couts-p1-consommation
        P1 auxiliaires: *couts-p1-auxiliaires
        P1 ballon ECS: *couts-p1-ballon-ecs
        P1 chauffe-eau solaire: *couts-p1-chauffe-eau-solaire
        P1 froid: *couts-p1-froid
        petit entretien P2:
            produit:
              - ratios . petit entretien P2
              - (besoins chauffage par appartement + besoins eau chaude sanitaire par appartement)
              - nombre de logements dans l'immeuble concerné / 1000
            unité: €TTC/an
        gros entretien P3: *couts-gros-entretien-p3
        petit entretien P2 par logement tertiaire: petit entretien P2 / nombre de logements dans l'immeuble concerné
        gros entretien P3 par logement tertiaire: gros entretien P3 / nombre de logements dans l'immeuble concerné
    aides:
      avec:
        Ma prime renov':
          variations:
            - si: aides . éligibilité . prise en compte des aides
              alors: 35 / 100 * coûts . investissement par logement
            - sinon: 0
          unité: €
        Coup de pouce: *aides-coup-de-pouce
        CEE: *aides-cee
        Total: *aides-total
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement:
          formule: installation . consommation combustible chaleur / ratios . conso combustible * facteurs d'émission . granulés chaudière
          unité: kgCO2e
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique:
          formule: installation . consommation auxiliaire * facteurs d'émission . électricité chauffage
          unité: kgCO2e
        ECS solaire thermique:
          formule: installation . appoint chauffe-eau solaire * facteurs d'émission . électricité ECS
        ECS avec ballon électrique:
          formule: installation . consommation chauffe-eau électrique * facteurs d'émission . électricité chauffage
        Scope 2: *env-scope-2
        Scope 3:
          formule: ratios . CO2 installation * installation . puissance retenue / ratios . durée de vie / nombre de logements dans l'immeuble concerné
        Total: *env-total
    bilan:
      avec:
        P1abo: coûts . P1 abonnement
        P1conso: coûts . P1 consommation
        P1prime: coûts . P1 auxiliaires + froid . surcoût P1 auxiliaires
        P1ECS: *bilan-p1ecs
        P1Consofroid: coûts . P1 froid
        P2: coûts . petit entretien P2 par logement tertiaire + froid . surcoût P2
        P3: coûts . gros entretien P3 par logement tertiaire + froid . surcoût P3
        P4 équipement:
          formule: coûts . investissement par logement * facteur d'annuité

        P4 ballon ECS:
          formule: coûts . investissement ballon ECS * ecs additionnelle . facteur d'annuité chauffe-eau électrique

        P4 chauffe-eau solaire: *bilan-p4-chauffe-eau-solaire

        P4: *bilan-p4
        aides spécifiques:
          formule: aides . Total * facteur d'annuité

        aides: *bilan-aides
        P4 moins aides: *bilan-p4-moins-aides
        total sans aides: *bilan-total-sans-aides
        total avec aides: *bilan-total-avec-aides
        total sans installation: *bilan-total-sans-installation

