# Granulés : poêle individuel et chaudière collective
# Regroupe ratios, dimensionnement, calculs économiques,
# aides, émissions et bilan pour ce mode de chauffage.

###### Ratios techniques

poêle à granulés:
  description: Poêle à granulés individuel
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 122
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        conso combustible:
          valeur: 0.217391304
          unité: kg granulés/an/kWh
        durée de vie:
          valeur: 16
          unité: an
        gros entretien P3:
          par défaut: 0.00 / 100
          unité: €HT/€d'investissment # %
        investissement équipement:
          par défaut:
            produit:
              - ratios économiques . Granulés x Poêle à granulés indiv x Résidentiel individuel . Coût investissement Puissance 12 kW
              - 1 + ratios économiques . Investissement x TVA
          unité: €TTC
        petit entretien P2:
          par défaut: 35 * (1 + Paramètres économiques . Petit entretien P2 . TVA)
          unité: €TTC/MWh
        rendement poêle chauffage:
          valeur: 80%
          unité: '%'
    facteur d'annuité: &facteur-annuite-granules
      description: Annuité pour 1 € investi sur la durée de vie de l'équipement (fonction Excel PMT)
      variations:
        - si: ratios économiques . Amortissement x Taux actualisation != 0
          alors: ratios économiques . Amortissement x Taux actualisation * ((1 + ratios économiques . Amortissement x Taux actualisation) ** ratios . durée de vie) / ((1 + ratios économiques . Amortissement x Taux actualisation) ** ratios . durée de vie - 1)
        - sinon: 1 / ratios . durée de vie
    installation:
      avec:
        production eau chaude sanitaire: non
        puissance nécessaire équipement chauffage:
          formule: (Calcul . Chauffage Puissance chauffage appelée / ratios . rendement poêle chauffage)
          unité: kW
        puissance nécessaire pour ECS avec équipement:
          formule: 0
          unité: kW
        puissance équipement:
          somme:
            - puissance nécessaire équipement chauffage
          unité: kW
        gamme de puissance existante:
          variations:
            - si: puissance équipement < 12
              alors: 12
            - sinon: 0 # Apparement non applicable . Calculs techniques H49 référence une cellule non existante $F$548
          unité: kW
        besoin d'installation supplémentaire pour produire l'ECS: &inst-besoin-d-installation-supplementaire-pour-produire-l-ecs
          toutes ces conditions:
            - Production eau chaude sanitaire
            - puissance nécessaire pour ECS avec équipement <= 0
        volume du ballon ECS: &inst-volume-du-ballon-ecs
          variations:
            - si:
                toutes ces conditions:
                  - besoin d'installation supplémentaire pour produire l'ECS
                  - type de production ECS != "Solaire thermique"
              alors: volume du ballon ECS
            - sinon: 50
          unité: L
        consommation d'électricité chauffe-eau électrique: &inst-consommation-d-electricite-chauffe-eau-electrique
          variations:
            - si:
                toutes ces conditions:
                  - besoin d'installation supplémentaire pour produire l'ECS
                  - type de production ECS != 'Solaire thermique'
              alors: chauffe-eau électrique x consommation d'électricité
            - sinon: 0
          unité: kWh/an
        appoint d'électricité chauffe-eau solaire: &inst-appoint-d-electricite-chauffe-eau-solaire
          variations:
            - si:
                toutes ces conditions:
                  - besoin d'installation supplémentaire pour produire l'ECS
                  - type de production ECS = 'Solaire thermique'
              alors: chauffe-eau solaire x appoint d'électricité
            - sinon: 0
          unité: kWh/an
        consommation combustible chaleur:
          formule: ratios . conso combustible * (besoins chauffage par appartement / ratios . rendement poêle chauffage)
          unité: kg granulés/an
        consommation combustible froid: &inst-consommation-combustible-froid
          formule: 0
          unité: kg granulés/an
        consommation auxiliaire:
          formule: 0
          unité: kWh elec
        consommation combustible hors électricité:
          formule: consommation combustible chaleur
        consommation d'électricité lié au chauffage-refroidissement et à la production d'ECS:
          variations:
            - si: besoin d'installation supplémentaire pour produire l'ECS
              alors: consommation auxiliaire + consommation d'électricité chauffe-eau électrique
            - sinon: 0
          unité: kWh/an
        consommation Groupe Froid: calcul consommation Groupe Froid
    coûts:
      avec:
        Investissement équipement Total: &couts-investissement-equipement-total
          produit:
            - ratios . investissement équipement
            - ( 1 + ratios économiques . Investissement x Pose et mise en place de l'installation )
          unité: €TTC
        Investissement équipement par logement type tertiaire:
          valeur: Investissement équipement Total
          unité: €TTC
        Investissement ballon ECS à accumulation: &couts-investissement-ballon-ecs-a-accumulation
          variations:
            - si: installation . besoin d'installation supplémentaire pour produire l'ECS
              alors: Calcul Eco . Investissement ballon ECS à accumulation
            - sinon: 0
          unité: €TTC
        Investissement ballon ECS solaire panneau inclus: &couts-investissement-ballon-ecs-solaire-panneau-inclus
          applicable si:
            toutes ces conditions:
              - installation . besoin d'installation supplémentaire pour produire l'ECS
              - type de production ECS = "Solaire thermique"
          formule: Calcul Eco . Investissement ballon ECS panneau inclus
          unité: €TTC
        Total investissement avec ballon ECS à accumulation: &couts-total-investissement-avec-ballon-ecs-a-accumulation
          valeur: Investissement équipement par logement type tertiaire + Investissement ballon ECS à accumulation
          unité: €TTC
        Total investissement ballon ECS solaire panneaux: &couts-total-investissement-ballon-ecs-solaire-panneaux
          valeur: Investissement équipement par logement type tertiaire + Investissement ballon ECS solaire panneau inclus
          unité: €TTC

        Coût du combustible abonnement: &couts-cout-du-combustible-abonnement
          variations:
            - si:
                toutes ces conditions:
                  - Inclure la climatisation
                  - type de production de froid = 'Réseau de froid'
              alors: réseau de froid . coûts . Coût du combustible abonnement
            - sinon: 0
          unité: €TTC/an
          note: 'Coût du combustible abonnement (P1 abo) €TTC/an'
        Coût du combustible consommation: &couts-cout-du-combustible-consommation
          produit:
            - combustibles . granulés . consommation
            - installation . consommation combustible chaleur
          unité: €TTC/an
          note: 'Coût du combustible consommation (P1 conso) €TTC/an'
        Coût électricité auxiliaire: &couts-cout-electricite-auxiliaire
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation auxiliaire
          unité: €TTC/an
          note: "Coût électricité auxiliaire (P1') €TTC/an"
        Coût combustible pour ballon ECS à accumulation: &couts-cout-combustible-pour-ballon-ecs-a-accumulation
          applicable si: installation . consommation d'électricité chauffe-eau électrique >= 0
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation d'électricité chauffe-eau électrique
          unité: €TTC/an
          note: 'Coût combustible pour ballon ECS à accumulation (P1 ECS) €TTC/an'
        Coût combustible pour ballon ECS solaire: &couts-cout-combustible-pour-ballon-ecs-solaire
          applicable si: installation . appoint d'électricité chauffe-eau solaire >= 0
          produit:
            - combustibles . électricité . consommation individuel
            - installation . appoint d'électricité chauffe-eau solaire
          unité: €TTC/an
          note: 'Coût combustible pour ballon ECS solaire (P1 ECS)€TTC/an'
        Coût combustible froid: &couts-cout-combustible-froid
          variations:
            - si:
                toutes ces conditions:
                  - Inclure la climatisation
                  - type de production de froid = 'Réseau de froid'
              alors: réseau de froid . coûts . Coût combustible froid
            - sinon:
                produit:
                  - combustibles . électricité . consommation collectif
                  - installation . consommation Groupe Froid
          unité: €TTC/an
    entretien:
      avec:
        petit entretien P2:
            produit:
              - ratios . petit entretien P2
              - besoins chauffage par appartement / 1000
            unité: €TTC/an
        gros entretien P3: &entretien-gros-entretien-p3
          produit:
            - ratios . gros entretien P3
            - coûts . Investissement équipement Total
          unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2
        gros entretien P3 par logement tertiaire: gros entretien P3
    aides:
      avec:
        Ma prime renov':
          variations:
            - si:
                toutes ces conditions:
                  - Paramètres économiques . Aides . Aides x Éligible Ma prime renov'
                  - Paramètres économiques . Aides . Éligibilité x Ressources du ménage = "Très modeste"
              alors: 1800 €
            - si:
                toutes ces conditions:
                  - Paramètres économiques . Aides . Aides x Éligible Ma prime renov'
                  - Paramètres économiques . Aides . Éligibilité x Ressources du ménage = "Modeste"
              alors: 1500 €
            - si:
                toutes ces conditions:
                  - Paramètres économiques . Aides . Aides x Éligible Ma prime renov'
                  - Paramètres économiques . Aides . Éligibilité x Ressources du ménage = "Intermédiaire"
              alors: 1000 €
          unité: €
          note: "source : MaPrimeRénov' 2024 | Service-Public.fr"
        Coup de pouce: &aides-coup-de-pouce
          applicable si:
            est défini: Coup de pouce
          formule: Coup de pouce
          unité: €
        CEE: &aides-cee
          formule: 0
          unité: €
        Total: &aides-total
          variations:
            - si: Paramètres économiques . Aides . Éligibilité x Prise en compte des aides
              alors: Ma prime renov' + Coup de pouce + CEE
            - sinon: 0
          unité: €
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement:
          formule: (installation . consommation combustible chaleur / ratios . conso combustible) * ratios environnementaux . Emission spé Granulé poêle à bois
          unité: kgCO2e
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique:
          valeur: 0
          unité: kgCO2e
        ECS solaire thermique:
          formule: installation . appoint d'électricité chauffe-eau solaire * ratios environnementaux . Emission moy Parc électrique francais moyenne ECS
        ECS avec ballon électrique:
          formule: installation . consommation d'électricité chauffe-eau électrique * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
        Scope 2: &env-scope-2
          somme:
            - auxiliaires et combustible électrique
            - ECS solaire thermique
            - ECS avec ballon électrique
        Scope 3:
          formule: ratios . CO2 installation * installation . gamme de puissance existante / ratios . durée de vie
        Total: &env-total
          somme:
            - Scope 1
            - Scope 2
            - Scope 3
          unité: kgCO2e/an
    bilan:
      avec:
        P1abo: coûts . Coût du combustible abonnement
        P1conso: coûts . Coût du combustible consommation
        P1prime: coûts . Coût électricité auxiliaire + Calcul Bilan . Surcout Réseau de froid P1prime
        P1ECS: &bilan-p1ecs
          le maximum de:
            - coûts . Coût combustible pour ballon ECS à accumulation
            - coûts . Coût combustible pour ballon ECS solaire
        P1Consofroid: coûts . Coût combustible froid
        P2: entretien . petit entretien P2 par logement tertiaire + Calcul Bilan . Surcout Réseau de froid P2
        P3: entretien . gros entretien P3 par logement tertiaire + Calcul Bilan . Surcout Réseau de froid P3
        P4spec:
          formule: coûts . Investissement équipement par logement type tertiaire * facteur d'annuité

        P4ECS Ballon électrique:
          formule: coûts . Investissement ballon ECS à accumulation * facteur d'annuité chauffe-eau électrique

        P4ECS Solaire Thermique: &bilan-p4ecs-solaire-thermique
          variations:
            - si: type de production ECS = 'Solaire thermique'
              alors: coûts . Investissement ballon ECS solaire panneau inclus * facteur d'annuité chauffe-eau solaire
            - sinon: 0

        P4: &bilan-p4
          somme:
            - P4spec
            - P4ECS Ballon électrique
            - P4ECS Solaire Thermique
            - Calcul Bilan . P4 groupe froid
            - Calcul Bilan . P4 Réseau de froid
        aides spécifiques:
          formule: aides . Total * facteur d'annuité

        aides: &bilan-aides
          somme:
            - aides spécifiques
            - Calcul Bilan . aides réseau de froid
        P4 moins aides: &bilan-p4-moins-aides
          le maximum de:
            - P4 - aides
            - 0
        total sans aides: &bilan-total-sans-aides
          somme:
            - P1abo
            - P1conso
            - P1prime
            - P1ECS
            - P1Consofroid
            - P2
            - P3
            - P4
        total avec aides: &bilan-total-avec-aides
          somme:
            - total sans aides
            - (- aides)
        total sans installation: &bilan-total-sans-installation
          somme:
            - total sans aides
            - (- P4)
chaudière à granulés:
  description: Chaudière à granulés collective
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 88.5
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        conso auxiliaire:
          valeur: 99.8%
          unité: '%'
        conso combustible:
          valeur: 0.217391304
          unité: kg granulés/an/kWh
        durée de vie:
          valeur: 17
          unité: an
        gros entretien P3:
          par défaut: 0.00 / 100
          unité: €HT/€d'investissment # %
        investissement équipement:
          par défaut:
            produit:
              - ratios économiques . Granulés x Chaudière à granulés collective
              - 1 + ratios économiques . Investissement x TVA
          unité: €TTC
        petit entretien P2:
          par défaut: 22.000 * (1 + Paramètres économiques . Petit entretien P2 . TVA)
          unité: €TTC/MWh
        rendement chaudière chauffage:
          valeur: 82%
          unité: '%'
    facteur d'annuité: *facteur-annuite-granules
    installation:
      avec:
        production eau chaude sanitaire: Production eau chaude sanitaire
        puissance nécessaire équipement chauffage:
          formule: (Calcul . Chauffage Puissance chauffage appelée / ratios . rendement chaudière chauffage) * nombre de logements dans l'immeuble concerné * ratios . PUIS Coefficient de foisonnement chauffage collectif
          unité: kW
        puissance nécessaire pour ECS avec équipement:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - type de production ECS = 'Avec équipement chauffage'
              alors: ratios . PUIS Coefficient de foisonnement ECS * (Calcul . ECS Puissance ECS appelée / ratios . rendement chaudière chauffage) * nombre de logements dans l'immeuble concerné
            - sinon: 0
          unité: kW
        puissance équipement:
          somme:
            - puissance nécessaire équipement chauffage
            - puissance nécessaire pour ECS avec équipement
          unité: kW
        gamme de puissance existante:
          variations:
            - si: puissance équipement < 75
              alors: 50
            - si: puissance équipement < 125
              alors: 100
            - si: puissance équipement < 175
              alors: 150
            - si: puissance équipement < 225
              alors: 200
            - si: puissance équipement < 275
              alors: 250
            - si: puissance équipement < 325
              alors: 300
            - si: puissance équipement < 375
              alors: 350
            - si: puissance équipement < 425
              alors: 400
            - si: puissance équipement < 475
              alors: 450
            - si: puissance équipement < 525
              alors: 500
            - si: puissance équipement < 575
              alors: 550
            - si: puissance équipement < 625
              alors: 600
            - si: puissance équipement < 675
              alors: 650
            - si: puissance équipement < 725
              alors: 700
            - si: puissance équipement < 775
              alors: 750
            - si: puissance équipement < 825
              alors: 800
            - si: puissance équipement < 875
              alors: 850
            - si: puissance équipement < 925
              alors: 900
            - si: puissance équipement < 975
              alors: 950
            - si: puissance équipement < 1025
              alors: 1000
            - si: puissance équipement < 1075
              alors: 1050
            - si: puissance équipement < 1125
              alors: 1100
            - si: puissance équipement < 1175
              alors: 1150
            - si: puissance équipement < 1225
              alors: 1200
            - si: puissance équipement < 1275
              alors: 1250
            - si: puissance équipement < 1325
              alors: 1300
            - si: puissance équipement < 1375
              alors: 1350
            - si: puissance équipement < 1425
              alors: 1400
            - si: puissance équipement < 1475
              alors: 1450
            - si: puissance équipement < 1525
              alors: 1500
            - si: puissance équipement < 1575
              alors: 1550
            - si: puissance équipement < 1625
              alors: 1600
            - si: puissance équipement < 1675
              alors: 1650
            - si: puissance équipement < 1725
              alors: 1700
            - si: puissance équipement < 1775
              alors: 1750
            - si: puissance équipement < 1825
              alors: 1800
            - si: puissance équipement < 1875
              alors: 1850
            - si: puissance équipement < 1925
              alors: 1900
            - si: puissance équipement < 1975
              alors: 1950
            - sinon: 2000
          unité: kW
        besoin d'installation supplémentaire pour produire l'ECS: *inst-besoin-d-installation-supplementaire-pour-produire-l-ecs
        volume du ballon ECS: *inst-volume-du-ballon-ecs
        consommation d'électricité chauffe-eau électrique: *inst-consommation-d-electricite-chauffe-eau-electrique
        appoint d'électricité chauffe-eau solaire: *inst-appoint-d-electricite-chauffe-eau-solaire
        consommation combustible chaleur:
          # formule: ratios . conso combustible * (besoins chauffage par appartement + besoins eau chaude sanitaire par appartement) / ratios . rendement chaudière chauffage
          produit:
            - ratios . conso combustible
            - somme:
                - besoins chauffage par appartement
                - variations:
                    - si: type de production ECS = 'Avec équipement chauffage'
                      alors: besoins eau chaude sanitaire par appartement
                    - sinon: 0
            - 1 / ratios . rendement chaudière chauffage
          unité: kg granulés/an
        consommation combustible froid: *inst-consommation-combustible-froid
        consommation auxiliaire:
          somme:
            - (1 - ratios . conso auxiliaire) * besoins chauffage par appartement
            - variations:
                - si:
                    toutes ces conditions:
                      - type de production ECS = 'Avec équipement chauffage'
                      - Production eau chaude sanitaire
                  alors: (1 - ratios . conso auxiliaire) * besoins eau chaude sanitaire par appartement
                - sinon: 0
          unité: kWh elec
        consommation combustible hors électricité:
          formule: consommation combustible chaleur
        consommation d'électricité lié au chauffage-refroidissement et à la production d'ECS:
          variations:
            - si: besoin d'installation supplémentaire pour produire l'ECS
              alors: consommation auxiliaire + consommation d'électricité chauffe-eau électrique
            - sinon: consommation auxiliaire
          unité: kWh/an
        consommation Groupe Froid: calcul consommation Groupe Froid
    coûts:
      avec:
        Investissement équipement Total: *couts-investissement-equipement-total
        Investissement équipement par logement type tertiaire:
          valeur: Investissement équipement Total / nombre de logements dans l'immeuble concerné
          unité: €TTC
        Investissement ballon ECS à accumulation: *couts-investissement-ballon-ecs-a-accumulation
        Investissement ballon ECS solaire panneau inclus: *couts-investissement-ballon-ecs-solaire-panneau-inclus
        Total investissement avec ballon ECS à accumulation: *couts-total-investissement-avec-ballon-ecs-a-accumulation
        Total investissement ballon ECS solaire panneaux: *couts-total-investissement-ballon-ecs-solaire-panneaux

        Coût du combustible abonnement: *couts-cout-du-combustible-abonnement
        Coût du combustible consommation: *couts-cout-du-combustible-consommation
        Coût électricité auxiliaire: *couts-cout-electricite-auxiliaire
        Coût combustible pour ballon ECS à accumulation: *couts-cout-combustible-pour-ballon-ecs-a-accumulation
        Coût combustible pour ballon ECS solaire: *couts-cout-combustible-pour-ballon-ecs-solaire
        Coût combustible froid: *couts-cout-combustible-froid
    entretien:
      avec:
        petit entretien P2:
            produit:
              - ratios . petit entretien P2
              - (besoins chauffage par appartement + besoins eau chaude sanitaire par appartement)
              - nombre de logements dans l'immeuble concerné / 1000
            unité: €TTC/an
        gros entretien P3: *entretien-gros-entretien-p3
        petit entretien P2 par logement tertiaire: petit entretien P2 / nombre de logements dans l'immeuble concerné
        gros entretien P3 par logement tertiaire: gros entretien P3 / nombre de logements dans l'immeuble concerné
    aides:
      avec:
        Ma prime renov':
          variations:
            - si: Paramètres économiques . Aides . Éligibilité x Prise en compte des aides
              alors: 35 / 100 * coûts . Investissement équipement par logement type tertiaire
            - sinon: 0
          unité: €
        Coup de pouce: *aides-coup-de-pouce
        CEE: *aides-cee
        Total: *aides-total
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement:
          formule: installation . consommation combustible chaleur / ratios . conso combustible * ratios environnementaux . Emission spé Granulé chaudière
          unité: kgCO2e
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique:
          formule: installation . consommation auxiliaire * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
          unité: kgCO2e
        ECS solaire thermique:
          formule: installation . appoint d'électricité chauffe-eau solaire * ratios environnementaux . Emission moy Parc électrique francais moyenne ECS
        ECS avec ballon électrique:
          formule: installation . consommation d'électricité chauffe-eau électrique * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
        Scope 2: *env-scope-2
        Scope 3:
          formule: ratios . CO2 installation * installation . gamme de puissance existante / ratios . durée de vie / nombre de logements dans l'immeuble concerné
        Total: *env-total
    bilan:
      avec:
        P1abo: coûts . Coût du combustible abonnement
        P1conso: coûts . Coût du combustible consommation
        P1prime: coûts . Coût électricité auxiliaire + Calcul Bilan . Surcout Réseau de froid P1prime
        P1ECS: *bilan-p1ecs
        P1Consofroid: coûts . Coût combustible froid
        P2: entretien . petit entretien P2 par logement tertiaire + Calcul Bilan . Surcout Réseau de froid P2
        P3: entretien . gros entretien P3 par logement tertiaire + Calcul Bilan . Surcout Réseau de froid P3
        P4spec:
          formule: coûts . Investissement équipement par logement type tertiaire * facteur d'annuité

        P4ECS Ballon électrique:
          formule: coûts . Investissement ballon ECS à accumulation * facteur d'annuité chauffe-eau électrique

        P4ECS Solaire Thermique: *bilan-p4ecs-solaire-thermique

        P4: *bilan-p4
        aides spécifiques:
          formule: aides . Total * facteur d'annuité

        aides: *bilan-aides
        P4 moins aides: *bilan-p4-moins-aides
        total sans aides: *bilan-total-sans-aides
        total avec aides: *bilan-total-avec-aides
        total sans installation: *bilan-total-sans-installation

###### Ratios économiques (investissement)

ratios économiques . Granulés x Poêle à granulés indiv x Résidentiel individuel:
  avec:
    Coût investissement Puissance 12 kW:
      valeur: 5600
      unité: €HT
  note: 'Source: Invicta 2024'

ratios économiques . Granulés x Chaudière à granulés collective:
  variations:
    - si: chaudière à granulés . installation . gamme de puissance existante < 25
      alors: 750 * chaudière à granulés . installation . gamme de puissance existante
    - si: chaudière à granulés . installation . gamme de puissance existante = 25
      alors: 20000
    - si: chaudière à granulés . installation . gamme de puissance existante <= 30
      alors: 26250
    - si: chaudière à granulés . installation . gamme de puissance existante <= 40
      alors: 29750
    - si: chaudière à granulés . installation . gamme de puissance existante <= 50
      alors: 37500
    - sinon: 750 * chaudière à granulés . installation . gamme de puissance existante
  note: 'Source: Hargassner - coûts pour P != 50kW, ELCIMAI pour 50kW'

