# PAC air-air (indiv/coll)
# Regroupe ratios, dimensionnement, calculs économiques,
# aides, émissions et bilan pour ce mode de chauffage.

###### Ratios techniques

###### Modes

PAC air-air indiv:
  description: Pompe à chaleur air-air individuelle (réversible)
PAC air-air coll:
  description: Pompe à chaleur air-air collective (réversible)

ratios . PAC AIR AIR SCOP indiv:
  valeur: 2.7

ratios . PAC AIR AIR SCOP coll:
  valeur: 3.3

ratios . PAC AIR AIR SEER indiv:
  valeur: 3.5

ratios . PAC AIR AIR SEER coll:
  valeur: 4

ratios . PAC AIR AIR Puissance unitaire réversible coll:
  valeur: 22
  unité: kW

ratios . PAC AIR AIR Puissance unitaire groupe froid indiv:
  valeur: 2.5
  unité: kW

ratios . PAC AIR AIR Durée de vie indiv:
  valeur: 17
  unité: an

ratios . PAC AIR AIR Durée de vie coll:
  valeur: 22
  unité: an

###### Ratios économiques (investissement)

ratios économiques . PAC x air-air réversible:
  avec:
    Coût investissement Individuel:
      valeur: 734
      unité: €HT/kW
      note: 'Source: ADEME Coûts EnR 2022 2020'
    Coût investissement Collectif:
      valeur: 661
      unité: €HT/kW
      note: 'Source: ELCIMAI 2024'

# pas un ratio
ratios économiques . PAC x air-air réversible x Individuel:
  # param éco D68 ='Ratios économiques - Coûts'!C166*'Calculs techniques'!H57*(1+TVA_inv)
  produit:
    - ratios économiques . PAC x air-air réversible . Coût investissement Individuel
    - PAC air-air indiv . installation . gamme de puissance existante
    - 1 + ratios économiques . Investissement x TVA

# pas un ratio
ratios économiques . PAC x air-air réversible x Collectif:
  # param éco D69 ='Calculs techniques'!H58*'Ratios économiques - Coûts'!C171*(1+TVA_inv)
  produit:
    - ratios économiques . PAC x air-air réversible . Coût investissement Collectif
    - PAC air-air coll . installation . gamme de puissance existante
    - 1 + ratios économiques . Investissement x TVA

###### Ratios environnementaux

ratios environnementaux . CO2 INS PAC air-air indiv:
  # Ratios environnementaux'!$C$45
  formule: 1000
  unité: kgCO2e/kW
  note: 'Source: INIES 2022'

ratios environnementaux . CO2 INS PAC air-air collectif-tertiaire:
  # Ratios environnementaux'!$C$48
  formule: 409.375
  unité: kgCO2e/kW
  note: 'Source: INIES 2022'

###### Installation (dimensionnement et consommations)

PAC air-air indiv . installation:
  avec:
    production eau chaude sanitaire: non
    puissance nécessaire équipement chauffage:
      formule: Calcul . Chauffage Puissance chauffage appelée
      unité: kW
    puissance nécessaire pour ECS avec équipement:
      formule: 0
      unité: kW
    puissance nécessaire pour refroidissement équipement:
      formule: Calcul . Climatisation Puissance refroidissement appelée / ratios . PAC AIR AIR SEER indiv
      unité: kW
    puissance équipement:
      le maximum de:
        - puissance nécessaire équipement chauffage
        - puissance nécessaire pour refroidissement équipement
      unité: kW
    gamme de puissance existante:
      # =(QUOTIENT(G57;'Ratios techniques'!$C$285)+1)*'Ratios techniques'!$C$285
      le maximum de:
        - puissance équipement
        - 2
      unité: kW
    besoin d'installation supplémentaire pour produire l'ECS:
      toutes ces conditions:
        - Production eau chaude sanitaire
        - puissance nécessaire pour ECS avec équipement <= 0
    volume du ballon ECS:
      variations:
        - si:
            toutes ces conditions:
              - besoin d'installation supplémentaire pour produire l'ECS
              - type de production ECS != "Solaire thermique"
          alors: volume du ballon ECS
        - sinon: 50
      unité: L
    consommation d'électricité chauffe-eau électrique:
      variations:
        - si:
            toutes ces conditions:
              - besoin d'installation supplémentaire pour produire l'ECS
              - type de production ECS != 'Solaire thermique'
          alors: chauffe-eau électrique x consommation d'électricité
        - sinon: 0
      unité: kWh/an
    appoint d'électricité chauffe-eau solaire:
      variations:
        - si:
            toutes ces conditions:
              - besoin d'installation supplémentaire pour produire l'ECS
              - type de production ECS = 'Solaire thermique'
          alors: chauffe-eau solaire x appoint d'électricité
        - sinon: 0
      unité: kWh/an
    consommation combustible chaleur:
      formule: besoins chauffage par appartement / ratios . PAC AIR AIR SCOP indiv
      unité: kWh elec
    consommation combustible froid:
      formule: besoins en climatisation par appartement / ratios . PAC AIR AIR SEER indiv
      unité: kWh elec
    consommation auxiliaire:
      valeur: 0
      unité: kWh elec
    consommation combustible hors électricité:
      valeur: 0
      unité: kWh elec
    consommation d'électricité lié au chauffage-refroidissement et à la production d'ECS:
      # =IF(C80="Non",F103+C103+D103,F103+H103+I103)
      variations:
        - si: besoin d'installation supplémentaire pour produire l'ECS
          alors: consommation auxiliaire + consommation d'électricité chauffe-eau électrique
        - sinon: consommation auxiliaire + consommation combustible chaleur + consommation combustible froid
      unité: kWh/an
PAC air-air coll . installation:
  avec:
    production eau chaude sanitaire: non
    puissance nécessaire équipement chauffage:
      formule: Calcul . Chauffage Puissance chauffage appelée * nombre de logements dans l'immeuble concerné * ratios . PUIS Coefficient de foisonnement chauffage collectif
      unité: kW
    puissance nécessaire pour ECS avec équipement:
      formule: 0
      unité: kW
    puissance nécessaire pour refroidissement équipement:
      formule: Calcul . Climatisation Puissance refroidissement appelée / ratios . PAC AIR AIR SEER coll * nombre de logements dans l'immeuble concerné * ratios . PUIS Coefficient de foisonnement chauffage collectif
      unité: kW
    puissance équipement:
      le maximum de:
        - puissance nécessaire équipement chauffage
        - puissance nécessaire pour refroidissement équipement
      unité: kW
    gamme de puissance existante:
      # H60 =(QUOTIENT(G60;'Ratios techniques'!C286)+1)*'Ratios techniques'!C286
      produit:
        - somme:
            - valeur: puissance équipement // ratios . PAC AIR AIR Puissance unitaire réversible coll
            - 1
        - ratios . PAC AIR AIR Puissance unitaire réversible coll
      unité: kW
    besoin d'installation supplémentaire pour produire l'ECS:
      toutes ces conditions:
        - Production eau chaude sanitaire
        - puissance nécessaire pour ECS avec équipement <= 0
    volume du ballon ECS:
      variations:
        - si:
            toutes ces conditions:
              - besoin d'installation supplémentaire pour produire l'ECS
              - type de production ECS != "Solaire thermique"
          alors: volume du ballon ECS
        - sinon: 50
      unité: L
    consommation d'électricité chauffe-eau électrique:
      variations:
        - si:
            toutes ces conditions:
              - besoin d'installation supplémentaire pour produire l'ECS
              - type de production ECS != 'Solaire thermique'
          alors: chauffe-eau électrique x consommation d'électricité
        - sinon: 0
      unité: kWh/an
    appoint d'électricité chauffe-eau solaire:
      variations:
        - si:
            toutes ces conditions:
              - besoin d'installation supplémentaire pour produire l'ECS
              - type de production ECS = 'Solaire thermique'
          alors: chauffe-eau solaire x appoint d'électricité
        - sinon: 0
      unité: kWh/an
    consommation combustible chaleur:
      formule: besoins chauffage par appartement / ratios . PAC AIR AIR SCOP coll
      unité: kWh elec
    consommation combustible froid:
      formule: besoins en climatisation par appartement / ratios . PAC AIR AIR SEER coll
      unité: kWh elec
    consommation auxiliaire:
      valeur: 0
      unité: kWh elec
    consommation combustible hors électricité:
      valeur: 0
      unité: kWh elec
    consommation d'électricité lié au chauffage-refroidissement et à la production d'ECS:
      variations:
        - si: besoin d'installation supplémentaire pour produire l'ECS
          alors: consommation auxiliaire + consommation d'électricité chauffe-eau électrique
        - sinon: consommation auxiliaire + consommation combustible chaleur + consommation combustible froid
      unité: kWh/an
###### Calculs économiques

PAC air-air indiv . coûts:
  avec:
    # P4 - Investissement total (sans aide) €TTC
    Investissement équipement Total:
      # ='Paramètres économiques'!$D$68*(1+surcout_inv)
      produit:
        - ratios économiques . PAC x air-air réversible x Individuel
        - ( 1 + ratios économiques . Investissement x Pose et mise en place de l'installation )
      unité: €TTC
    Investissement équipement par logement type tertiaire:
      valeur: Investissement équipement Total
      unité: €TTC
    Investissement ballon ECS à accumulation:
      variations:
        - si: PAC air-air indiv . installation . besoin d'installation supplémentaire pour produire l'ECS
          alors: Calcul Eco . Investissement ballon ECS à accumulation
        - sinon: 0
      unité: €TTC
    Investissement ballon ECS solaire panneau inclus:
      applicable si:
        toutes ces conditions:
          - PAC air-air indiv . installation . besoin d'installation supplémentaire pour produire l'ECS
          - type de production ECS = "Solaire thermique"
      formule: Calcul Eco . Investissement ballon ECS panneau inclus
      unité: €TTC
    Total investissement avec ballon ECS à accumulation:
      valeur: Investissement équipement par logement type tertiaire + Investissement ballon ECS à accumulation
      unité: €TTC
    Total investissement ballon ECS solaire panneaux:
      valeur: Investissement équipement par logement type tertiaire + Investissement ballon ECS solaire panneau inclus
      unité: €TTC

    # P1 - Coût du combustible par lgt type / tertiaire
    Coût du combustible abonnement:
      somme:
        - variations:
            - si:
                toutes ces conditions:
                  - Inclure la climatisation
                  - type de production de froid = 'Réseau de froid'
              alors: réseau de froid . coûts . Coût du combustible abonnement
            - sinon: 0
        - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part abonnement
      unité: €TTC/an
      note: 'Coût du combustible abonnement (P1 abo) €TTC/an'
    Coût du combustible consommation:
      # D56 =IF('Paramètres économiques'!$D$109="Option base";$D$11*'Calculs techniques'!C103;$D$11*'Paramètres économiques'!$D$116*'Calculs techniques'!C103+$F$11*'Paramètres économiques'!$D$117*'Calculs techniques'!C103)
      produit:
        - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
        - PAC air-air indiv . installation . consommation combustible chaleur
      unité: €TTC/an
      note: 'Coût du combustible consommation (P1 conso) €TTC/an'
    Coût électricité auxiliaire:
      produit:
        - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
        - PAC air-air indiv . installation . consommation auxiliaire
      unité: €TTC/an
      note: "Coût électricité auxiliaire (P1') €TTC/an"
    Coût combustible pour ballon ECS à accumulation:
      applicable si: PAC air-air indiv . installation . consommation d'électricité chauffe-eau électrique >= 0
      produit:
        - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
        - PAC air-air indiv . installation . consommation d'électricité chauffe-eau électrique
      unité: €TTC/an
      note: 'Coût combustible pour ballon ECS à accumulation (P1 ECS) €TTC/an'
    Coût combustible pour ballon ECS solaire:
      applicable si: PAC air-air indiv . installation . appoint d'électricité chauffe-eau solaire >= 0
      produit:
        - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
        - PAC air-air indiv . installation . appoint d'électricité chauffe-eau solaire
      unité: €TTC/an
      note: 'Coût combustible pour ballon ECS solaire (P1 ECS)€TTC/an'
    Coût combustible froid:
      produit:
        - Calcul Eco . Coût d'achat du combustible . Electricité coll x Part consommation
        - PAC air-air indiv . installation . consommation combustible froid
      unité: €TTC/an

PAC air-air coll . coûts:
  avec:
    # P4 - Investissement total (sans aide) €TTC
    Investissement équipement Total:
      produit:
        - ratios économiques . PAC x air-air réversible x Collectif
        - ( 1 + ratios économiques . Investissement x Pose et mise en place de l'installation )
      unité: €TTC
    Investissement équipement par logement type tertiaire:
      valeur: Investissement équipement Total / nombre de logements dans l'immeuble concerné
      unité: €TTC
    Investissement ballon ECS à accumulation:
      variations:
        - si: PAC air-air coll . installation . besoin d'installation supplémentaire pour produire l'ECS
          alors: Calcul Eco . Investissement ballon ECS à accumulation
        - sinon: 0
      unité: €TTC
    Investissement ballon ECS solaire panneau inclus:
      applicable si:
        toutes ces conditions:
          - PAC air-air coll . installation . besoin d'installation supplémentaire pour produire l'ECS
          - type de production ECS = "Solaire thermique"
      formule: Calcul Eco . Investissement ballon ECS panneau inclus
      unité: €TTC
    Total investissement avec ballon ECS à accumulation:
      valeur: Investissement équipement par logement type tertiaire + Investissement ballon ECS à accumulation
      unité: €TTC
    Total investissement ballon ECS solaire panneaux:
      valeur: Investissement équipement par logement type tertiaire + Investissement ballon ECS solaire panneau inclus
      unité: €TTC

    # P1 - Coût du combustible par lgt type / tertiaire
    Coût du combustible abonnement:
      somme:
        - variations:
            - si:
                toutes ces conditions:
                  - Inclure la climatisation
                  - type de production de froid = 'Réseau de froid'
              alors: réseau de froid . coûts . Coût du combustible abonnement
            - sinon: 0
        - Calcul Eco . Coût d'achat du combustible . Electricité coll x Part abonnement / nombre de logements dans l'immeuble concerné
      unité: €TTC/an
      note: 'Coût du combustible abonnement (P1 abo) €TTC/an'
    Coût du combustible consommation:
      produit:
        - Calcul Eco . Coût d'achat du combustible . Electricité coll x Part consommation
        - PAC air-air coll . installation . consommation combustible chaleur
      unité: €TTC/an
      note: 'Coût du combustible consommation (P1 conso) €TTC/an'
    Coût électricité auxiliaire:
      produit:
        - Calcul Eco . Coût d'achat du combustible . Electricité coll x Part consommation
        - PAC air-air coll . installation . consommation auxiliaire
      unité: €TTC/an
      note: "Coût électricité auxiliaire (P1') €TTC/an"
    Coût combustible pour ballon ECS à accumulation:
      applicable si: PAC air-air coll . installation . consommation d'électricité chauffe-eau électrique >= 0
      produit:
        - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
        - PAC air-air coll . installation . consommation d'électricité chauffe-eau électrique
      unité: €TTC/an
      note: 'Coût combustible pour ballon ECS à accumulation (P1 ECS) €TTC/an'
    Coût combustible pour ballon ECS solaire:
      applicable si: PAC air-air coll . installation . appoint d'électricité chauffe-eau solaire >= 0
      produit:
        - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
        - PAC air-air coll . installation . appoint d'électricité chauffe-eau solaire
      unité: €TTC/an
      note: 'Coût combustible pour ballon ECS solaire (P1 ECS)€TTC/an'
    Coût combustible froid:
      produit:
        - Calcul Eco . Coût d'achat du combustible . Electricité coll x Part consommation
        - PAC air-air coll . installation . consommation combustible froid
      unité: €TTC/an

###### Entretien P2 / P3

PAC air-air indiv . entretien:
  avec:
    petit entretien P2:
      valeur: Paramètres économiques . Petit entretien P2 . PAC air-air indiv
      unité: €TTC/an
    gros entretien P3:
      valeur: Paramètres économiques . Gros entretien P3 . PAC air-air indiv
      unité: €TTC/an
    petit entretien P2 par logement tertiaire: petit entretien P2
    gros entretien P3 par logement tertiaire: gros entretien P3

PAC air-air coll . entretien:
  avec:
    petit entretien P2:
      produit:
        - Paramètres économiques . Petit entretien P2 . PAC air-air coll
        - (besoins chauffage par appartement + besoins eau chaude sanitaire par appartement + besoins en climatisation par appartement)
        - nombre de logements dans l'immeuble concerné / 1000
      unité: €TTC/an
    gros entretien P3:
      produit:
        - Paramètres économiques . Gros entretien P3 . PAC air-air coll
        - PAC air-air coll . coûts . Investissement équipement Total
      unité: €TTC/an
    petit entretien P2 par logement tertiaire: petit entretien P2 / nombre de logements dans l'immeuble concerné
    gros entretien P3 par logement tertiaire: gros entretien P3 / nombre de logements dans l'immeuble concerné

###### Aides

PAC air-air indiv . aides:
  avec:
    Ma prime renov':
      applicable si:
        est défini: Ma prime renov'
      formule: Ma prime renov'
      unité: €
    Coup de pouce:
      applicable si:
        est défini: Coup de pouce
      formule: Coup de pouce
      unité: €
    CEE:
      formule: 0
      unité: €
    Total:
      variations:
        - si: Paramètres économiques . Aides . Éligibilité x Prise en compte des aides
          alors: Ma prime renov' + Coup de pouce + CEE
        - sinon: 0
      unité: €

PAC air-air coll . aides:
  avec:
    Ma prime renov':
      applicable si:
        est défini: Ma prime renov'
      formule: Ma prime renov'
      unité: €
    Coup de pouce:
      applicable si:
        est défini: Coup de pouce
      formule: Coup de pouce
      unité: €
    CEE:
      formule: 0
      unité: €
    Total:
      variations:
        - si: Paramètres économiques . Aides . Éligibilité x Prise en compte des aides
          alors: Ma prime renov' + Coup de pouce + CEE
        - sinon: 0
      unité: €

###### Émissions de CO2

PAC air-air indiv . environnement:
  avec:
    besoins de chauffage et ECS si même équipement:
      valeur: 0
      unité: kgCO2e
    Scope 1: besoins de chauffage et ECS si même équipement
    auxiliaires et combustible électrique:
      # =('Calculs techniques'!C103+'Calculs techniques'!F102)*'Ratios environnementaux'!$C$25+'Calculs techniques'!D103*'Ratios environnementaux'!$C$27
      somme:
        - (PAC air-air indiv . installation . consommation combustible chaleur + PAC air-air indiv . installation . consommation auxiliaire) * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
        - PAC air-air indiv . installation . consommation combustible froid * ratios environnementaux . Emission moy Parc électrique francais moyenne froid
      unité: kgCO2e
    ECS solaire thermique:
      formule: PAC air-air indiv . installation . appoint d'électricité chauffe-eau solaire * ratios environnementaux . Emission moy Parc électrique francais moyenne ECS
    ECS avec ballon électrique:
      formule: PAC air-air indiv . installation . consommation d'électricité chauffe-eau électrique * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
    Scope 2:
      somme:
        - auxiliaires et combustible électrique
        - ECS solaire thermique
        - ECS avec ballon électrique
    Scope 3:
      # ='Ratios environnementaux'!C46*B30/Durée_vie_PAC_AA
      formule: ratios environnementaux . CO2 INS PAC air-air indiv * PAC air-air indiv . installation . gamme de puissance existante / ratios . PAC AIR AIR Durée de vie indiv
    Total:
      somme:
        - Scope 1
        - Scope 2
        - Scope 3
      unité: kgCO2e/an

PAC air-air coll . environnement:
  avec:
    besoins de chauffage et ECS si même équipement:
      valeur: 0
      unité: kgCO2e
    Scope 1: besoins de chauffage et ECS si même équipement
    auxiliaires et combustible électrique:
      # =('Calculs techniques'!C106+'Calculs techniques'!F105)*'Ratios environnementaux'!$C$25+'Calculs techniques'!D106*'Ratios environnementaux'!$C$27
      somme:
        - (PAC air-air coll . installation . consommation combustible chaleur + PAC air-air coll . installation . consommation auxiliaire) * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
        - PAC air-air coll . installation . consommation combustible froid * ratios environnementaux . Emission moy Parc électrique francais moyenne froid
      unité: kgCO2e
    ECS solaire thermique:
      formule: PAC air-air coll . installation . appoint d'électricité chauffe-eau solaire * ratios environnementaux . Emission moy Parc électrique francais moyenne ECS
    ECS avec ballon électrique:
      formule: PAC air-air coll . installation . consommation d'électricité chauffe-eau électrique * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
    Scope 2:
      somme:
        - auxiliaires et combustible électrique
        - ECS solaire thermique
        - ECS avec ballon électrique
    Scope 3:
      # ='Ratios environnementaux'!C49*B33/Durée_vie_PAC_AA_Coll/Nb_lgt
      formule: ratios environnementaux . CO2 INS PAC air-air collectif-tertiaire * PAC air-air coll . installation . gamme de puissance existante / ratios . PAC AIR AIR Durée de vie coll / nombre de logements dans l'immeuble concerné
    Total:
      somme:
        - Scope 1
        - Scope 2
        - Scope 3
      unité: kgCO2e/an

###### Bilan annuel

PAC air-air indiv . bilan:
  avec:
    P1abo: PAC air-air indiv . coûts . Coût du combustible abonnement
    P1conso: PAC air-air indiv . coûts . Coût du combustible consommation
    P1prime: PAC air-air indiv . coûts . Coût électricité auxiliaire
    P1ECS:
      le maximum de:
        - PAC air-air indiv . coûts . Coût combustible pour ballon ECS à accumulation
        - PAC air-air indiv . coûts . Coût combustible pour ballon ECS solaire
    P1Consofroid: PAC air-air indiv . coûts . Coût combustible froid
    P2: PAC air-air indiv . entretien . petit entretien P2 par logement tertiaire
    P3: PAC air-air indiv . entretien . gros entretien P3 par logement tertiaire
    P4spec:
      formule: PAC air-air indiv . coûts . Investissement équipement par logement type tertiaire * amortissement . facteur PAC AIR AIR indiv

    P4ECS Ballon électrique:
      formule: PAC air-air indiv . coûts . Investissement ballon ECS à accumulation * amortissement . facteur CHAUF EAU ELEC

    P4ECS Solaire Thermique:
      variations:
        - si: type de production ECS = 'Solaire thermique'
          alors: PAC air-air indiv . coûts . Investissement ballon ECS solaire panneau inclus * amortissement . facteur CHAUF EAU SOLAIRE
        - sinon: 0

    P4:
      somme:
        - P4spec
        - P4ECS Ballon électrique
        - P4ECS Solaire Thermique
    aides spécifiques:
      formule: PAC air-air indiv . aides . Total * amortissement . facteur PAC AIR AIR indiv
    aides: aides spécifiques
    P4 moins aides:
      le maximum de:
        - P4 - aides
        - 0
    total sans aides:
      somme:
        - P1abo
        - P1conso
        - P1prime
        - P1ECS
        - P1Consofroid
        - P2
        - P3
        - P4
    total avec aides:
      somme:
        - total sans aides
        - (- aides)
    total sans installation:
      somme:
        - total sans aides
        - (- P4)

PAC air-air coll . bilan:
  avec:
    P1abo: PAC air-air coll . coûts . Coût du combustible abonnement
    P1conso: PAC air-air coll . coûts . Coût du combustible consommation
    P1prime: PAC air-air coll . coûts . Coût électricité auxiliaire
    P1ECS:
      le maximum de:
        - PAC air-air coll . coûts . Coût combustible pour ballon ECS à accumulation
        - PAC air-air coll . coûts . Coût combustible pour ballon ECS solaire
    P1Consofroid: PAC air-air coll . coûts . Coût combustible froid
    P2: PAC air-air coll . entretien . petit entretien P2 par logement tertiaire
    P3: PAC air-air coll . entretien . gros entretien P3 par logement tertiaire
    P4spec:
      formule: PAC air-air coll . coûts . Investissement équipement par logement type tertiaire * amortissement . facteur PAC AIR AIR coll

    P4ECS Ballon électrique:
      formule: PAC air-air coll . coûts . Investissement ballon ECS à accumulation * amortissement . facteur CHAUF EAU ELEC

    P4ECS Solaire Thermique:
      variations:
        - si: type de production ECS = 'Solaire thermique'
          alors: PAC air-air coll . coûts . Investissement ballon ECS solaire panneau inclus * amortissement . facteur CHAUF EAU SOLAIRE
        - sinon: 0

    P4:
      somme:
        - P4spec
        - P4ECS Ballon électrique
        - P4ECS Solaire Thermique
    aides spécifiques:
      formule: PAC air-air coll . aides . Total * amortissement . facteur PAC AIR AIR coll
    aides: aides spécifiques
    P4 moins aides:
      le maximum de:
        - P4 - aides
        - 0
    total sans aides:
      somme:
        - P1abo
        - P1conso
        - P1prime
        - P1ECS
        - P1Consofroid
        - P2
        - P3
        - P4
    total avec aides:
      somme:
        - total sans aides
        - (- aides)
