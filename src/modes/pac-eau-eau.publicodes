# PAC eau-eau / géothermie (indiv/coll)
# Regroupe ratios, dimensionnement, calculs économiques,
# aides, émissions et bilan pour ce mode de chauffage.

PAC eau-eau indiv:
  description: Pompe à chaleur eau-eau individuelle (géothermie, capteurs horizontaux)
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 453.3
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        SCOP capteurs horizontaux:
          somme:
            - 4
            - pac . température émetteurs delta
        durée de vie:
          valeur: 22
          unité: an
        gros entretien P3:
          par défaut: 134 * (1 + investissement . TVA gros entretien P3)
          unité: €TTC/MWh
        investissement équipement:
          produit:
            - PAC eau-eau indiv . ratios . coût équipement au kW
            - PAC eau-eau indiv . installation . puissance retenue
            - 1 + investissement . TVA
        petit entretien P2:
          par défaut: 199 * (1 + investissement . TVA petit entretien P2)
          unité: €TTC/MWh
        puissance unitaire:
          valeur: 8

        coût équipement au kW:
            valeur: 1818
            unité: €HT/kW
            note: 'ADEME Coûts EnR 2022 2020'
    annuité: &annuite-pac-eau-eau
      description: Annuité pour 1 € investi sur la durée de vie de l'équipement (fonction Excel PMT)
      variations:
        - si: amortissement . taux actualisation != 0
          alors: amortissement . taux actualisation * ((1 + amortissement . taux actualisation) ** ratios . durée de vie) / ((1 + amortissement . taux actualisation) ** ratios . durée de vie - 1)
        - sinon: 1 / ratios . durée de vie
    installation:
      avec:
        production eau chaude sanitaire: ecs . production
        puissance chauffage:
          formule: dimensionnement . puissance chauffage appelée
          unité: kW
        puissance ECS:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - ecs . type de production = 'Avec équipement chauffage'
              alors: dimensionnement . ratios . coefficient de foisonnement ECS * (dimensionnement . puissance ECS appelée / ratios . SCOP capteurs horizontaux)
            - sinon: 0
          unité: kW
        puissance équipement: &inst-puissance-equipement
          somme:
            - puissance chauffage
            - puissance ECS
          unité: kW
        puissance retenue: &inst-puissance-retenue
          produit:
            - somme:
                - valeur: puissance équipement // ratios . puissance unitaire
                - 1
            - ratios . puissance unitaire
          unité: kW

        ECS additionnelle nécessaire: &inst-ecs-additionnelle-necessaire
          toutes ces conditions:
            - ecs . production
            - puissance ECS <= 0
        volume du ballon ECS: &inst-volume-du-ballon-ecs
          variations:
            - si:
                toutes ces conditions:
                  - ECS additionnelle nécessaire
                  - ecs . type de production != "Solaire thermique"
              alors: ecs additionnelle . volume du ballon
            - sinon: 50
          unité: L
        consommation chauffe-eau électrique: &inst-consommation-chauffe-eau-electrique
          variations:
            - si:
                toutes ces conditions:
                  - ECS additionnelle nécessaire
                  - ecs . type de production != 'Solaire thermique'
              alors: ecs additionnelle . consommation chauffe-eau électrique
            - sinon: 0
          unité: kWh/an
        appoint chauffe-eau solaire: &inst-appoint-chauffe-eau-solaire
          variations:
            - si:
                toutes ces conditions:
                  - ECS additionnelle nécessaire
                  - ecs . type de production = 'Solaire thermique'
              alors: ecs additionnelle . appoint chauffe-eau solaire
            - sinon: 0
          unité: kWh/an
        consommation combustible chaleur:
          formule: (besoins . chauffage par logement + besoins . ECS par logement) / ratios . SCOP capteurs horizontaux
          unité: kWh elec
        consommation combustible froid: &inst-consommation-combustible-froid
          formule: 0
          unité: kWh elec
        consommation auxiliaire: &inst-consommation-auxiliaire
          somme:
            - (1 - pac . ratios . conso auxiliaire chauffage climatisation) * besoins . chauffage par logement
            - variations:
                - si:
                    toutes ces conditions:
                      - ecs . type de production = 'Avec équipement chauffage'
                      - ecs . production
                  alors: (1 - pac . ratios . conso auxiliaire ECS) * besoins . ECS par logement
                - sinon: 0
          unité: kWh elec
        consommation hors électricité: &inst-consommation-hors-electricite
          valeur: 0
          unité: kWh elec
        consommation électricité: &inst-consommation-electricite
          variations:
            - si: ECS additionnelle nécessaire
              alors: consommation auxiliaire + consommation chauffe-eau électrique
            - sinon: consommation auxiliaire + consommation combustible chaleur + consommation combustible froid
          unité: kWh/an
        consommation groupe froid: climatisation additionnelle . consommation groupe froid
    coûts:
      avec:
        investissement équipement:
          produit:
            - ratios . investissement équipement
            - ( 1 + investissement . pose et mise en place )
          unité: €TTC
        investissement par logement:
          valeur: investissement équipement
          unité: €TTC
        investissement ballon ECS: &couts-investissement-ballon-ecs
          variations:
            - si: installation . ECS additionnelle nécessaire
              alors: ecs additionnelle . investissement ballon ECS
            - sinon: 0
          unité: €TTC
        investissement chauffe-eau solaire: &couts-investissement-chauffe-eau-solaire
          applicable si:
            toutes ces conditions:
              - installation . ECS additionnelle nécessaire
              - ecs . type de production = "Solaire thermique"
          formule: ecs additionnelle . investissement chauffe-eau solaire
          unité: €TTC
        investissement total avec ballon ECS: &couts-investissement-total-avec-ballon-ecs
          valeur: investissement par logement + investissement ballon ECS
          unité: €TTC
        investissement total avec chauffe-eau solaire: &couts-investissement-total-avec-chauffe-eau-solaire
          valeur: investissement par logement + investissement chauffe-eau solaire
          unité: €TTC

        P1 abonnement:
          somme:
            - variations:
                - si:
                    toutes ces conditions:
                      - climatisation . incluse
                      - climatisation . type de production = 'Réseau de froid'
                  alors: réseau de froid . coûts . P1 abonnement
                - sinon: 0
            - combustibles . électricité . abonnement individuel
          unité: €TTC/an
        P1 consommation:
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation combustible chaleur
          unité: €TTC/an
        P1 auxiliaires:
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation auxiliaire
          unité: €TTC/an
        P1 ballon ECS: &couts-p1-ballon-ecs
          applicable si: installation . consommation chauffe-eau électrique >= 0
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation chauffe-eau électrique
          unité: €TTC/an
        P1 chauffe-eau solaire: &couts-p1-chauffe-eau-solaire
          applicable si: installation . appoint chauffe-eau solaire >= 0
          produit:
            - combustibles . électricité . consommation individuel
            - installation . appoint chauffe-eau solaire
          unité: €TTC/an
        P1 froid: &couts-p1-froid
          variations:
            - si:
                toutes ces conditions:
                  - climatisation . incluse
                  - climatisation . type de production = 'Réseau de froid'
              alors: réseau de froid . coûts . P1 froid
            - sinon:
                produit:
                  - combustibles . électricité . consommation collectif
                  - installation . consommation groupe froid
          unité: €TTC/an
        petit entretien P2:
            valeur : ratios . petit entretien P2
            unité: €TTC/an
        gros entretien P3:
            valeur : ratios . gros entretien P3
            unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2
        gros entretien P3 par logement tertiaire: gros entretien P3
    aides:
      avec:
        ma prime rénov:
          variations:
            - si:
                toutes ces conditions:
                  - aides . éligibilité . éligible ma prime rénov
                  - aides . éligibilité . ressources du ménage = "Très modeste"
              alors: 11000 €
            - si:
                toutes ces conditions:
                  - aides . éligibilité . éligible ma prime rénov
                  - aides . éligibilité . ressources du ménage = "Modeste"
              alors: 9000 €
            - si:
                toutes ces conditions:
                  - aides . éligibilité . éligible ma prime rénov
                  - aides . éligibilité . ressources du ménage = "Intermédiaire"
              alors: 6000 €
          unité: €
          note: "source : MaPrimeRénov' 2024 | Service-Public.fr"
        coup de pouce:
          variations:
            - si:
                toutes ces conditions:
                  - aides . éligibilité . éligible coup de pouce
                  - aides . éligibilité . ressources du ménage = 'Modeste'
              alors: 5000 €
            - si:
                toutes ces conditions:
                  - aides . éligibilité . éligible coup de pouce
                  - aides . éligibilité . ressources du ménage != 'Modeste'
              alors: 5000 €
          unité: €
          note: 'Montant minimal de la prime - Source : Prime "Coup de pouce chauffage" | Service-Public.fr'
        CEE:
          formule: 0
          unité: €
        total:
          variations:
            - si: aides . éligibilité . prise en compte des aides
              alors: ma prime rénov + coup de pouce + CEE
            - sinon: 0
          unité: €
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement: &env-besoins-de-chauffage-et-ecs-si-meme-equipement
          valeur: 0
          unité: kgCO2e
        scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique: &env-auxiliaires-et-combustible-electrique
          somme:
            - (installation . consommation combustible chaleur + installation . consommation auxiliaire) * facteurs CO2 . électricité chauffage
            - installation . consommation combustible froid * facteurs CO2 . électricité froid
          unité: kgCO2e
        ECS solaire thermique:
          formule: installation . appoint chauffe-eau solaire * facteurs CO2 . électricité ECS
        ECS avec ballon électrique:
          formule: installation . consommation chauffe-eau électrique * facteurs CO2 . électricité chauffage
        scope 2: &env-scope-2
          somme:
            - auxiliaires et combustible électrique
            - ECS solaire thermique
            - ECS avec ballon électrique
        scope 3:
          formule: ratios . CO2 installation * installation . puissance retenue / ratios . durée de vie
        total: &env-total
          somme:
            - scope 1
            - scope 2
            - scope 3
          unité: kgCO2e/an
    bilan:
      avec:
        P1abo: coûts . P1 abonnement
        P1conso: coûts . P1 consommation
        P1prime: coûts . P1 auxiliaires + climatisation additionnelle . surcoût P1 auxiliaires
        P1ECS: &bilan-p1ecs
          le maximum de:
            - coûts . P1 ballon ECS
            - coûts . P1 chauffe-eau solaire
        P1Consofroid: coûts . P1 froid
        P2: coûts . petit entretien P2 par logement tertiaire + climatisation additionnelle . surcoût P2
        P3: coûts . gros entretien P3 par logement tertiaire + climatisation additionnelle . surcoût P3
        P4 équipement:
          formule: coûts . investissement par logement * annuité

        P4 ballon ECS:
          formule: coûts . investissement ballon ECS * ecs additionnelle . annuité chauffe-eau électrique

        P4 chauffe-eau solaire: &bilan-p4-chauffe-eau-solaire
          variations:
            - si: ecs . type de production = 'Solaire thermique'
              alors: coûts . investissement chauffe-eau solaire * ecs additionnelle . annuité chauffe-eau solaire
            - sinon: 0

        P4: &bilan-p4
          somme:
            - P4 équipement
            - P4 ballon ECS
            - P4 chauffe-eau solaire
            - climatisation additionnelle . P4 groupe froid
            - climatisation additionnelle . P4 réseau de froid
        aides spécifiques:
          formule: aides . total * annuité

        aides:
          somme:
            - aides spécifiques
            - climatisation additionnelle . aides réseau de froid
        P4 moins aides: &bilan-p4-moins-aides
          le maximum de:
            - P4 - aides
            - 0
        total sans aides: &bilan-total-sans-aides
          somme:
            - P1abo
            - P1conso
            - P1prime
            - P1ECS
            - P1Consofroid
            - P2
            - P3
            - P4
        total avec aides: &bilan-total-avec-aides
          somme:
            - total sans aides
            - (- aides)
        total sans installation: &bilan-total-sans-installation
          somme:
            - total sans aides
            - (- P4)

PAC eau-eau coll:
  description: Pompe à chaleur eau-eau collective (géothermie, champ de sondes)
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        durée de vie puits géothermiques:
          valeur: 50
          unité: an
        CO2 installation:
          formule: 615
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        SCOP champ de sondes:
          somme:
            - 5
            - pac . température émetteurs delta
        durée de vie: PAC eau-eau indiv . ratios . durée de vie  # valeur partagée entre variantes
        gros entretien P3:
          par défaut: 1.72 / 100
          unité: €HT/€d'investissment
        petit entretien P2:
          par défaut: 9.8 *  (1 + investissement . TVA petit entretien P2)
          unité: €TTC/MWh
        puissance unitaire:
          valeur: 46.52

        coût au kW hors captage:
            valeur: 1323
            unité: €HT/kW
            note: 'ADEME Coûts EnR 2022 2020'

        coût au kW captage champ de sondes:
            valeur: 1377
            unité: €HT/kW
            note: 'ADEME Coûts EnR 2022 2020'

        investissement hors captage:
            produit:
              - PAC eau-eau coll . installation . puissance retenue
              - variations:
                  - si: PAC eau-eau coll . installation . puissance retenue < 250
                    alors: PAC eau-eau coll . ratios . coût au kW hors captage
                  - sinon: PAC eau-eau coll . ratios . coût au kW hors captage gamme 250
              - 1 + investissement . TVA

        investissement captage champ de sondes:
            produit:
              - PAC eau-eau coll . installation . puissance retenue
              - variations:
                  - si: PAC eau-eau coll . installation . puissance retenue < 250
                    alors: PAC eau-eau coll . ratios . coût au kW captage champ de sondes
                  - sinon: PAC eau-eau coll . ratios . coût au kW captage champ de sondes gamme 250
              - 1 + investissement . TVA

        investissement équipement:
            somme:
              - PAC eau-eau coll . ratios . investissement hors captage
              - PAC eau-eau coll . ratios . investissement captage champ de sondes
            note: 'Coût total, pendant collectif de PAC eau-eau indiv . ratios . investissement équipement — affiché par la page paramètres du front'

        coût au kW hors captage gamme 250:
          valeur: 504
          unité: €HT/kW
          note: 'ADEME Coûts EnR 2022 2020'

        coût au kW captage champ de sondes gamme 250:
          valeur: 1121
          unité: €HT/kW
          note: 'ADEME Coûts EnR 2022 2020'
    annuité: *annuite-pac-eau-eau
    annuité puits:
      description: Annuité pour 1 € investi sur la durée de vie des puits géothermiques (fonction Excel PMT)
      variations:
        - si: amortissement . taux actualisation != 0
          alors: amortissement . taux actualisation * ((1 + amortissement . taux actualisation) ** ratios . durée de vie puits géothermiques) / ((1 + amortissement . taux actualisation) ** ratios . durée de vie puits géothermiques - 1)
        - sinon: 1 / ratios . durée de vie puits géothermiques
    installation:
      avec:
        production eau chaude sanitaire: ecs . production
        puissance chauffage:
          formule: dimensionnement . puissance chauffage appelée * bâtiment . nombre de logements * dimensionnement . ratios . coefficient de foisonnement chauffage collectif
          unité: kW
        puissance ECS:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - ecs . type de production = 'Avec équipement chauffage'
              alors: dimensionnement . ratios . coefficient de foisonnement ECS * (dimensionnement . puissance ECS appelée / ratios . SCOP champ de sondes) * bâtiment . nombre de logements
            - sinon: 0
          unité: kW
        puissance équipement: *inst-puissance-equipement
        puissance retenue: *inst-puissance-retenue

        ECS additionnelle nécessaire: *inst-ecs-additionnelle-necessaire
        volume du ballon ECS: *inst-volume-du-ballon-ecs
        consommation chauffe-eau électrique: *inst-consommation-chauffe-eau-electrique
        appoint chauffe-eau solaire: *inst-appoint-chauffe-eau-solaire
        consommation combustible chaleur:
          produit:
            - somme:
                - besoins . chauffage par logement
                - variations:
                    - si: ecs . type de production = 'Avec équipement chauffage'
                      alors: besoins . ECS par logement
                    - sinon: 0
            - 1 / ratios . SCOP champ de sondes
          unité: kWh elec
        consommation combustible froid: *inst-consommation-combustible-froid
        consommation auxiliaire: *inst-consommation-auxiliaire
        consommation hors électricité: *inst-consommation-hors-electricite
        consommation électricité: *inst-consommation-electricite
        consommation groupe froid: climatisation additionnelle . consommation groupe froid
    coûts:
      avec:
        investissement forages:
          valeur: PAC eau-eau coll . ratios . investissement captage champ de sondes
          unité: €TTC
        investissement PAC:
          valeur: PAC eau-eau coll . ratios . investissement hors captage
          unité: €TTC
        investissement équipement:
          valeur: investissement forages + investissement PAC
          unité: €TTC
        investissement par logement forages:
          valeur: investissement forages / bâtiment . nombre de logements
        investissement par logement PAC:
          valeur: investissement PAC / bâtiment . nombre de logements
        investissement par logement:
          valeur: investissement équipement / bâtiment . nombre de logements
          unité: €TTC
        investissement ballon ECS: *couts-investissement-ballon-ecs
        investissement chauffe-eau solaire: *couts-investissement-chauffe-eau-solaire
        investissement total avec ballon ECS: *couts-investissement-total-avec-ballon-ecs
        investissement total avec chauffe-eau solaire: *couts-investissement-total-avec-chauffe-eau-solaire

        P1 abonnement:
          somme:
            - variations:
                - si:
                    toutes ces conditions:
                      - climatisation . incluse
                      - climatisation . type de production = 'Réseau de froid'
                  alors: réseau de froid . coûts . P1 abonnement
                - sinon: 0
            - combustibles . électricité . abonnement collectif / bâtiment . nombre de logements
          unité: €TTC/an
        P1 consommation:
          produit:
            - combustibles . électricité . consommation collectif
            - installation . consommation combustible chaleur
          unité: €TTC/an
        P1 auxiliaires:
          produit:
            - combustibles . électricité . consommation collectif
            - installation . consommation auxiliaire
          unité: €TTC/an
        P1 ballon ECS: *couts-p1-ballon-ecs
        P1 chauffe-eau solaire: *couts-p1-chauffe-eau-solaire
        P1 froid: *couts-p1-froid
        petit entretien P2:
            produit:
              - ratios . petit entretien P2
              - (besoins . chauffage par logement + besoins . ECS par logement + besoins . climatisation par logement)
              - bâtiment . nombre de logements / 1000
            unité: €TTC/an
        gros entretien P3:
            produit:
              - ratios . gros entretien P3
              - PAC eau-eau coll . ratios . investissement hors captage
            unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2 / bâtiment . nombre de logements
        gros entretien P3 par logement tertiaire: gros entretien P3 / bâtiment . nombre de logements
    aides:
      avec:
        ma prime rénov forage:
          variations:
            - si: aides . éligibilité . prise en compte des aides
              alors: 35 / 100 * coûts . investissement par logement forages
            - sinon: 0
        ma prime rénov PAC:
          variations:
            - si: aides . éligibilité . prise en compte des aides
              alors: 35 / 100 * coûts . investissement par logement PAC
            - sinon: 0
        ma prime rénov:
          somme:
            - ma prime rénov forage
            - ma prime rénov PAC
          unité: €
        coup de pouce forage:
          applicable si:
            est défini: coup de pouce
          formule: coup de pouce
          unité: €
        coup de pouce PAC:
          applicable si:
            est défini: coup de pouce
          formule: coup de pouce
          unité: €
        coup de pouce:
          somme:
            - coup de pouce forage
            - coup de pouce PAC
        CEE forage:
          formule: 0
          unité: €
        CEE PAC:
          formule: 0
          unité: €
        CEE:
          somme:
            - CEE forage
            - CEE PAC
        forage:
          somme:
            - ma prime rénov forage
            - coup de pouce forage
            - CEE forage
        PAC:
          somme:
            - ma prime rénov PAC
            - coup de pouce PAC
            - CEE PAC
        total:
          somme:
            - forage
            - PAC
          unité: €
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement: *env-besoins-de-chauffage-et-ecs-si-meme-equipement
        scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique: *env-auxiliaires-et-combustible-electrique
        ECS solaire thermique:
          formule: installation . appoint chauffe-eau solaire * facteurs CO2 . électricité ECS
        ECS avec ballon électrique:
          formule: installation . consommation chauffe-eau électrique * facteurs CO2 . électricité chauffage
        scope 2: *env-scope-2
        scope 3:
          formule: ratios . CO2 installation * installation . puissance retenue / ratios . durée de vie / bâtiment . nombre de logements
        total: *env-total
    bilan:
      avec:
        P1abo: coûts . P1 abonnement
        P1conso: coûts . P1 consommation
        P1prime: coûts . P1 auxiliaires + climatisation additionnelle . surcoût P1 auxiliaires
        P1ECS: *bilan-p1ecs
        P1Consofroid: coûts . P1 froid
        P2: coûts . petit entretien P2 par logement tertiaire + climatisation additionnelle . surcoût P2
        P3: coûts . gros entretien P3 par logement tertiaire + climatisation additionnelle . surcoût P3
        P4 forages:
          produit:
            - PAC eau-eau coll . ratios . investissement captage champ de sondes * annuité puits
            - 1 / bâtiment . nombre de logements
        P4 PAC:
          produit:
            - PAC eau-eau coll . ratios . investissement hors captage * annuité
            - 1 + investissement . pose et mise en place
            - 1 / bâtiment . nombre de logements
        P4 équipement:
          somme:
             - P4 forages
             - P4 PAC

        P4 ballon ECS:
          formule: coûts . investissement ballon ECS * ecs additionnelle . annuité chauffe-eau électrique

        P4 chauffe-eau solaire: *bilan-p4-chauffe-eau-solaire

        P4: *bilan-p4
        aides spécifiques PAC:
          formule: aides . PAC * annuité

        aides spécifiques forages:
          formule: aides . forage * annuité puits

        aides:
          somme:
            - aides spécifiques PAC
            - aides spécifiques forages
            - climatisation additionnelle . aides réseau de froid
        P4 moins aides: *bilan-p4-moins-aides
        total sans aides: *bilan-total-sans-aides
        total avec aides: *bilan-total-avec-aides
        total sans installation: *bilan-total-sans-installation

