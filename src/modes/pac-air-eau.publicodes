# PAC air-eau (indiv/coll)
# Regroupe ratios, dimensionnement, calculs économiques,
# aides, émissions et bilan pour ce mode de chauffage.

###### Ratios techniques

PAC air-eau indiv:
  description: Pompe à chaleur air-eau individuelle (réversible)
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 910
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        SCOP:
          somme:
            - 3.8
            - Température émetteurs delta
        SEER:
          valeur: 3.5
        durée de vie:
          valeur: 17
          unité: an
        gros entretien P3:
          par défaut: 134 * (1 + Paramètres économiques . Gros entretien P3 . TVA)
          unité: €TTC/MWh
        investissement équipement:
          produit:
            - ratios économiques . PAC x air-eau réversible . Coût investissement Individuel
            - 1 + investissement . TVA réduite
        petit entretien P2:
          par défaut: 199 * (1 + Paramètres économiques . Petit entretien P2 . TVA)
          unité: €TTC/MWh
        puissance unitaire réversible:
          valeur: 2.5
    facteur d'annuité: &facteur-annuite-pac-air-eau
      description: Annuité pour 1 € investi sur la durée de vie de l'équipement (fonction Excel PMT)
      variations:
        - si: amortissement . taux d'actualisation != 0
          alors: amortissement . taux d'actualisation * ((1 + amortissement . taux d'actualisation) ** ratios . durée de vie) / ((1 + amortissement . taux d'actualisation) ** ratios . durée de vie - 1)
        - sinon: 1 / ratios . durée de vie
    installation:
      avec:
        production eau chaude sanitaire: Production eau chaude sanitaire
        puissance chauffage:
          formule: dimensionnement . puissance chauffage appelée
          unité: kW
        puissance ECS:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - type de production ECS = 'Avec équipement chauffage'
              alors: ratios . PUIS Coefficient de foisonnement ECS * (dimensionnement . puissance ECS appelée / ratios . SCOP)
            - sinon: 0
          unité: kW
        puissance refroidissement:
          formule: dimensionnement . puissance refroidissement appelée / ratios . SEER
          unité: kW
        puissance équipement: &inst-puissance-equipement
          le maximum de:
            - somme:
                - puissance chauffage
                - puissance ECS
            - puissance refroidissement
          unité: kW
        puissance retenue: &inst-gamme-de-puissance-existante
          produit:
            - somme:
                - valeur: puissance équipement // ratios . puissance unitaire réversible
                - 1
            - ratios . puissance unitaire réversible
          unité: kW
        ECS additionnelle nécessaire: &inst-besoin-d-installation-supplementaire-pour-produire-l-ecs
          toutes ces conditions:
            - Production eau chaude sanitaire
            - puissance ECS <= 0
        volume du ballon ECS: &inst-volume-du-ballon-ecs
          variations:
            - si:
                toutes ces conditions:
                  - ECS additionnelle nécessaire
                  - type de production ECS != "Solaire thermique"
              alors: volume du ballon ECS
            - sinon: 50
          unité: L
        consommation chauffe-eau électrique: &inst-consommation-d-electricite-chauffe-eau-electrique
          variations:
            - si:
                toutes ces conditions:
                  - ECS additionnelle nécessaire
                  - type de production ECS != 'Solaire thermique'
              alors: ecs additionnelle . consommation chauffe-eau électrique
            - sinon: 0
          unité: kWh/an
        appoint chauffe-eau solaire: &inst-appoint-d-electricite-chauffe-eau-solaire
          variations:
            - si:
                toutes ces conditions:
                  - ECS additionnelle nécessaire
                  - type de production ECS = 'Solaire thermique'
              alors: ecs additionnelle . appoint chauffe-eau solaire
            - sinon: 0
          unité: kWh/an
        consommation combustible chaleur:
          formule: (besoins chauffage par appartement + besoins eau chaude sanitaire par appartement) / ratios . SCOP
          unité: kWh elec
        consommation combustible froid: &inst-consommation-combustible-froid
          formule: besoins en climatisation par appartement / ratios . SEER
          unité: kWh elec
        consommation auxiliaire: &inst-consommation-auxiliaire
          somme:
            - (1 - ratios . PAC GNRL Conso auxiliaire chauffage climatisation hors PAC air-air) * (besoins chauffage par appartement + besoins en climatisation par appartement)
            - variations:
                - si:
                    toutes ces conditions:
                      - type de production ECS = 'Avec équipement chauffage'
                      - Production eau chaude sanitaire
                  alors: (1 - ratios . PAC GNRL Conso auxiliaire ECS hors PAC air-air) * besoins eau chaude sanitaire par appartement
                - sinon: 0
          unité: kWh elec
        consommation hors électricité: &inst-consommation-combustible-hors-electricite
          valeur: 0
          unité: kWh elec
        consommation électricité: &inst-consommation-d-electricite-lie-au-chauffage-refroidissement-et-a-la-production-d-ecs
          variations:
            - si: ECS additionnelle nécessaire
              alors: consommation auxiliaire + consommation chauffe-eau électrique
            - sinon: consommation auxiliaire + consommation combustible chaleur + consommation combustible froid
          unité: kWh/an
    coûts:
      avec:
        investissement équipement:
          valeur: ratios . investissement équipement
          unité: €TTC
        investissement par logement:
          valeur: investissement équipement
          unité: €TTC
        investissement ballon ECS: &couts-investissement-ballon-ecs-a-accumulation
          variations:
            - si: installation . ECS additionnelle nécessaire
              alors: ecs additionnelle . investissement ballon ECS
            - sinon: 0
          unité: €TTC
        investissement chauffe-eau solaire: &couts-investissement-ballon-ecs-solaire-panneau-inclus
          applicable si:
            toutes ces conditions:
              - installation . ECS additionnelle nécessaire
              - type de production ECS = "Solaire thermique"
          formule: ecs additionnelle . investissement chauffe-eau solaire
          unité: €TTC
        investissement total avec ballon ECS: &couts-total-investissement-avec-ballon-ecs-a-accumulation
          valeur: investissement par logement + investissement ballon ECS
          unité: €TTC
        investissement total avec chauffe-eau solaire: &couts-total-investissement-ballon-ecs-solaire-panneaux
          valeur: investissement par logement + investissement chauffe-eau solaire
          unité: €TTC

        P1 abonnement:
          somme:
            - variations:
                - si:
                    toutes ces conditions:
                      - Inclure la climatisation
                      - type de production de froid = 'Réseau de froid'
                  alors: réseau de froid . coûts . P1 abonnement
                - sinon: 0
            - combustibles . électricité . abonnement individuel
          unité: €TTC/an
        P1 consommation:
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation combustible chaleur
          unité: €TTC/an
        P1 auxiliaires:
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation auxiliaire
          unité: €TTC/an) €TTC/an"
        P1 ballon ECS: &couts-cout-combustible-pour-ballon-ecs-a-accumulation
          applicable si: installation . consommation chauffe-eau électrique >= 0
          produit:
            - combustibles . électricité . consommation individuel
            - installation . consommation chauffe-eau électrique
          unité: €TTC/an
        P1 chauffe-eau solaire: &couts-cout-combustible-pour-ballon-ecs-solaire
          applicable si: installation . appoint chauffe-eau solaire >= 0
          produit:
            - combustibles . électricité . consommation individuel
            - installation . appoint chauffe-eau solaire
          unité: €TTC/an
        P1 froid: &couts-cout-combustible-froid
          produit:
            - combustibles . électricité . consommation collectif
            - installation . consommation combustible froid
          unité: €TTC/an
        petit entretien P2:
            valeur : ratios . petit entretien P2
            unité: €TTC/an
        gros entretien P3:
            valeur : ratios . gros entretien P3
            unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2
        gros entretien P3 par logement tertiaire: gros entretien P3
    aides:
      avec:
        Ma prime renov':
          variations:
            - si:
                toutes ces conditions:
                  - aides . éligibilité . éligible Ma prime renov'
                  - aides . éligibilité . ressources du ménage = "Très modeste"
              alors: 5000 €
            - si:
                toutes ces conditions:
                  - aides . éligibilité . éligible Ma prime renov'
                  - aides . éligibilité . ressources du ménage = "Modeste"
              alors: 4000 €
            - si:
                toutes ces conditions:
                  - aides . éligibilité . éligible Ma prime renov'
                  - aides . éligibilité . ressources du ménage = "Intermédiaire"
              alors: 3000 €
          unité: €
          note: "source : MaPrimeRénov' 2024 | Service-Public.fr"
        Coup de pouce:
          variations:
            - si: aides . éligibilité . éligible Coup de pouce
              alors: aides . Coup de pouce x PAC air-eau
            - sinon: 0 €
          unité: €
        CEE:
          variations:
            - si: aides . éligibilité . éligible CEE
              alors: aides . CEE x PAC air-eau indiv x BAR-TH-171 * aides . valeur CEE
            - sinon: 0 €
          unité: €
        Total: &aides-total
          variations:
            - si: aides . éligibilité . prise en compte des aides
              alors: Ma prime renov' + Coup de pouce + CEE
            - sinon: 0
          unité: €
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement: &env-besoins-de-chauffage-et-ecs-si-meme-equipement
          valeur: 0
          unité: kgCO2e
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique: &env-auxiliaires-et-combustible-electrique
          somme:
            - (installation . consommation combustible chaleur + installation . consommation auxiliaire) * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
            - installation . consommation combustible froid * ratios environnementaux . Emission moy Parc électrique francais moyenne froid
          unité: kgCO2e
        ECS solaire thermique:
          formule: installation . appoint chauffe-eau solaire * ratios environnementaux . Emission moy Parc électrique francais moyenne ECS
        ECS avec ballon électrique:
          formule: installation . consommation chauffe-eau électrique * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
        Scope 2: &env-scope-2
          somme:
            - auxiliaires et combustible électrique
            - ECS solaire thermique
            - ECS avec ballon électrique
        Scope 3:
          formule: ratios . CO2 installation * installation . puissance retenue / ratios . durée de vie
        Total: &env-total
          somme:
            - Scope 1
            - Scope 2
            - Scope 3
          unité: kgCO2e/an
    bilan:
      avec:
        P1abo: coûts . P1 abonnement
        P1conso: coûts . P1 consommation
        P1prime: coûts . P1 auxiliaires
        P1ECS: &bilan-p1ecs
          le maximum de:
            - coûts . P1 ballon ECS
            - coûts . P1 chauffe-eau solaire
        P1Consofroid: coûts . P1 froid
        P2: coûts . petit entretien P2 par logement tertiaire
        P3: coûts . gros entretien P3 par logement tertiaire
        P4 équipement:
          formule: coûts . investissement par logement * facteur d'annuité

        P4 ballon ECS:
          formule: coûts . investissement ballon ECS * ecs additionnelle . facteur d'annuité chauffe-eau électrique

        P4 chauffe-eau solaire: &bilan-p4ecs-solaire-thermique
          variations:
            - si: type de production ECS = 'Solaire thermique'
              alors: coûts . investissement chauffe-eau solaire * ecs additionnelle . facteur d'annuité chauffe-eau solaire
            - sinon: 0

        P4: &bilan-p4
          somme:
            - P4 équipement
            - P4 ballon ECS
            - P4 chauffe-eau solaire
        aides spécifiques:
          formule: aides . Total * facteur d'annuité
        aides: aides spécifiques
        P4 moins aides: &bilan-p4-moins-aides
          le maximum de:
            - P4 - aides
            - 0
        total sans aides: &bilan-total-sans-aides
          somme:
            - P1abo
            - P1conso
            - P1prime
            - P1ECS
            - P1Consofroid
            - P2
            - P3
            - P4
        total avec aides: &bilan-total-avec-aides
          somme:
            - total sans aides
            - (- aides)
        total sans installation: &bilan-total-sans-installation
          somme:
            - total sans aides
            - (- P4)
PAC air-eau coll:
  description: Pompe à chaleur air-eau collective (réversible)
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 302
          unité: kgCO2e/kW
          note: 'Source: INIES 2022'
        SCOP:
          somme:
            - 3.98
            - Température émetteurs delta
        SEER:
          valeur: 4.8
        durée de vie:
          valeur: 22
          unité: an
        investissement équipement:
          produit:
            - ratios économiques . PAC x air-eau réversible . Coût investissement Collectif
            - PAC air-eau coll . installation . puissance retenue
            - 1 + investissement . TVA
        petit entretien P2:
          par défaut: 9.8 *  (1 + Paramètres économiques . Petit entretien P2 . TVA)
          unité: €TTC/MWh
        puissance unitaire réversible: ratios . PAC AIR EAU Puissance unitaire réversible coll
    facteur d'annuité: *facteur-annuite-pac-air-eau
    installation:
      avec:
        production eau chaude sanitaire: Production eau chaude sanitaire
        puissance chauffage:
          formule: dimensionnement . puissance chauffage appelée * nombre de logements dans l'immeuble concerné * ratios . PUIS Coefficient de foisonnement chauffage collectif
          unité: kW
        puissance ECS:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - type de production ECS = 'Avec équipement chauffage'
              alors: ratios . PUIS Coefficient de foisonnement ECS * (dimensionnement . puissance ECS appelée / ratios . SCOP) * nombre de logements dans l'immeuble concerné
            - sinon: 0
          unité: kW
        puissance refroidissement:
          formule: dimensionnement . puissance refroidissement appelée / ratios . SEER * nombre de logements dans l'immeuble concerné * ratios . PUIS Coefficient de foisonnement chauffage collectif
          unité: kW
        puissance équipement: *inst-puissance-equipement
        puissance retenue: *inst-gamme-de-puissance-existante
        ECS additionnelle nécessaire: *inst-besoin-d-installation-supplementaire-pour-produire-l-ecs
        volume du ballon ECS: *inst-volume-du-ballon-ecs
        consommation chauffe-eau électrique: *inst-consommation-d-electricite-chauffe-eau-electrique
        appoint chauffe-eau solaire: *inst-appoint-d-electricite-chauffe-eau-solaire
        consommation combustible chaleur:
          produit:
            - somme:
                - besoins chauffage par appartement
                - variations:
                    - si: type de production ECS = 'Avec équipement chauffage'
                      alors: besoins eau chaude sanitaire par appartement
                    - sinon: 0
            - 1 / ratios . SCOP
          unité: kWh elec
        consommation combustible froid: *inst-consommation-combustible-froid
        consommation auxiliaire: *inst-consommation-auxiliaire
        consommation hors électricité: *inst-consommation-combustible-hors-electricite
        consommation électricité: *inst-consommation-d-electricite-lie-au-chauffage-refroidissement-et-a-la-production-d-ecs
    coûts:
      avec:
        investissement équipement:
          produit:
            - ratios . investissement équipement
            - ( 1 + investissement . pose et mise en place )
          unité: €TTC
        investissement par logement:
          valeur: investissement équipement / nombre de logements dans l'immeuble concerné
          unité: €TTC
        investissement ballon ECS: *couts-investissement-ballon-ecs-a-accumulation
        investissement chauffe-eau solaire: *couts-investissement-ballon-ecs-solaire-panneau-inclus
        investissement total avec ballon ECS: *couts-total-investissement-avec-ballon-ecs-a-accumulation
        investissement total avec chauffe-eau solaire: *couts-total-investissement-ballon-ecs-solaire-panneaux

        P1 abonnement:
          somme:
            - variations:
                - si:
                    toutes ces conditions:
                      - Inclure la climatisation
                      - type de production de froid = 'Réseau de froid'
                  alors: réseau de froid . coûts . P1 abonnement
                - sinon: 0
            - combustibles . électricité . abonnement collectif / nombre de logements dans l'immeuble concerné
          unité: €TTC/an
        P1 consommation:
          produit:
            - combustibles . électricité . consommation collectif
            - installation . consommation combustible chaleur
          unité: €TTC/an
        P1 auxiliaires:
          produit:
            - combustibles . électricité . consommation collectif
            - installation . consommation auxiliaire
          unité: €TTC/an) €TTC/an"
        P1 ballon ECS: *couts-cout-combustible-pour-ballon-ecs-a-accumulation
        P1 chauffe-eau solaire: *couts-cout-combustible-pour-ballon-ecs-solaire
        P1 froid: *couts-cout-combustible-froid
        petit entretien P2:
            produit:
              - ratios . petit entretien P2
              - (besoins chauffage par appartement + besoins eau chaude sanitaire par appartement + besoins en climatisation par appartement)
              - nombre de logements dans l'immeuble concerné / 1000
            unité: €TTC/an
        gros entretien P3:
            produit:
              - PAC air-air coll . ratios . gros entretien P3
              - coûts . investissement équipement
            unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2 / nombre de logements dans l'immeuble concerné
        gros entretien P3 par logement tertiaire: gros entretien P3 / nombre de logements dans l'immeuble concerné
    aides:
      avec:
        Ma prime renov':
          variations:
            - si: aides . éligibilité . prise en compte des aides
              alors: 35 / 100 * coûts . investissement par logement
            - sinon: 0
          unité: €
        Coup de pouce:
          applicable si:
            est défini: Coup de pouce
          formule: Coup de pouce
          unité: €
        CEE:
          formule: 0
          unité: €
        Total: *aides-total
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement: *env-besoins-de-chauffage-et-ecs-si-meme-equipement
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique: *env-auxiliaires-et-combustible-electrique
        ECS solaire thermique:
          formule: installation . appoint chauffe-eau solaire * ratios environnementaux . Emission moy Parc électrique francais moyenne ECS
        ECS avec ballon électrique:
          formule: installation . consommation chauffe-eau électrique * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
        Scope 2: *env-scope-2
        Scope 3:
          formule: ratios . CO2 installation * installation . puissance retenue / ratios . durée de vie / nombre de logements dans l'immeuble concerné
        Total: *env-total
    bilan:
      avec:
        P1abo: coûts . P1 abonnement
        P1conso: coûts . P1 consommation
        P1prime: coûts . P1 auxiliaires
        P1ECS: *bilan-p1ecs
        P1Consofroid: coûts . P1 froid
        P2: coûts . petit entretien P2 par logement tertiaire
        P3: coûts . gros entretien P3 par logement tertiaire
        P4 équipement:
          formule: coûts . investissement par logement * facteur d'annuité

        P4 ballon ECS:
          formule: coûts . investissement ballon ECS * ecs additionnelle . facteur d'annuité chauffe-eau électrique

        P4 chauffe-eau solaire: *bilan-p4ecs-solaire-thermique

        P4: *bilan-p4
        aides spécifiques:
          formule: aides . Total * facteur d'annuité
        aides: aides spécifiques
        P4 moins aides: *bilan-p4-moins-aides
        total sans aides: *bilan-total-sans-aides
        total avec aides: *bilan-total-avec-aides
        total sans installation: *bilan-total-sans-installation

ratios . PAC AIR EAU Puissance unitaire réversible coll:
  valeur: 20

###### Ratios économiques (investissement)

ratios économiques . PAC x air-eau réversible:
  avec:
    Coût investissement Individuel:
      valeur: 13270
      unité: €HT
      note: 'Source: SDES 2023'
    Coût investissement Collectif:
      valeur: 1005
      unité: €HT/kW
      note: 'Source: ELCIMAI 2024'

