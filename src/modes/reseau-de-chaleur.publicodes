# Réseau de chaleur urbain (RCU)
# Regroupe ratios, dimensionnement, calculs économiques,
# aides, émissions et bilan pour ce mode de chauffage.

###### Ratios techniques

réseau de chaleur:
  description: Raccordement à un réseau de chaleur urbain
  avec:
    ratios:
      description: Paramétrage du mode — valeurs de référence (les clés historiques de compat.publicodes pointent ici)
      avec:
        CO2 installation:
          formule: 0.004
          unité: kgCO2e/kWh
        durée avant renouvellement:
          valeur: 30
          unité: an
          note : durée d'amortissement du raccordement de la sous-station au bâtiment
        durée sous station:
          valeur: 22
          unité: an
        conso auxiliaire ECS:
          valeur: 99%
          unité: '%'
        conso auxiliaire chauffage:
          valeur: 99.8%
          unité: '%'
        gros entretien P3:
          par défaut: 0.75 / 100
          unité: €HT/€d'investissment # %
        petit entretien P2:
          par défaut: 1.5 / 100
          unité: €HT/€d'investissment
        rendement sous station ECS:
          valeur: 93%
          unité: '%'
        rendement sous station chauffage:
          valeur: 86%
          unité: '%'
    facteur d'annuité raccordement:
      description: Annuité pour 1 € investi sur la durée de renouvellement du raccordement (fonction Excel PMT)
      variations:
        - si: ratios économiques . Amortissement x Taux actualisation != 0
          alors: ratios économiques . Amortissement x Taux actualisation * ((1 + ratios économiques . Amortissement x Taux actualisation) ** ratios . durée avant renouvellement) / ((1 + ratios économiques . Amortissement x Taux actualisation) ** ratios . durée avant renouvellement - 1)
        - sinon: 1 / ratios . durée avant renouvellement
    facteur d'annuité sous station:
      description: Annuité pour 1 € investi sur la durée de vie de la sous-station (fonction Excel PMT)
      variations:
        - si: ratios économiques . Amortissement x Taux actualisation != 0
          alors: ratios économiques . Amortissement x Taux actualisation * ((1 + ratios économiques . Amortissement x Taux actualisation) ** ratios . durée sous station) / ((1 + ratios économiques . Amortissement x Taux actualisation) ** ratios . durée sous station - 1)
        - sinon: 1 / ratios . durée sous station
    installation:
      avec:
        production eau chaude sanitaire: Production eau chaude sanitaire
        puissance nécessaire équipement chauffage:
          formule: (Calcul . Chauffage Puissance chauffage appelée / ratios . rendement sous station chauffage) * nombre de logements dans l'immeuble concerné * ratios . PUIS Coefficient de foisonnement chauffage collectif
          unité: kW
        puissance nécessaire pour ECS avec équipement:
          variations:
            - si:
                toutes ces conditions:
                  - production eau chaude sanitaire
                  - type de production ECS = 'Avec équipement chauffage'
              alors: ratios . PUIS Coefficient de foisonnement ECS * (Calcul . ECS Puissance ECS appelée / ratios . rendement sous station ECS) * nombre de logements dans l'immeuble concerné
            - sinon: 0
          unité: kW
        puissance équipement:
          somme:
            - puissance nécessaire équipement chauffage
            - puissance nécessaire pour ECS avec équipement
          unité: kW
        gamme de puissance existante:
          formule: puissance équipement
          unité: kW
        besoin d'installation supplémentaire pour produire l'ECS:
          # valeur commune à tous les types d'installations
          toutes ces conditions:
            - Production eau chaude sanitaire
            - puissance nécessaire pour ECS avec équipement <= 0
        volume du ballon ECS:
          variations:
            - si:
                toutes ces conditions:
                  - besoin d'installation supplémentaire pour produire l'ECS
                  - type de production ECS != "Solaire thermique"
              alors: volume du ballon ECS
            - sinon: 50
          unité: L
        consommation d'électricité chauffe-eau électrique:
          # valeur commune à tous les types d'installations
          variations:
            - si:
                toutes ces conditions:
                  - besoin d'installation supplémentaire pour produire l'ECS
                  - type de production ECS != 'Solaire thermique'
              alors: chauffe-eau électrique x consommation d'électricité
            - sinon: 0
          unité: kWh/an
        appoint d'électricité chauffe-eau solaire:
          # valeur commune à tous les types d'installations
          variations:
            - si:
                toutes ces conditions:
                  - besoin d'installation supplémentaire pour produire l'ECS
                  - type de production ECS = 'Solaire thermique'
              alors: chauffe-eau solaire x appoint d'électricité
            - sinon: 0
          unité: kWh/an
        consommation combustible chaleur:
          somme:
            - besoins chauffage par appartement / ratios . rendement sous station chauffage
            - variations:
                - si:
                    toutes ces conditions:
                      - type de production ECS = 'Avec équipement chauffage'
                      - Production eau chaude sanitaire
                  alors: besoins eau chaude sanitaire par appartement / ratios . rendement sous station ECS
                - sinon: 0
          unité: kWh
        consommation combustible froid:
          formule: 0
          unité: kWh
        consommation auxiliaire:
          somme:
            - (1 - ratios . conso auxiliaire chauffage) * besoins chauffage par appartement
            - variations:
                - si:
                    toutes ces conditions:
                      - type de production ECS = 'Avec équipement chauffage'
                      - Production eau chaude sanitaire
                  alors: (1 - ratios . conso auxiliaire ECS) * besoins eau chaude sanitaire par appartement
                - sinon: 0
          unité: kWh elec
        consommation combustible hors électricité:
          formule: consommation combustible chaleur
        consommation d'électricité lié au chauffage-refroidissement et à la production d'ECS:
          variations:
            - si: besoin d'installation supplémentaire pour produire l'ECS
              alors: consommation auxiliaire + consommation d'électricité chauffe-eau électrique + chauffe-eau solaire x appoint d'électricité
            - sinon: consommation auxiliaire
          unité: kWh/an
        consommation Groupe Froid: calcul consommation Groupe Froid
    coûts:
      avec:
        Investissement raccordement:
          valeur: Investissement x frais de raccordement au réseaux x RCU
          unité: €TTC
        Investissement raccordement par logement type tertiaire:
          valeur: Investissement raccordement / nombre de logements dans l'immeuble concerné
          unité: €TTC
        Investissement reseau secondaire RCU:
          produit:
            - ratios économiques . Réseaux x Coût Investissement SST RCU
            - 1 + ratios économiques . Investissement x TVA
        Investissement reseau secondaire RCU par logement type tertiaire:
          valeur: Investissement reseau secondaire RCU / nombre de logements dans l'immeuble concerné
          unité: €TTC
        Investissement équipement Total:
          valeur: Investissement raccordement + Investissement reseau secondaire RCU
        Investissement équipement par logement type tertiaire:
          valeur : Investissement raccordement par logement type tertiaire + Investissement reseau secondaire RCU par logement type tertiaire
          unité: €TTC
        Investissement ballon ECS à accumulation:
          variations:
            - si: installation . besoin d'installation supplémentaire pour produire l'ECS
              alors: Calcul Eco . Investissement ballon ECS à accumulation
            - sinon: 0
          unité: €TTC
        Investissement ballon ECS solaire panneau inclus:
          applicable si:
            toutes ces conditions:
              - installation . besoin d'installation supplémentaire pour produire l'ECS
              - type de production ECS = "Solaire thermique"
          formule: Calcul Eco . Investissement ballon ECS panneau inclus
          unité: €TTC
        Total investissement avec ballon ECS à accumulation:
          valeur: Investissement raccordement par logement type tertiaire + Investissement ballon ECS à accumulation
          unité: €TTC
        Total investissement ballon ECS solaire panneaux:
          valeur: Investissement raccordement par logement type tertiaire + Investissement ballon ECS solaire panneau inclus
          unité: €TTC

        Coût du combustible abonnement:
          somme:
            - variations:
                - si:
                    toutes ces conditions:
                      - Inclure la climatisation
                      - type de production de froid = 'Réseau de froid'
                  alors: réseau de froid . coûts . Coût du combustible abonnement
                - sinon: 0
            - produit:
                - Calcul Eco . Coût d'achat du combustible . Chaleur RCU x Part abonnement
                - installation . consommation combustible chaleur
          unité: €TTC/an
          note: 'Coût du combustible abonnement (P1 abo) €TTC/an'
        Coût du combustible consommation:
          produit:
            - Calcul Eco . Coût d'achat du combustible . Chaleur RCU x Part consommation
            - installation . consommation combustible chaleur
          unité: €TTC/an
          note: 'Coût du combustible consommation (P1 conso) €TTC/an'
        Coût électricité auxiliaire:
          produit:
            - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
            - installation . consommation auxiliaire
          unité: €TTC/an
          note: "Coût électricité auxiliaire (P1') €TTC/an"
        Coût combustible pour ballon ECS à accumulation:
          applicable si: installation . consommation d'électricité chauffe-eau électrique >= 0
          produit:
            - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
            - installation . consommation d'électricité chauffe-eau électrique
          unité: €TTC/an
          note: 'Coût combustible pour ballon ECS à accumulation (P1 ECS) €TTC/an'
        Coût combustible pour ballon ECS solaire:
          applicable si: installation . appoint d'électricité chauffe-eau solaire >= 0
          produit:
            - Calcul Eco . Coût d'achat du combustible . Electricité indiv x Part consommation
            - installation . appoint d'électricité chauffe-eau solaire
          unité: €TTC/an
          note: 'Coût combustible pour ballon ECS solaire (P1 ECS)€TTC/an'
        Coût combustible froid:
          variations:
            - si:
                toutes ces conditions:
                  - Inclure la climatisation
                  - type de production de froid = 'Réseau de froid'
              alors: réseau de froid . coûts . Coût combustible froid
            - sinon:
                produit:
                  - Calcul Eco . Coût d'achat du combustible . Electricité coll x Part consommation
                  - installation . consommation Groupe Froid
          unité: €TTC/an
    entretien:
      avec:
        petit entretien P2:
            produit:
              - ratios . petit entretien P2
              - (1 + Paramètres économiques . Petit entretien P2 . TVA)
              - ratios économiques . Réseaux x Coût Investissement SST RCU
            unité: €TTC/an
        gros entretien P3:
            produit:
              - ratios . gros entretien P3
              - (1 + Paramètres économiques . Gros entretien P3 . TVA)
              - ratios économiques . Réseaux x Coût Investissement SST RCU
            unité: €TTC/an
        petit entretien P2 par logement tertiaire: petit entretien P2 / nombre de logements dans l'immeuble concerné
        gros entretien P3 par logement tertiaire: gros entretien P3 / nombre de logements dans l'immeuble concerné
    aides:
      avec:
        Ma prime renov':
          variations:
            - si:
                toutes ces conditions:
                  - Paramètres économiques . Aides . Aides x Éligible Ma prime renov'
                  - Paramètres économiques . Aides . Éligibilité x Ressources du ménage = "Très modeste"
              alors: 1200 €
            - si:
                toutes ces conditions:
                  - Paramètres économiques . Aides . Aides x Éligible Ma prime renov'
                  - Paramètres économiques . Aides . Éligibilité x Ressources du ménage = "Modeste"
              alors: 800 €
            - si:
                toutes ces conditions:
                  - Paramètres économiques . Aides . Aides x Éligible Ma prime renov'
                  - Paramètres économiques . Aides . Éligibilité x Ressources du ménage = "Intermédiaire"
              alors: 400 €
          unité: €
          note: "source : MaPrimeRénov' 2024 | Service-Public.fr"
        Coup de pouce:
          variations:
            - si:
                toutes ces conditions:
                  - Paramètres économiques . Aides . Aides x Éligible Coup de pouce chauffage
                  - Paramètres économiques . Aides . Éligibilité x Ressources du ménage = 'Modeste'
              alors: 700 €
            - si:
                toutes ces conditions:
                  - Paramètres économiques . Aides . Aides x Éligible Coup de pouce chauffage
                  - Paramètres économiques . Aides . Éligibilité x Ressources du ménage != 'Modeste'
              alors: 450 €
          unité: €
          note: 'Montant minimal de la prime - Source : Prime "Coup de pouce chauffage" | Service-Public.fr'
        CEE:
          produit:
            - variations:
                - si: type de bâtiment = 'résidentiel'
                  alors:
                    variations:
                      - si: nombre de logements dans l'immeuble concerné <= 125
                        alors: ratios économiques x aides . CEE x FCU x Résidentiel inf 125 appt
                      - sinon: ratios économiques x aides . CEE x FCU x Résidentiel sup 125 variable * nombre de logements dans l'immeuble concerné + ratios économiques x aides . CEE x FCU x Résidentiel sup 125 fixe
                - sinon:
                    variations:
                      - si: surface logement type tertiaire <= 7500
                        alors: ratios économiques x aides . CEE x FCU x Tertiaire inf 7500 appt
                      - sinon: ratios économiques x aides . CEE x FCU x Tertiaire sup 7500 variable * surface logement type tertiaire + ratios économiques x aides . CEE x FCU x Tertiaire sup 7500 fixe
            - Paramètres économiques . Aides . Valeur CEE
            - ratios économiques x aides . CEE x RCU x facteur correctif
            - 1 / nombre de logements dans l'immeuble concerné
          unité: €
        Total:
          variations:
            - si: Paramètres économiques . Aides . Éligibilité x Prise en compte des aides
              alors: Ma prime renov' + Coup de pouce + CEE
            - sinon: 0
          unité: €
    aides cumac:
      avec:
        Coup de pouce:
          produit:
            - variations:
              - si: type de bâtiment = 'résidentiel'
                alors:
                  variations:
                    - si: nombre de logements dans l'immeuble concerné <= 125
                      alors: 24000 * nombre de logements dans l'immeuble concerné + 9000000
                    - sinon: 54000 * nombre de logements dans l'immeuble concerné + 5200000
              - si: type de bâtiment = 'tertiaire'
                alors:
                  variations:
                    - si: surface logement type tertiaire <= 7500
                      alors: 200 * surface logement type tertiaire + 9500000
                    - sinon: 800 * surface logement type tertiaire + 5000000
              - sinon: 0
          unité: kWh cumac
          note: https://www.ecologie.gouv.fr/politiques-publiques/coup-pouce-chauffage-batiments-residentiels-collectifs-tertiaires
        CEE:
          produit:
            - variations:
              - si: type de bâtiment = 'résidentiel'
                alors: BAR-TH-137
              - si: type de bâtiment = 'tertiaire'
                alors: BAT-TH-127
          unité: kWh cumac
        BAR-TH-137:
          produit:
            - variations:
                - si: zone climatique = 'H1'
                  alors: 47700
                - si: zone climatique = 'H2'
                  alors: 39500
                - si: zone climatique = 'H3'
                  alors: 30800
            - nombre de logements dans l'immeuble concerné
          note: https://www.ecologie.gouv.fr/sites/default/files/documents/BAR-TH-137%20vA79-4%20%C3%A0%20compter%20du%2001-01-2026.pdf
        BAT-TH-127:
          produit:
            - variations:
                - si: installation . puissance équipement <= 400
                  alors:
                    variations:
                      - si:
                          toutes ces conditions:
                            - méthode tertiaire 2026 = 'Bureaux'
                            - Production eau chaude sanitaire
                        alors: 510
                      - si: méthode tertiaire 2026 = 'Bureaux'
                        alors: 480
                      - si:
                          toutes ces conditions:
                            - méthode tertiaire 2026 = 'Enseignement'
                            - Production eau chaude sanitaire
                        alors: 360
                      - si: méthode tertiaire 2026 = 'Enseignement'
                        alors: 310
                      - si:
                          toutes ces conditions:
                            - méthode tertiaire 2026 = 'Santé'
                            - Production eau chaude sanitaire
                        alors: 540
                      - si: méthode tertiaire 2026 = 'Santé'
                        alors: 400
                      - si:
                          toutes ces conditions:
                            - méthode tertiaire 2026 = 'Commerces'
                            - Production eau chaude sanitaire
                        alors: 420
                      - si: méthode tertiaire 2026 = 'Commerces'
                        alors: 370
                      - si:
                          toutes ces conditions:
                            - méthode tertiaire 2026 = 'Hôtellerie/Restauration'
                            - Production eau chaude sanitaire
                        alors: 680
                      - si: méthode tertiaire 2026 = 'Hôtellerie/Restauration'
                        alors: 540
                      - si:
                          toutes ces conditions:
                            - méthode tertiaire 2026 = 'Autres'
                            - Production eau chaude sanitaire
                        alors: 330
                      - si: méthode tertiaire 2026 = 'Autres'
                        alors: 310
                - sinon:
                    variations:
                      - si:
                          toutes ces conditions:
                            - méthode tertiaire 2026 = 'Bureaux'
                            - Production eau chaude sanitaire
                        alors: 390
                      - si: méthode tertiaire 2026 = 'Bureaux'
                        alors: 370
                      - si:
                          toutes ces conditions:
                            - méthode tertiaire 2026 = 'Enseignement'
                            - Production eau chaude sanitaire
                        alors: 270
                      - si: méthode tertiaire 2026 = 'Enseignement'
                        alors: 240
                      - si:
                          toutes ces conditions:
                            - méthode tertiaire 2026 = 'Santé'
                            - Production eau chaude sanitaire
                        alors: 410
                      - si: méthode tertiaire 2026 = 'Santé'
                        alors: 310
                      - si:
                          toutes ces conditions:
                            - méthode tertiaire 2026 = 'Commerces'
                            - Production eau chaude sanitaire
                        alors: 320
                      - si: méthode tertiaire 2026 = 'Commerces'
                        alors: 280
                      - si:
                          toutes ces conditions:
                            - méthode tertiaire 2026 = 'Hôtellerie/Restauration'
                            - Production eau chaude sanitaire
                        alors: 520
                      - si: méthode tertiaire 2026 = 'Hôtellerie/Restauration'
                        alors: 410
                      - si:
                          toutes ces conditions:
                            - méthode tertiaire 2026 = 'Autres'
                            - Production eau chaude sanitaire
                        alors: 260
                      - si: méthode tertiaire 2026 = 'Autres'
                        alors: 240
            - variations:
                - si: zone climatique = 'H1'
                  alors: 1.1
                - si: zone climatique = 'H2'
                  alors: 0.9
                - si: zone climatique = 'H3'
                  alors: 0.6
            - surface logement type tertiaire
          note: https://www.ecologie.gouv.fr/sites/default/files/documents/BAT-TH-127%20vA79-5%20%C3%A0%20compter%20du%2001-01-2026_0.pdf
        Total:
          variations:
            - si: Paramètres économiques . Aides . Éligibilité x Prise en compte des aides
              alors:
                variations:
                  - si: caractéristique réseau de chaleur . taux EnRR > 50 %
                    alors: Coup de pouce
                  - sinon: CEE
            - sinon: 0
          unité: kWh cumac
        Total montant:
          produit:
            - Total
            - Paramètres économiques . Aides . Valeur CEE
          unité: €
    environnement:
      avec:
        besoins de chauffage et ECS si même équipement:
          valeur: 0
          unité: kgCO2e
        Scope 1: besoins de chauffage et ECS si même équipement
        auxiliaires et combustible électrique:
          formule:
            variations:
              - si: Production eau chaude sanitaire
                alors: contenu CO2 réseau de chaleur * (besoins chauffage par appartement + besoins eau chaude sanitaire par appartement)
              - sinon: contenu CO2 réseau de chaleur * besoins chauffage par appartement
          unité: kgCO2e
        ECS solaire thermique:
          formule: installation . appoint d'électricité chauffe-eau solaire * ratios environnementaux . Emission moy Parc électrique francais moyenne ECS
        ECS avec ballon électrique:
          formule: installation . consommation d'électricité chauffe-eau électrique * ratios environnementaux . Emission moy Parc électrique francais moyenne chauffage
        Scope 2:
          somme:
            - auxiliaires et combustible électrique
            - ECS solaire thermique
            - ECS avec ballon électrique
        Scope 3:
          # QUESTION déjà posée: ça s'appelle vraiment Scope 3 ?
          variations:
            - si: Production eau chaude sanitaire
              alors: ratios . CO2 installation * (besoins chauffage par appartement + besoins eau chaude sanitaire par appartement)
            - sinon: ratios . CO2 installation * besoins chauffage par appartement
        Total:
          somme:
            - Scope 1
            - Scope 2
            - Scope 3
          unité: kgCO2e/an
    bilan:
      avec:
        P1abo: coûts . Coût du combustible abonnement
        P1conso: coûts . Coût du combustible consommation
        P1prime: coûts . Coût électricité auxiliaire + Calcul Bilan . Surcout Réseau de froid P1prime
        P1ECS:
          le maximum de:
            - coûts . Coût combustible pour ballon ECS à accumulation
            - coûts . Coût combustible pour ballon ECS solaire
        P1Consofroid: coûts . Coût combustible froid
        P2: entretien . petit entretien P2 par logement tertiaire + Calcul Bilan . Surcout Réseau de froid P2
        P3: entretien . gros entretien P3 par logement tertiaire + Calcul Bilan . Surcout Réseau de froid P3

        P4 raccordement:
          formule: coûts . Investissement raccordement par logement type tertiaire * facteur d'annuité raccordement

        P4 reseau secondaire:
          formule: coûts . Investissement reseau secondaire RCU par logement type tertiaire * facteur d'annuité sous station

        P4ECS Ballon électrique:
          formule: coûts . Investissement ballon ECS à accumulation * facteur d'annuité chauffe-eau électrique

        P4ECS Solaire Thermique:
          variations:
            - si: type de production ECS = 'Solaire thermique'
              alors: coûts . Investissement ballon ECS solaire panneau inclus * facteur d'annuité chauffe-eau solaire
            - sinon: 0
        P4:
          somme:
            - P4 raccordement
            - P4 reseau secondaire
            - P4ECS Ballon électrique
            - P4ECS Solaire Thermique
            - Calcul Bilan . P4 groupe froid
            - Calcul Bilan . P4 Réseau de froid
        aides spécifiques:
          formule: aides . Total * facteur d'annuité raccordement

        aides:
          somme:
            - aides spécifiques
            - Calcul Bilan . aides réseau de froid

        P4 moins aides:
          le maximum de:
            - P4 - aides
            - 0
        total sans aides:
          somme:
            - P1abo
            - P1conso
            - P1prime
            - P1ECS
            - P1Consofroid
            - P2
            - P3
            - P4
        total avec aides:
          somme:
            - total sans aides
            - (- aides)
        total sans installation:
          somme:
            - total sans aides
            - (- P4)

###### Ratios économiques (investissement)

ratios économiques . Réseaux x Coût raccordement RCU SST x Résidentiel:
  variations:
    - si: nombre de logements dans l'immeuble concerné < 25
      alors: 3709 * 25 / nombre de logements dans l'immeuble concerné
    - si: nombre de logements dans l'immeuble concerné < 42
      alors: 3709
    - si: nombre de logements dans l'immeuble concerné < 58
      alors: 2364
    - si: nombre de logements dans l'immeuble concerné < 83
      alors: 1847
    - si: nombre de logements dans l'immeuble concerné < 125
      alors: 1393
    - si: nombre de logements dans l'immeuble concerné < 167
      alors: 1027
