# Consommation spécifique d'ECS : forfait par habitant en résidentiel,
# table par type tertiaire x normes thermiques sinon.

besoins . consommation spécifique ECS:
  note: Besoin_ECS
  variations:
    - si: bâtiment . type = "résidentiel"
      alors: 360 kWh/habitant
    - si:
        toutes ces conditions:
          - bâtiment . type = "tertiaire"
          - bâtiment . méthode tertiaire = "Bureaux"
          - bâtiment . normes thermiques tertiaire = "RE2020"
      alors: 7 kWhef/m2.an
    - si:
        toutes ces conditions:
          - bâtiment . type = "tertiaire"
          - bâtiment . méthode tertiaire = "Bureaux"
          - bâtiment . normes thermiques tertiaire = "RT2012"
      alors: 7 kWhef/m2.an
    - si:
        toutes ces conditions:
          - bâtiment . type = "tertiaire"
          - bâtiment . méthode tertiaire = "Bureaux"
          - bâtiment . normes thermiques tertiaire = "Moyenne française 2021"
      alors: 7 kWhef/m2.an
    - si:
        toutes ces conditions:
          - bâtiment . type = "tertiaire"
          - bâtiment . méthode tertiaire = "Enseignement secondaire"
          - bâtiment . normes thermiques tertiaire = "RE2020"
      alors: 5 kWhef/m2.an
