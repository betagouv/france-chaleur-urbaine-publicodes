# Constantes transverses d'investissement et d'amortissement.

investissement:
amortissement:

investissement . pose et mise en place:
  formule: 30
  unité: '%'
  note: 'Source: ELCIMAI 2024'
investissement . TVA:
  valeur: 20
  unité: '%'
  note: 'source: ELCIMAI 2024'
investissement . TVA réduite:
  valeur: 5.5
  unité: '%'
amortissement . taux d'actualisation:
  valeur: 0
  unité: '%'
  note: 'source: AMORCE'
