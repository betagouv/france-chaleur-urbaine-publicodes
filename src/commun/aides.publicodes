# Clés historiques CANONIQUES : écrites par le front actuel (toggle aides du
# comparateur). Les nouveaux noms « aides . éligibilité . » les référencent —
# l'inversion se fera à la migration du front.
Paramètres économiques . Aides:
  avec:
    Éligibilité x Prise en compte des aides:
      # alias Calculs économiques B90
      par défaut: oui
      #une possibilité:
      #  - "'oui'"
      #  - "'non'"
    Éligibilité x Je suis un particulier:
      par défaut: oui
      #une possibilité:
      #  - "'oui'"
      #  - "'non'"
    Éligibilité x Ressources du ménage:
      par défaut:
        variations:
          - si:
              toutes ces conditions:
                - est défini: code département
                - est défini: ménage . revenu
                - est défini: Nombre d'habitants moyen par appartement
            alors: ménage . revenu . classe
          - sinon: "'Modeste'"
      une possibilité:
        - "'Très modeste'"
        - "'Modeste'"
        - "'Intermédiaire'"
        - "'Supérieur'"
    Éligibilité x Je dispose actuellement d'une chaudière gaz ou fioul:
      par défaut: oui
      #une possibilité:
      #  - "'oui'"
      #  - "'non'"
    Aides x Éligible Ma prime renov':
      # alias Calculs économiques B91
      par défaut:
        toutes ces conditions:
          - Paramètres économiques . Aides . Éligibilité x Je suis un particulier
          - Paramètres économiques . Aides . Éligibilité x Ressources du ménage != 'Supérieur'
      #une possibilité:
      #  - "'oui'"
      #  - "'non'"
    Aides x Éligible Coup de pouce chauffage:
      # alias Calculs économiques B92
      par défaut:
        toutes ces conditions:
          - Paramètres économiques . Aides . Éligibilité x Je suis un particulier
          - Paramètres économiques . Aides . Éligibilité x Je dispose actuellement d'une chaudière gaz ou fioul
          - type de bâtiment = 'résidentiel'
      #une possibilité:
      #  - "'oui'"
      #  - "'non'"
    Aides x Éligible CEE:
      # alias Calculs économiques B93
      par défaut: oui
      #une possibilité:
      #  - "'oui'"
      #  - "'non'"


aides . éligibilité:
  avec:
    prise en compte des aides: Paramètres économiques . Aides . Éligibilité x Prise en compte des aides
    particulier: Paramètres économiques . Aides . Éligibilité x Je suis un particulier
    ressources du ménage: Paramètres économiques . Aides . Éligibilité x Ressources du ménage
    chaudière gaz ou fioul actuelle: Paramètres économiques . Aides . Éligibilité x Je dispose actuellement d'une chaudière gaz ou fioul
    éligible Ma prime renov': Paramètres économiques . Aides . Aides x Éligible Ma prime renov'
    éligible Coup de pouce: Paramètres économiques . Aides . Aides x Éligible Coup de pouce chauffage
    éligible CEE: Paramètres économiques . Aides . Aides x Éligible CEE

aides . valeur CEE: Paramètres économiques . Aides . Valeur CEE

Paramètres économiques . Aides . Valeur CEE:
  # alias Calculs économiques B94
  par défaut:
    variations:
      - si: Paramètres économiques . Aides . Éligibilité x Ressources du ménage = "Très modeste"
        alors: aides . CEE x Prix moyen du CEE ménage précaire
      - sinon: aides . CEE x Prix moyen du CEE autre ménage
  unité: €/kWh cumac
  note: "source : Registre National des Certificats d'Economie d'Energie"

aides:
  avec:
    # Résidentiel
    # Ma prime rénov' x Supérieur x Non éligible:
    #   applicable si:
    #     toutes ces conditions:
    #       - aides . éligibilité . éligible Ma prime renov'
    #       - Paramètres économiques . Aides . Éligibilité x Ressources du ménage = "Supérieur"
    #   remplace: Calcul Eco . Montant des aides par logement tertiaire . Non éligible . Ma prime renov'
    #   valeur: 0
    #   unité: €

    CEE x Prix moyen du CEE ménage précaire:
      valeur: 0.00816
      unité: €/kWh cumac
    CEE x Prix moyen du CEE autre ménage:
      valeur: 0.00804
      unité: €/kWh cumac

    CEE x FCU x Résidentiel inf 125 appt:
      valeur: 12000000
      unité: kWh cumac
      note: 'Source : Gouvernement 2024'
    CEE x FCU x Résidentiel sup 125 variable:
      valeur: 77000
      # QUESTION : est-ce appartement = logement ? pour harmoniser les unités vers logement
      unité: kWh cumac/logement
      note: 'Source : Gouvernement 2024'
    CEE x FCU x Résidentiel sup 125 fixe:
      valeur: 2300000
      unité: kWh cumac
      note: 'Source : Gouvernement 2024'
    CEE x RCU x facteur correctif:
      valeur: 75
      unité: '%'
      note: 'Source : FCU'
    CEE x FCU x Tertiaire inf 7500 appt:
      valeur: 11000000
      unité: kWh cumac/m2
    CEE x FCU x Tertiaire sup 7500 variable:
      valeur: 1070
      unité: kWh cumac/m2
    CEE x FCU x Tertiaire sup 7500 fixe:
      valeur: 2300000
      unité: kWh cumac

    CEE x PAC air-eau indiv x BAR-TH-171:
      produit:
        - montant
        - facteur correctif selon la surface chauffée
        - facteur correctif selon la zone géographique
      unité: kWh cumac
      note: BAR-TH-171 - Pompe à chaleur de type air/eau
    CEE x PAC air-eau indiv x BAR-TH-171 . montant:
      variations:
        - si: efficacité énergétique saisonnière < 111%
          alors: 0
        - si: ratios . GNRL Appartement ou maison = 'Appartement'
          alors:
            variations:
              - si: efficacité énergétique saisonnière < 140%
                alors: 48700
              - sinon: 58900
        - sinon:
            variations:
              - si: efficacité énergétique saisonnière < 140%
                alors: 90900
              - sinon: 109200
      unité: kWh cumac
    CEE x PAC air-eau indiv x BAR-TH-171 . efficacité énergétique saisonnière: ratios économiques x aides . CEE x PAC air-eau indiv x BAR-TH-171 . efficacité énergétique saisonnière
    CEE x PAC air-eau indiv x BAR-TH-171 . facteur correctif selon la surface chauffée:
      variations:
        - si: ratios . GNRL Appartement ou maison = 'Appartement'
          alors:
            variations:
              - si: surface logement type tertiaire < 35
                alors: 0.5
              - si: surface logement type tertiaire < 60
                alors: 0.7
              - sinon: 1
        - sinon:
            variations:
              - si: surface logement type tertiaire < 70
                alors: 0.5
              - si: surface logement type tertiaire < 90
                alors: 0.7
              - sinon: 1
    CEE x PAC air-eau indiv x BAR-TH-171 . facteur correctif selon la zone géographique:
      variations:
        - si: zone climatique = 'H1'
          alors: 1.2
        - si: zone climatique = 'H2'
          alors: 1
        - si: zone climatique = 'H3'
          alors: 0.7

    Coup de pouce x PAC air-eau:
      applicable si: aides . éligibilité . éligible Coup de pouce
      valeur: PAC air-eau indiv . aides . CEE * 5
      unité: €

    # N'existe pas dans les types d'installations retenus
    # Coup de pouce x Modeste x Chaudière biomasse:
    #   applicable si:
    #     toutes ces conditions:
    #       - aides . éligibilité . éligible Coup de pouce
    #       - Paramètres économiques . Aides . Éligibilité x Ressources du ménage = 'Modeste'
    #   remplace: Calcul Eco . Montant des aides par logement tertiaire . Chaudière biomasse . Coup de pouce
    #   valeur: 4000
    #   unité: €
    #   note: 'Montant minimal de la prime - Source : Prime "Coup de pouce chauffage" | Service-Public.fr'
    # N'existe pas dans les types d'installations retenus
    # Coup de pouce x Autre revenu x Chaudière biomasse:
    #   applicable si:
    #     toutes ces conditions:
    #       - aides . éligibilité . éligible Coup de pouce
    #       - Paramètres économiques . Aides . Éligibilité x Ressources du ménage != 'Modeste'
    #   remplace: Calcul Eco . Montant des aides par logement tertiaire . Chaudière biomasse . Coup de pouce
    #   valeur: 2500
    #   unité: €
    #   note: 'Montant minimal de la prime - Source : Prime "Coup de pouce chauffage" | Service-Public.fr'
    CEE x Chauffe-eau solaire collectif x Ratio:
      valeur: 0.196

    Tertiaire:
      avec:
        CEE x RFU x montant:
          variations:
            - si: zone climatique = 'H1'
              alors: 1
            - si: zone climatique = 'H2'
              alors: 1.3
            - si: zone climatique = 'H3'
              alors: 1.8
          unité: kWh cumac/m2
          note: 'Source : ADEME 2024'
        CEE x RFU x facteur correctif:
          variations:
            - si: méthode tertiaire = 'Bureaux'
              alors: 7800
            - si: méthode tertiaire = 'Enseignement primaire'
              alors: 4900
            - si: méthode tertiaire = 'Enseignement secondaire'
              alors: 4900
            - si: méthode tertiaire = 'EHPAD'
              alors: 26000
            - si: méthode tertiaire = 'Santé'
              alors: 26000
            - si: méthode tertiaire = 'Commerces'
              alors: 11300
            - si: méthode tertiaire = 'Café, restaurant'
              alors: 10400
            - si: méthode tertiaire = 'Hôtel'
              alors: 10400
            - si: méthode tertiaire = 'Sport'
              alors: 19800
          unité: kWh cumac/kW
          note: 'Source : ADEME 2024'
        CEE x Chauffe-eau solaire x Ratio:
          # QUESTION déjà posée: quelle différence entre ratios éco - aides > C261 et C447 ?
          valeur: 0.196

# clé historique canonique (écrite par le front : simulateur PAC)
ratios économiques x aides . CEE x PAC air-eau indiv x BAR-TH-171 . efficacité énergétique saisonnière:
  par défaut: PAC air-eau indiv . ratios . SCOP / 2.5
  unité: '%'
