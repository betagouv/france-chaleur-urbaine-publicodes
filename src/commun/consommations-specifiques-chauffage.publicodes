# Consommations spécifiques de chauffage (matrices remplace sur
# « consommation spécifique chauffage ») : DPE et périodes constructives
# résidentiel, types tertiaires x normes thermiques.

consommation spécifique chauffage:
  variations:
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'DPE'
          - DPE = "A"
      alors: 45 kWh/m2/an
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'DPE'
          - DPE = "B"
      alors: 70 kWh/m2/an
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'DPE'
          - DPE = "C"
      alors: 115 kWh/m2/an
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'DPE'
          - DPE = "D"
      alors: 165 kWh/m2/an
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'DPE'
          - DPE = "E"
      alors: 215 kWh/m2/an
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'DPE'
          - DPE = "F"
      alors: 275 kWh/m2/an
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'DPE'
          - DPE = "G"
      alors: 300 kWh/m2/an
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'Normes thermiques et âge du bâtiment'
          - normes thermiques et âge du bâtiment = "RE2020 - Après 2020"
      alors: 0.18 W/m3.°C
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'Normes thermiques et âge du bâtiment'
          - normes thermiques et âge du bâtiment = "RT2012 - Entre 2012 et 2020"
      alors: 0.22 W/m3.°C
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'Normes thermiques et âge du bâtiment'
          - normes thermiques et âge du bâtiment = "RT2005 - Entre 2005 et 2012"
      alors: 0.65 W/m3.°C
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'Normes thermiques et âge du bâtiment'
          - normes thermiques et âge du bâtiment = "RT2000 - Entre 2000 et 2005"
      alors: 0.75 W/m3.°C
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'Normes thermiques et âge du bâtiment'
          - normes thermiques et âge du bâtiment = "de 1990 à 2000"
      alors: 1 W/m3.°C
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'Normes thermiques et âge du bâtiment'
          - normes thermiques et âge du bâtiment = "de 1974 à 1990"
      alors: 1.4 W/m3.°C
    - si:
        toutes ces conditions:
          - type de bâtiment = 'résidentiel'
          - méthode résidentiel = 'Normes thermiques et âge du bâtiment'
          - normes thermiques et âge du bâtiment = "avant 1974"
      alors: 2 W/m3.°C
    - si:
        toutes ces conditions:
          - type de bâtiment = 'tertiaire'
          - méthode tertiaire = "Bureaux"
          - normes thermiques tertiaire = "RE2020"
      alors: 50 kWhef/m2.an
    - si:
        toutes ces conditions:
          - type de bâtiment = 'tertiaire'
          - méthode tertiaire = "Bureaux"
          - normes thermiques tertiaire = "RT2012"
      alors: 65 kWhef/m2.an
    - si:
        toutes ces conditions:
          - type de bâtiment = 'tertiaire'
          - méthode tertiaire = "Bureaux"
          - normes thermiques tertiaire = "Moyenne française 2021"
      alors: 95 kWhef/m2.an
    - si:
        toutes ces conditions:
          - type de bâtiment = 'tertiaire'
          - méthode tertiaire = "Enseignement secondaire"
          - normes thermiques tertiaire = "RE2020"
      alors: 40 kWhef/m2.an
    - si:
