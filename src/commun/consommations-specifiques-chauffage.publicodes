# Consommation spécifique de chauffage : table par bâtiment . DPE et périodes
# constructives (résidentiel), et par type tertiaire x normes thermiques.

besoins . consommation spécifique chauffage:
  variations:
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'DPE'
          - bâtiment . DPE = "A"
      alors: 45 kWh/m2/an
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'DPE'
          - bâtiment . DPE = "B"
      alors: 70 kWh/m2/an
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'DPE'
          - bâtiment . DPE = "C"
      alors: 115 kWh/m2/an
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'DPE'
          - bâtiment . DPE = "D"
      alors: 165 kWh/m2/an
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'DPE'
          - bâtiment . DPE = "E"
      alors: 215 kWh/m2/an
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'DPE'
          - bâtiment . DPE = "F"
      alors: 275 kWh/m2/an
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'DPE'
          - bâtiment . DPE = "G"
      alors: 300 kWh/m2/an
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'Normes thermiques et âge du bâtiment'
          - bâtiment . normes thermiques et âge = "RE2020 - Après 2020"
      alors: 0.18 W/m3.°C
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'Normes thermiques et âge du bâtiment'
          - bâtiment . normes thermiques et âge = "RT2012 - Entre 2012 et 2020"
      alors: 0.22 W/m3.°C
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'Normes thermiques et âge du bâtiment'
          - bâtiment . normes thermiques et âge = "RT2005 - Entre 2005 et 2012"
      alors: 0.65 W/m3.°C
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'Normes thermiques et âge du bâtiment'
          - bâtiment . normes thermiques et âge = "RT2000 - Entre 2000 et 2005"
      alors: 0.75 W/m3.°C
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'Normes thermiques et âge du bâtiment'
          - bâtiment . normes thermiques et âge = "de 1990 à 2000"
      alors: 1 W/m3.°C
    - si:
        toutes ces conditions:
          - bâtiment . type = 'résidentiel'
          - bâtiment . méthode résidentiel = 'Normes thermiques et âge du bâtiment'
