# Consommations spécifiques de chauffage (matrices remplace sur
# « consommation spécifique chauffage ») : DPE et périodes constructives
# résidentiel, types tertiaires x normes thermiques.

ratios . CHAF A:
  applicable si:
    toutes ces conditions:
      - type de bâtiment = 'résidentiel'
      - méthode résidentiel = 'DPE'
      - DPE = "A"
  remplace: consommation spécifique chauffage
  valeur: 45
  unité: kWh/m2/an

