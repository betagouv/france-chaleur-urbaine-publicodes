dimensionnement . ratios . température de non chauffage:
  valeur: 18
  unité: °C

dimensionnement . ratios . facteur de surpuissance:
  valeur: 20%
  unité: '%'

dimensionnement . ratios . heures de fonctionnement non climatique ECS:
  valeur: 3000
  unité: h

dimensionnement . ratios . coefficient de foisonnement ECS:
  valeur: 50%
  unité: '%'

dimensionnement . ratios . coefficient de foisonnement chauffage collectif:
  valeur: 80%
  unité: '%'

