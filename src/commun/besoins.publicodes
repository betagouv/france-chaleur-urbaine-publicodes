dimensionnement:
  description: Puissances appelées et heures de fonctionnement
  avec:
    heures pleine puissance chauffage continu:
      formule: climat . degré jours chaud * 24 / (dimensionnement . ratios . température de non chauffage - climat . température de référence chaud)
      unité: h

    heures pleine puissance chauffage:
      produit:
        - dimensionnement . heures pleine puissance chauffage continu
        - dimensionnement . coefficient intermittence
      unité: h

    puissance chauffage appelée:
      formule: (besoins . chauffage par logement / dimensionnement . heures pleine puissance chauffage) * (1 + dimensionnement . ratios . facteur de surpuissance)
      unité: kW

    puissance ECS appelée:
      formule: (besoins . ECS par logement / dimensionnement . ratios . heures de fonctionnement non climatique ECS) * (1 + dimensionnement . ratios . facteur de surpuissance)
      unité: kW

    heures pleine puissance climatisation:
      produit:
        - climat . degré jours froid
        - 24
        - dimensionnement . coefficient intermittence
      unité: h

    puissance refroidissement appelée:
      applicable si: dimensionnement . heures pleine puissance climatisation > 0
      formule: besoins . climatisation par logement / dimensionnement . heures pleine puissance climatisation * (1 + dimensionnement . ratios . facteur de surpuissance)
      unité: kW

# --- Ratios généraux et de dimensionnement (écrits par la page paramètres) ---

bâtiment . ratios:
  description: Valeurs de référence du bâtiment (surfaces, occupation, climatisation)

climat . ratios:
  description: Valeurs de référence climatiques

dimensionnement . ratios:
  description: Valeurs de référence du dimensionnement des puissances

ecs . ratios:
  description: Valeurs de référence de la production d'ECS

bâtiment . ratios . surface de référence appartement:
  valeur: 70
  unité: m2

bâtiment . ratios . surface de référence tertiaire:
  valeur: 2500
  unité: m2

bâtiment . ratios . hauteur sous plafond:
  valeur: 2.2
  unité: m

climat . ratios . DJU de référence chaud:
  valeur: 2200
  unité: DJU chaud

bâtiment . ratios . habitants par logement:
  valeur: 2.17
  unité: personne

ecs . ratios . production par défaut:
  par défaut: oui
  #une possibilité:
  #  - "'oui'"
  #  - "'non'"

bâtiment . appartement ou maison:
  valeur: "'Appartement'"

bâtiment . ratios . nombre de logements:
  valeur: 25
  unité: logement

bâtiment . ratios . part surface à climatiser résidentiel:
  valeur: 70%
  unité: '%'

bâtiment . ratios . part surface à climatiser tertiaire:
  valeur: 100%
  unité: '%'

# aucune valeur définie
