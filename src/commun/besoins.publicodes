dimensionnement:
  description: Puissances appelées et heures de fonctionnement
  avec:
    heures pleine puissance chauffage continu:
      formule: climat . degré jours chaud * 24 / (ratios . PUIS Température de non chauffage - climat . température de référence chaud)
      unité: h

    heures pleine puissance chauffage:
      produit:
        - dimensionnement . heures pleine puissance chauffage continu
        - coefficient intermittence
      unité: h

    puissance chauffage appelée:
      formule: (besoins . chauffage par logement / dimensionnement . heures pleine puissance chauffage) * (1 + ratios . PUIS Facteur de surpuissance)
      unité: kW

    puissance ECS appelée:
      formule: (besoins . ECS par logement / ratios . PUIS Nombre heure de fonctionnement non climatique ECS) * (1 + ratios . PUIS Facteur de surpuissance)
      unité: kW

    heures pleine puissance climatisation:
      produit:
        - climat . degré jours froid
        - 24
        - coefficient intermittence
      unité: h

    puissance refroidissement appelée:
      applicable si: dimensionnement . heures pleine puissance climatisation > 0
      formule: besoins . climatisation par logement / dimensionnement . heures pleine puissance climatisation * (1 + ratios . PUIS Facteur de surpuissance)
      unité: kW

# --- Ratios généraux et de dimensionnement (clés historiques de la page paramètres) ---

ratios . GNRL Surface de référence appartement:
  valeur: 70
  unité: m2

ratios . GNRL Surface de référence tertiaire:
  valeur: 2500
  unité: m2

ratios . GNRL Hauteur:
  valeur: 2.2
  unité: m

ratios . GNRL DJU REF chaud:
  valeur: 2200
  unité: DJU chaud

ratios . GNRL Nombre habitant par logement:
  valeur: 2.17
  unité: personne

ratios . GNRL Production ECS:
  par défaut: oui
  #une possibilité:
  #  - "'oui'"
  #  - "'non'"

ratios . GNRL Appartement ou maison:
  valeur: "'Appartement'"

ratios . GNRL Nombre de logement dans l'immeuble concerné:
  valeur: 25
  unité: logement

ratios . GNRL Part surface à climatiser résidentiel:
  valeur: 70%
  unité: '%'

ratios . GNRL Part surface à climatiser tertiaire:
  valeur: 100%
  unité: '%'

