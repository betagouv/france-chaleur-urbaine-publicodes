# Coefficients d'intermittence pour le calcul de puissance (matrices
# remplace sur « puissance coefficient d'intermittence »).

ratios . CI A:
  applicable si:
    toutes ces conditions:
      - type de bâtiment = "résidentiel"
      - méthode résidentiel = "DPE"
      - DPE = "A"
  remplace: puissance coefficient d'intermittence
  valeur: 70%
  unité: '%'

