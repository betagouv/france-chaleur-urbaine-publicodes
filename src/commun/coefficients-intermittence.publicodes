# Coefficient d'intermittence pour le calcul de puissance : table par
# DPE (résidentiel) et méthode tertiaire.

coefficient intermittence:
  variations:
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "DPE"
          - DPE = "A"
      alors: 70%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "DPE"
          - DPE = "B"
      alors: 70%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "DPE"
          - DPE = "C"
      alors: 90%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "DPE"
          - DPE = "D"
      alors: 90%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "DPE"
          - DPE = "E"
      alors: 100%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "DPE"
          - DPE = "F"
      alors: 100%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "DPE"
          - DPE = "G"
      alors: 100%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "Normes thermiques et âge du bâtiment"
          - normes thermiques et âge du bâtiment = "RE2020 - Après 2020"
      alors: 70%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "Normes thermiques et âge du bâtiment"
          - normes thermiques et âge du bâtiment = "RT2012 - Entre 2012 et 2020"
      alors: 70%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "Normes thermiques et âge du bâtiment"
          - normes thermiques et âge du bâtiment = "RT2005 - Entre 2005 et 2012"
      alors: 90%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "Normes thermiques et âge du bâtiment"
          - normes thermiques et âge du bâtiment = "RT2000 - Entre 2000 et 2005"
      alors: 90%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "Normes thermiques et âge du bâtiment"
          - normes thermiques et âge du bâtiment = "de 1990 à 2000"
      alors: 100%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "Normes thermiques et âge du bâtiment"
          - normes thermiques et âge du bâtiment = "de 1974 à 1990"
      alors: 100%
    - si:
        toutes ces conditions:
          - type de bâtiment = "résidentiel"
          - méthode résidentiel = "Normes thermiques et âge du bâtiment"
          - normes thermiques et âge du bâtiment = "avant 1974"
      alors: 100%
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Bureaux"
      alors: 80%
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Enseignement secondaire"
      alors: 80%
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Santé"
      alors: 90%
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Café, restaurant"
      alors: 80%
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Hôtel"
      alors: 80%
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Commerces"
      alors: 80%
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Enseignement primaire"
      alors: 80%
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Sport"
      alors: 60%
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Centre aqualudique"
      alors: 90%
    - si:
        toutes ces conditions:
