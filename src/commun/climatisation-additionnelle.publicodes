
# Production de froid ajoutée aux modes qui ne la produisent pas eux-mêmes
# (tous sauf les PAC réversibles) : groupe froid résidentiel, groupe d'eau
# glacée tertiaire, et surcoûts du réseau de froid greffés sur chaque bilan.
# Pendant de « ecs additionnelle » côté eau chaude sanitaire.

climatisation additionnelle:
  description: Production de froid ajoutée aux modes qui ne la produisent pas eux-mêmes
  avec:
    # Production de froid : groupe froid résidentiel, groupe d'eau glacée
    # tertiaire et surcoûts communs du réseau de froid (bloc Calcul Bilan).
    # Valeurs communes à tous les modes de chauffage.

    puissance groupe froid résidentiel:
      variations:
        - si:
            toutes ces conditions:
              - climatisation . incluse
              - bâtiment . type = 'résidentiel'
              - climatisation . type de production = 'Groupe froid'
          alors:
            produit:
              - 1 + ((dimensionnement . puissance refroidissement appelée / PAC air-air indiv . ratios . SEER) // climatisation additionnelle . puissance unitaire groupe froid)
              - climatisation additionnelle . puissance unitaire groupe froid
        - sinon: 0
      unité: kW

    puissance groupe eau glacée tertiaire:
      variations:
        - si:
            toutes ces conditions:
              - climatisation . incluse
              - bâtiment . type = 'tertiaire'
              - climatisation . type de production = 'Groupe froid'
          alors:
            produit:
              - 1 + ((dimensionnement . puissance refroidissement appelée / PAC air-eau coll . ratios . SEER) // PAC air-eau coll . ratios . puissance unitaire réversible)
              - PAC air-eau coll . ratios . puissance unitaire réversible
        - sinon: 0
      unité: kW

    consommation groupe froid:
      variations:
        - si:
            toutes ces conditions:
              - climatisation . incluse
              - climatisation . type de production = 'Groupe froid'
          alors:
            variations:
              - si: bâtiment . type = 'résidentiel'
                alors: besoins . climatisation par logement / PAC air-air indiv . ratios . SEER
              - sinon: besoins . climatisation par logement / PAC air-eau coll . ratios . SEER
        - sinon: 0

    investissement groupe froid résidentiel:
      produit:
        - coût équipement groupe froid résidentiel
        - 1 + investissement . pose et mise en place

    investissement groupe eau glacée tertiaire:
      produit:
        - coût équipement groupe eau glacée tertiaire
        - 1 + investissement . pose et mise en place
        - 1 / bâtiment . nombre de logements
    surcoût P2:
      variations:
        - si: climatisation . incluse
          alors:
            variations:
              - si: climatisation . type de production = 'Réseau de froid'
                alors: réseau de froid . coûts . petit entretien P2 par logement tertiaire
              - sinon:
                  variations:
                    - si: bâtiment . type = 'résidentiel'
                      alors: climatisation additionnelle . entretien groupe froid résidentiel . petit entretien P2 par logement tertiaire
                    - si: bâtiment . type = 'tertiaire'
                      alors: climatisation additionnelle . entretien groupe eau glacée tertiaire . petit entretien P2 par logement tertiaire
        - sinon: 0

    surcoût P3:
      variations:
        - si: climatisation . incluse
          alors:
            variations:
              - si: climatisation . type de production = 'Réseau de froid'
                alors: réseau de froid . coûts . gros entretien P3 par logement tertiaire
              - sinon:
                  variations:
                    - si: bâtiment . type = 'résidentiel'
                      alors: climatisation additionnelle . entretien groupe froid résidentiel . gros entretien P3 par logement tertiaire
                    - si: bâtiment . type = 'tertiaire'
                      alors: climatisation additionnelle . entretien groupe eau glacée tertiaire . gros entretien P3 par logement tertiaire
        - sinon: 0

    surcoût P1 auxiliaires:
      variations:
        - si:
            toutes ces conditions:
              - climatisation . incluse
              - climatisation . type de production = 'Réseau de froid'
          alors: réseau de froid . coûts . P1 auxiliaires
        - sinon: 0

    P4 groupe froid:
      variations:
        - si: bâtiment . type = 'résidentiel'
          alors: climatisation additionnelle . investissement groupe froid résidentiel * PAC air-air indiv . annuité
        - sinon: climatisation additionnelle . investissement groupe eau glacée tertiaire * PAC air-eau coll . annuité
    P4 réseau de froid:
      variations:
        - si:
            toutes ces conditions:
              - climatisation . incluse
              - climatisation . type de production = 'Réseau de froid'
          alors: réseau de froid . coûts . investissement par logement * réseau de froid . annuité
        - sinon: 0

    aides réseau de froid amorties:
      formule: réseau de froid . aides . total * réseau de froid . annuité

    aides réseau de froid:
      variations:
        - si:
            toutes ces conditions:
              - climatisation . incluse
              - climatisation . type de production = 'Réseau de froid'
          alors: aides réseau de froid amorties
        - sinon: 0

    coût équipement groupe froid résidentiel:
      par défaut:
        produit:
          - PAC air-air indiv . ratios . coût équipement au kW
          - climatisation additionnelle . puissance groupe froid résidentiel
          - 1 + investissement . TVA
      unité: €TTC

    coût équipement groupe eau glacée tertiaire:
      par défaut:
        produit:
          - PAC air-eau coll . ratios . coût équipement au kW
          - climatisation additionnelle . puissance groupe eau glacée tertiaire
          - 1 + investissement . TVA
      unité: €TTC

    puissance unitaire groupe froid:
      valeur: 2.5
      unité: kW

# --- Entretien P2 / P3 (clés historiques de la page paramètres) ---

climatisation additionnelle . entretien groupe froid résidentiel:
  avec:
    petit entretien P2:
      variations:
        - si:
            toutes ces conditions:
              - climatisation . incluse
              - climatisation . type de production = 'Groupe froid'
              - bâtiment . type = 'résidentiel'
          alors:
            produit:
              - PAC air-eau coll . ratios . petit entretien P2
              - besoins . climatisation par logement
              - bâtiment . nombre de logements
              - 1 / 1000
        - sinon: 0

    gros entretien P3:
      variations:
        - si:
            toutes ces conditions:
              - climatisation . incluse
              - climatisation . type de production = 'Groupe froid'
              - bâtiment . type = 'résidentiel'
          alors:
            produit:
              - PAC air-eau coll . ratios . gros entretien P3
              - besoins . climatisation par logement
              - bâtiment . nombre de logements
              - 1 / 1000
        - sinon: 0
    petit entretien P2 par logement tertiaire: petit entretien P2 / bâtiment . nombre de logements
    gros entretien P3 par logement tertiaire: gros entretien P3 / bâtiment . nombre de logements

climatisation additionnelle . entretien groupe eau glacée tertiaire:
  avec:
    petit entretien P2:
      variations:
        - si:
            toutes ces conditions:
              - climatisation . incluse
              - climatisation . type de production = 'Groupe froid'
              - bâtiment . type = 'tertiaire'
          alors:
            produit:
              - PAC air-eau coll . ratios . petit entretien P2
              - besoins . climatisation par logement
              - 1 / 1000
        - sinon: 0
    gros entretien P3:
      variations:
        - si:
            toutes ces conditions:
              - climatisation . incluse
              - climatisation . type de production = 'Groupe froid'
              - bâtiment . type = 'tertiaire'
          alors:
            produit:
              - PAC air-eau coll . ratios . gros entretien P3
              - besoins . climatisation par logement
              - 1 / 1000
        - sinon: 0
    petit entretien P2 par logement tertiaire: petit entretien P2 / bâtiment . nombre de logements
    gros entretien P3 par logement tertiaire: gros entretien P3 / bâtiment . nombre de logements

