    Abonnement annuel collectif:
      # C'est ici en fait le surcout à l'abonnement annuel
      variations:
        - si: Paramètres économiques . Electricité x Puissance souscrite coll <= 6
          alors: 0
        - si: Paramètres économiques . Electricité x Puissance souscrite coll <= 9
          alors:
            variations:
              - si: Paramètres économiques . Electricité x Option tarifaire = 'Option base'
