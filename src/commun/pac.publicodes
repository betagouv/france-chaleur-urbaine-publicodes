# Socle commun à toutes les pompes à chaleur : SCOP par classe énergétique,
# consommations auxiliaires, deltas de température des émetteurs (dérogation),
# et PAC à absorption gaz.

pac:
  description: Socle commun à toutes les pompes à chaleur
  avec:
    température émetteurs delta:
      variations:
        - si: bâtiment . température émetteurs = "35"
          alors: 0
        - si: bâtiment . température émetteurs = "45"
          alors: -0.6
        - si: bâtiment . température émetteurs = "55"
          alors: -1.2
        - si: bâtiment . température émetteurs = "65"
          alors: -1.6
        - si: bâtiment . température émetteurs = "Plancher"
          alors: 0
        - si: bâtiment . température émetteurs = "Radiateur"
          alors: -1.2

pac . ratios:
  description: Valeurs de référence communes aux pompes à chaleur

pac . ratios . conso auxiliaire chauffage climatisation:
  valeur: 99.8%

pac . ratios . conso auxiliaire ECS:
  valeur: 99%

pac . ratios . SCOP mini:
  valeur: 1.8
