# Socle commun à toutes les pompes à chaleur : SCOP par classe énergétique,
# consommations auxiliaires, deltas de température des émetteurs (dérogation),
# et PAC à absorption gaz.

ratios . PAC GNRL A:
  valeur: 3.60

ratios . PAC GNRL Aplus:
  valeur: 4.30

ratios . PAC GNRL Aplusplus:
  valeur: 4.85

ratios . PAC GNRL Aplusplusplus:
  valeur: 5.10

ratios . PAC GNRL Conso auxiliaire chauffage climatisation hors PAC air-air:
  valeur: 99.8%

ratios . PAC GNRL Conso auxiliaire ECS hors PAC air-air:
  valeur: 99%

ratios . PAC GNRL SCOP mini:
  valeur: 1.8

ratios . PAC AB SCOP coll:
  valeur: 1.23

ratios . PAC AB Classe énergétique:
  valeur: "'A+'"

ratios . PAC AB Puissance unitaire coll:
  valeur: 35
  unité: kW

ratios . PAC AB Conso combustible gaz coll:
  valeur: 72%
  unité: '%'

ratios . PAC AB Durée de vie:
  valeur: 17
  unité: an

ratios . PAC DEROG3 35:
  applicable si: Température émetteurs = "35"
  remplace: Température émetteurs delta
  valeur: 0

ratios . PAC DEROG3 45:
  applicable si: Température émetteurs = "45"
  remplace: Température émetteurs delta
  valeur: -0.6

ratios . PAC DEROG3 55:
  applicable si: Température émetteurs = "55"
  remplace: Température émetteurs delta
  valeur: -1.2

ratios . PAC DEROG3 65:
  applicable si: Température émetteurs = "65"
  remplace: Température émetteurs delta
  valeur: -1.6

ratios . PAC DEROG3 Plancher:
  applicable si: Température émetteurs = "Plancher"
  remplace: Température émetteurs delta
  valeur: 0

ratios . PAC DEROG3 Radiateur:
  applicable si: Température émetteurs = "Radiateur"
  remplace: Température émetteurs delta
  valeur: -1.2
