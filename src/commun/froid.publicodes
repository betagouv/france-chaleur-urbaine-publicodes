
froid:
  description: Production de froid — surcoûts communs à tous les modes
  avec:
    # Production de froid : groupe froid résidentiel, groupe d'eau glacée
    # tertiaire et surcoûts communs du réseau de froid (bloc Calcul Bilan).
    # Valeurs communes à tous les modes de chauffage.

    puissance groupe froid résidentiel:
      variations:
        - si:
            toutes ces conditions:
              - Inclure la climatisation
              - type de bâtiment = 'résidentiel'
              - type de production de froid = 'Groupe froid'
          alors:
            produit:
              - 1 + ((dimensionnement . puissance refroidissement appelée / PAC air-air indiv . ratios . SEER) // ratios . PAC AIR AIR Puissance unitaire groupe froid indiv)
              - ratios . PAC AIR AIR Puissance unitaire groupe froid indiv
        - sinon: 0
      unité: kW

    puissance groupe eau glacée tertiaire:
      variations:
        - si:
            toutes ces conditions:
              - Inclure la climatisation
              - type de bâtiment = 'tertiaire'
              - type de production de froid = 'Groupe froid'
          alors:
            produit:
              - 1 + ((dimensionnement . puissance refroidissement appelée / PAC air-eau coll . ratios . SEER) // ratios . PAC AIR EAU Puissance unitaire réversible coll)
              - ratios . PAC AIR EAU Puissance unitaire réversible coll
        - sinon: 0
      unité: kW

    consommation groupe froid:
      variations:
        - si:
            toutes ces conditions:
              - Inclure la climatisation
              - type de production de froid = 'Groupe froid'
          alors:
            variations:
              - si: type de bâtiment = 'résidentiel'
                alors: besoins en climatisation par appartement / PAC air-air indiv . ratios . SEER
              - sinon: besoins en climatisation par appartement / PAC air-eau coll . ratios . SEER
        - sinon: 0

    investissement groupe froid résidentiel:
      produit:
        - Investissement x Groupe froid x résidentiel
        - 1 + investissement . pose et mise en place

    investissement groupe eau glacée tertiaire:
      produit:
        - Investissement x Groupe eau glacée x tertiaire
        - 1 + investissement . pose et mise en place
        - 1 / nombre de logements dans l'immeuble concerné
    surcoût P2:
      variations:
        - si: Inclure la climatisation
          alors:
            variations:
              - si: type de production de froid = 'Réseau de froid'
                alors: réseau de froid . coûts . petit entretien P2 par logement tertiaire
              - sinon:
                  variations:
                    - si: type de bâtiment = 'résidentiel'
                      alors: Calcul Eco . P2 P3 Coût de l'entretien . Groupe froid résidentiel . petit entretien P2 par logement tertiaire
                    - si: type de bâtiment = 'tertiaire'
                      alors: Calcul Eco . P2 P3 Coût de l'entretien . Groupe eau glacée tertiaire . petit entretien P2 par logement tertiaire
        - sinon: 0

    surcoût P3:
      variations:
        - si: Inclure la climatisation
          alors:
            variations:
              - si: type de production de froid = 'Réseau de froid'
                alors: réseau de froid . coûts . gros entretien P3 par logement tertiaire
              - sinon:
                  variations:
                    - si: type de bâtiment = 'résidentiel'
                      alors: Calcul Eco . P2 P3 Coût de l'entretien . Groupe froid résidentiel . gros entretien P3 par logement tertiaire
                    - si: type de bâtiment = 'tertiaire'
                      alors: Calcul Eco . P2 P3 Coût de l'entretien . Groupe eau glacée tertiaire . gros entretien P3 par logement tertiaire
        - sinon: 0

    surcoût P1 auxiliaires:
      variations:
        - si:
            toutes ces conditions:
              - Inclure la climatisation
              - type de production de froid = 'Réseau de froid'
          alors: réseau de froid . coûts . P1 auxiliaires
        - sinon: 0

    P4 groupe froid:
      variations:
        - si: type de bâtiment = 'résidentiel'
          alors: froid . investissement groupe froid résidentiel * PAC air-air indiv . facteur d'annuité
        - sinon: froid . investissement groupe eau glacée tertiaire * PAC air-eau coll . facteur d'annuité
    P4 réseau de froid:
      variations:
        - si:
            toutes ces conditions:
              - Inclure la climatisation
              - type de production de froid = 'Réseau de froid'
          alors: réseau de froid . coûts . investissement par logement * réseau de froid . facteur d'annuité
        - sinon: 0

    aides réseau de froid amorties:
      formule: réseau de froid . aides . Total * réseau de froid . facteur d'annuité

    aides réseau de froid:
      variations:
        - si:
            toutes ces conditions:
              - Inclure la climatisation
              - type de production de froid = 'Réseau de froid'
          alors: aides réseau de froid amorties
        - sinon: 0

###### Investissement

Investissement x Groupe froid x résidentiel:
  par défaut:
    produit:
      - ratios économiques . PAC x air-air réversible . Coût investissement Individuel
      - froid . puissance groupe froid résidentiel
      - 1 + investissement . TVA
  unité: €TTC

Investissement x Groupe eau glacée x tertiaire:
  par défaut:
    produit:
      - ratios économiques . PAC x air-eau réversible . Coût investissement Collectif
      - froid . puissance groupe eau glacée tertiaire
      - 1 + investissement . TVA
  unité: €TTC

###### Installation

###### Entretien P2 / P3

Calcul Eco . P2 P3 Coût de l'entretien . Groupe froid résidentiel:
  avec:
    petit entretien P2:
      variations:
        - si:
            toutes ces conditions:
              - Inclure la climatisation
              - type de production de froid = 'Groupe froid'
              - type de bâtiment = 'résidentiel'
          alors:
            produit:
              - PAC air-eau coll . ratios . petit entretien P2
              - besoins en climatisation par appartement
              - nombre de logements dans l'immeuble concerné
              - 1 / 1000
        - sinon: 0

    gros entretien P3:
      variations:
        - si:
            toutes ces conditions:
              - Inclure la climatisation
              - type de production de froid = 'Groupe froid'
              - type de bâtiment = 'résidentiel'
          alors:
            produit:
              - Paramètres économiques . Gros entretien P3 . PAC air-eau coll
              - besoins en climatisation par appartement
              - nombre de logements dans l'immeuble concerné
              - 1 / 1000
        - sinon: 0
    petit entretien P2 par logement tertiaire: petit entretien P2 / nombre de logements dans l'immeuble concerné
    gros entretien P3 par logement tertiaire: gros entretien P3 / nombre de logements dans l'immeuble concerné

Calcul Eco . P2 P3 Coût de l'entretien . Groupe eau glacée tertiaire:
  avec:
    petit entretien P2:
      variations:
        - si:
            toutes ces conditions:
              - Inclure la climatisation
              - type de production de froid = 'Groupe froid'
              - type de bâtiment = 'tertiaire'
          alors:
            produit:
              - PAC air-eau coll . ratios . petit entretien P2
              - besoins en climatisation par appartement
              - 1 / 1000
        - sinon: 0
    gros entretien P3:
      variations:
        - si:
            toutes ces conditions:
              - Inclure la climatisation
              - type de production de froid = 'Groupe froid'
              - type de bâtiment = 'tertiaire'
          alors:
            produit:
              - Paramètres économiques . Gros entretien P3 . PAC air-eau coll
              - besoins en climatisation par appartement
              - 1 / 1000
        - sinon: 0
    petit entretien P2 par logement tertiaire: petit entretien P2 / nombre de logements dans l'immeuble concerné
    gros entretien P3 par logement tertiaire: gros entretien P3 / nombre de logements dans l'immeuble concerné

