      alors: 30 kWhef/m2.an

volume du ballon ECS:
  variations:
    - si: type de production ECS = 'Solaire thermique'
      alors: 50
    - sinon: (besoins eau chaude sanitaire par appartement * ecs additionnelle . quantité d'ECS produite par kWh) / 365
  unité: L

