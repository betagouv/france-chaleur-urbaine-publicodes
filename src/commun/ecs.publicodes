# Production d'ECS additionnelle (ballon électrique / chauffe-eau solaire)
# quand l'équipement de chauffage ne produit pas l'eau chaude sanitaire.
# Valeurs communes à tous les modes de chauffage.

consommation spécifique ECS:
  note: Besoin_ECS
  variations:
    - si: type de bâtiment = "résidentiel"
      alors: 360 kWh/habitant
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Bureaux"
          - normes thermiques tertiaire = "RE2020"
      alors: 7 kWhef/m2.an
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Bureaux"
          - normes thermiques tertiaire = "RT2012"
      alors: 7 kWhef/m2.an
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Bureaux"
          - normes thermiques tertiaire = "Moyenne française 2021"
      alors: 7 kWhef/m2.an
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Enseignement secondaire"
          - normes thermiques tertiaire = "RE2020"
      alors: 5 kWhef/m2.an
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Enseignement secondaire"
          - normes thermiques tertiaire = "RT2012"
      alors: 5 kWhef/m2.an
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Enseignement secondaire"
          - normes thermiques tertiaire = "Moyenne française 2021"
      alors: 5 kWhef/m2.an
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Commerces"
          - normes thermiques tertiaire = "RE2020"
      alors: 0 kWhef/m2.an
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Commerces"
          - normes thermiques tertiaire = "RT2012"
      alors: 0 kWhef/m2.an
    - si:
        toutes ces conditions:
          - type de bâtiment = "tertiaire"
          - méthode tertiaire = "Commerces"
          - normes thermiques tertiaire = "Moyenne française 2021"
