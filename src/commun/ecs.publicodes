# Production d'ECS additionnelle (ballon électrique / chauffe-eau solaire)
# quand l'équipement de chauffage ne produit pas l'eau chaude sanitaire.
# Valeurs communes à tous les modes de chauffage.

###### Production différenciée d'ECS par lgt / tertiaire

# valeurs communes parmi tous les types d'installation

volume du ballon ECS:
  variations:
    - si: type de production ECS = 'Solaire thermique'
      alors: 50
    - sinon: (besoins eau chaude sanitaire par appartement * ratios . ECS Quantité d'ECS produite par kWh) / 365
  unité: L

chauffe-eau électrique x consommation d'électricité:
  formule: besoins eau chaude sanitaire par appartement / ratios . CHAUF EAU ELEC Rendement stockage ballon
  # unité: kWh/an
  unité: kWh # corrigé pour faire fonctionner la division

surface de panneau nécessaire:
  variations:
    - si: volume du ballon ECS <= 250
      alors: 2.5m2
    - si: volume du ballon ECS <= 400
      alors: 4m2
    - si: volume du ballon ECS <= 550
      alors: 5.5m2
    - si: volume du ballon ECS <= 650
      alors: 6m2
    - sinon: 6m2
  unité: m2

chauffe-eau solaire x appoint d'électricité:
  formule: besoins eau chaude sanitaire par appartement * (1 - ratios . CHAUF EAU SOLAIRE Part du solaire dans la production d'ECS) / ratios . CHAUF EAU SOLAIRE Rendement stockage ballon
  # unité: kWh/an
  unité: kWh # corrigé pour faire fonctionner la division

Calcul Eco . Investissement ballon ECS à accumulation:
  produit:
    - ratios économiques . Chauffe-eau x électrique à accumulation x coût investissement
    - ( 1 + ratios économiques . Investissement x Pose et mise en place de l'installation )

Calcul Eco . Investissement ballon ECS panneau inclus:
  produit:
    - ratios économiques . Chauffe-eau x solaire x coût investissement + ratios économiques . Chauffe-eau x panneaux solaire thermique x coût investissement
    - ( 1 + ratios économiques . Investissement x Pose et mise en place de l'installation )

###### Ratios techniques

ratios . CHAUF EAU ELEC Rendement stockage ballon:
  valeur: 87%
  unité: '%'

ratios . CHAUF EAU ELEC Durée de vie:
  valeur: 20
  unité: an

ratios . CHAUF EAU SOLAIRE Rendement stockage ballon:
  valeur: 87%
  unité: '%'

ratios . CHAUF EAU SOLAIRE Durée de vie:
  valeur: 20
  unité: an

ratios . CHAUF EAU SOLAIRE Part du solaire dans la production d'ECS:
  valeur: 60%
  unité: '%'

###### Ratios économiques (investissement)

ratios économiques . Chauffe-eau x électrique à accumulation x coût investissement:
  produit:
    - variations:
        - si: Puissance installation x Capacité chauffe eau électrique à accumulation <= 50
          alors: 610.8
        - si: Puissance installation x Capacité chauffe eau électrique à accumulation <= 100
          alors: 705.8
        - si: Puissance installation x Capacité chauffe eau électrique à accumulation <= 150
          alors: 802.5
        - si: Puissance installation x Capacité chauffe eau électrique à accumulation <= 200
          alors: 918.3
        - sinon: 918.3
    - 1 + ratios économiques . Investissement x TVA
  unité: €TTC
  note: 'Source: Thermor 2024'

ratios économiques . Chauffe-eau x solaire x coût investissement:
  valeur: ratios économiques . Chauffe-eau x électrique à accumulation x coût investissement
  unité: €TTC

ratios économiques . Chauffe-eau x solaire prix panneaux:
  valeur: 1300
  unité: €HT/m2
  note: 'Source: ADEME 2023'

# pas un ratio
ratios économiques . Chauffe-eau x panneaux solaire thermique x coût investissement:
  produit:
    - surface de panneau nécessaire
    - Chauffe-eau x solaire prix panneaux
    - 1 + ratios économiques . Investissement x TVA
  unité: €TTC

###### Ratios environnementaux

###### Entretien P2 / P3

###### Aides

Calcul Eco . Montant des aides par logement tertiaire . Panneau solaire thermique pour production ECS:
  avec:
    Ma prime renov':
      applicable si:
        est défini: Ma prime renov'
      formule: Ma prime renov'
      unité: €
    Coup de pouce:
      applicable si:
        est défini: Coup de pouce
      formule: Coup de pouce
      unité: €
    CEE:
      variations:
        - si: Paramètres économiques . Aides . Aides x Éligible CEE
          alors:
            variations:
              - si:
                  toutes ces conditions:
                    - type de bâtiment = 'résidentiel'
                    - type de production ECS = 'Solaire thermique'
                alors: besoins eau chaude sanitaire par appartement * ratios . CHAUF EAU SOLAIRE Part du solaire dans la production d'ECS * ratios économiques x aides . CEE x Chauffe-eau solaire collectif x Ratio * Paramètres économiques . Aides . Valeur CEE * nombre de logements dans l'immeuble concerné
              - si: type de bâtiment = 'tertiaire'
                alors: besoins eau chaude sanitaire par appartement * ratios . CHAUF EAU SOLAIRE Part du solaire dans la production d'ECS * ratios économiques x aides . Tertiaire . CEE x Chauffe-eau solaire x Ratio
        - sinon: 0
      unité: €
    Total:
      variations:
        - si: Paramètres économiques . Aides . Éligibilité x Prise en compte des aides
          alors: Ma prime renov' + Coup de pouce + CEE
        - sinon: 0
      unité: €

###### Ratios de besoins ECS

ratios . ECS Quantité d'ECS produite par kWh:
  valeur: 19.1
  unité: L/kWh

ratios . ECS Résidentiel:
  applicable si: type de bâtiment = "résidentiel"
  remplace: consommation spécifique ECS
  valeur: 360
  unité: kWh/habitant

ratios . ECS Bureaux RE2020:
  applicable si:
    toutes ces conditions:
      - type de bâtiment = "tertiaire"
      - méthode tertiaire = "Bureaux"
      - normes thermiques tertiaire = "RE2020"
  remplace: consommation spécifique ECS
  valeur: 7
  unité: kWhef/m2.an

ratios . ECS Bureaux RT2012:
  applicable si:
    toutes ces conditions:
      - type de bâtiment = "tertiaire"
      - méthode tertiaire = "Bureaux"
