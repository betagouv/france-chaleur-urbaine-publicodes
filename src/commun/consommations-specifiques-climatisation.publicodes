# Consommations spécifiques de climatisation (matrices remplace sur
# « consommation spécifique climatisation ») : types tertiaires x sous-zones
# climatiques.

ratios . RAF BureauxH1a:
  applicable si:
    toutes ces conditions:
      - type de bâtiment = "tertiaire"
      - méthode tertiaire = "Bureaux"
      - sous zone climatique = "H1a"
  remplace: consommation spécifique climatisation
  valeur: 29
  unité: kWhef/m2.an
  note: 'Source: ADEME 2024'

