# Entrées utilisateur du simulateur, organisées par domaine. Ces clés sont
# celles que le front écrit ; elles sont canoniques (plus d'alias historique à
# la racine). Les valeurs par défaut renvoient vers les ratios ou vers les
# données département injectées par departements.publicodes.

# --- Localisation et climat ---

climat:
  description: Localisation et données climatiques, déduites de l'adresse
  avec:
    code département:
      # fourni via l'adresse
      question: code département de l'utilisateur

    nom département: climat . nom département # se fait remplacer par les données département

    zone:
      par défaut: climat . zone # se fait remplacer par les données département
      une possibilité:
        - "'H1'"
        - "'H2'"
        - "'H3'"

    sous zone:
      par défaut: climat . sous zone # se fait remplacer par les données département
      une possibilité:
        - "'H1a'"
        - "'H1b'"
        - "'H1c'"
        - "'H2a'"
        - "'H2b'"
        - "'H2c'"
        - "'H2d'"
        - "'H3'"

    # Valeurs départementales : cible des `remplace` de departements.publicodes.
    # Elles servent de défaut aux degrés jours, que le front peut surcharger.
    département:
      avec:
        degré jours chaud: climat . département . degré jours chaud
        degré jours froid: climat . département . degré jours froid

    degré jours chaud:
      par défaut: climat . département . degré jours chaud
      unité: °C
    degré jours froid:
      par défaut: climat . département . degré jours froid
      unité: °C

    température de référence chaud commune:
      # défini en externe via la commune
      unité: °C
    température de référence chaud:
      par défaut: climat . température de référence chaud commune
      unité: °C

    ratios:
      description: Valeurs de référence climatiques
      avec:
        DJU de référence chaud:
          valeur: 2200
          unité: DJU chaud

# --- Caractéristiques du bâtiment ---

bâtiment:
  description: Caractéristiques du bâtiment saisies dans le simulateur
  avec:
    type:
      par défaut: "'résidentiel'"
      une possibilité:
        - "'résidentiel'"
        - "'tertiaire'"

    appartement ou maison:
      valeur: "'Appartement'"

    nombre de logements:
      par défaut:
        variations:
          - si: bâtiment . type = 'tertiaire'
            alors: 1
          - sinon: bâtiment . ratios . nombre de logements

    surface tertiaire:
      par défaut:
        variations:
          - si: bâtiment . type = 'résidentiel'
            alors: bâtiment . ratios . surface de référence appartement
          - sinon: bâtiment . ratios . surface de référence tertiaire

    habitants par logement:
      par défaut: bâtiment . ratios . habitants par logement

    température émetteurs:
      par défaut: "'55'"
      une possibilité:
        - "'35'"
        - "'45'"
        - "'55'"
        - "'65'"
        - "'Plancher'"
        - "'Radiateur'"

    part de la surface à climatiser:
      par défaut:
        variations:
          - si: bâtiment . type = 'résidentiel'
            alors: bâtiment . ratios . part surface à climatiser résidentiel
          - sinon: bâtiment . ratios . part surface à climatiser tertiaire
      unité: '%'

    augmenter la température de chauffe:
      par défaut: 0
      unité: °C

    # Méthode de détermination des besoins : dépend du type de bâtiment
    méthode de calcul:
      par défaut:
        variations:
          - si: bâtiment . type = "résidentiel"
            alors: bâtiment . méthode résidentiel
          - si: bâtiment . type = "tertiaire"
            alors: bâtiment . méthode tertiaire

    # quand bâtiment résidentiel
    méthode résidentiel:
      par défaut: "'DPE'"
      une possibilité:
        - "'Normes thermiques et âge du bâtiment'"
        - "'DPE'"

    DPE:
      par défaut: "'C'"
      une possibilité:
        - "'A'"
        - "'B'"
        - "'C'"
        - "'D'"
        - "'E'"
        - "'F'"
        - "'G'"

    normes thermiques et âge:
      par défaut: "'de 1990 à 2000'"
      une possibilité:
        - "'RE2020 - Après 2020'"
        - "'RT2012 - Entre 2012 et 2020'"
        - "'RT2005 - Entre 2005 et 2012'"
        - "'RT2000 - Entre 2000 et 2005'"
        - "'de 1990 à 2000'"
        - "'de 1974 à 1990'"
        - "'avant 1974'"

    # quand bâtiment tertiaire
    méthode tertiaire:
      par défaut: "'Bureaux'"
      une possibilité:
        - "'Bureaux'"
        - "'Enseignement secondaire'"
        - "'Enseignement primaire'"
        - "'Commerces'"
        - "'Café, restaurant'"
        - "'Hôtel'"
        - "'Sport'"
        - "'EHPAD'"
        - "'Santé'"

    méthode tertiaire 2026:
      par défaut: "'Bureaux'"
      une possibilité:
        - "'Bureaux'"
        - "'Enseignement'"
        - "'Santé'"
        - "'Commerces'"
        - "'Hôtellerie/Restauration'"
        - "'Autres'"

    normes thermiques tertiaire:
      par défaut: "'RE2020'"
      une possibilité:
        - "'RE2020'"
        - "'RT2012'"
        - "'Moyenne française 2021'"

    ratios:
      description: Valeurs de référence du bâtiment (surfaces, occupation, climatisation)
      avec:
        surface de référence appartement:
          valeur: 70
          unité: m2

        surface de référence tertiaire:
          valeur: 2500
          unité: m2

        hauteur sous plafond:
          valeur: 2.2
          unité: m

        habitants par logement:
          valeur: 2.17
          unité: personne

        nombre de logements:
          valeur: 25
          unité: logement

        part surface à climatiser résidentiel:
          valeur: 70%
          unité: '%'

        part surface à climatiser tertiaire:
          valeur: 100%
          unité: '%'

# --- Eau chaude sanitaire et climatisation (choix utilisateur) ---

ecs:
  description: Production d'eau chaude sanitaire (choix utilisateur)
  avec:
    production:
      par défaut: ecs . ratios . production par défaut
    type de production:
      par défaut: "'Avec équipement chauffage'"
      une possibilité:
        - "'Avec équipement chauffage'"
        - "'Chauffe-eau électrique'"
        - "'Solaire thermique'"

    ratios:
      description: Valeurs de référence de la production d'ECS
      avec:
        production par défaut:
          par défaut: oui

climatisation:
  description: Climatisation (choix utilisateur)
  avec:
    incluse:
      par défaut: non
    type de production:
      par défaut: "'Groupe froid'"
      une possibilité:
        - "'Groupe froid'"
        - "'Réseau de froid'"

# --- Besoins énergétiques par logement ---
# Calculés par défaut, surchargeables par le front en mode avancé.
# Les consommations spécifiques sont des tables (voir src/commun/).

besoins:
  description: Besoins énergétiques par logement
  avec:
    chauffage par logement:
      note: Besoin_cha
      par défaut:
        produit:
          - variations:
              - si: bâtiment . méthode de calcul != 'Normes thermiques et âge du bâtiment'
                alors: consommation spécifique chauffage * bâtiment . surface tertiaire * climat . degré jours chaud / climat . ratios . DJU de référence chaud
              - sinon: consommation spécifique chauffage * bâtiment . surface tertiaire * climat . degré jours chaud * 24 * bâtiment . ratios . hauteur sous plafond / 1000
          - 1 + 0.09 * bâtiment . augmenter la température de chauffe
      unité: kWh

    ECS par logement:
      note: Besoin_raf
      par défaut:
        variations:
          - si: ecs . production
            alors:
              variations:
                - si: bâtiment . type = 'résidentiel'
                  alors: 600 + (consommation spécifique ECS * bâtiment . habitants par logement)
                - sinon: consommation spécifique ECS * bâtiment . surface tertiaire
          - sinon: 0
      unité: kWh

    climatisation par logement:
      par défaut:
        variations:
          - si: climatisation . incluse
            alors:
              produit:
                - consommation spécifique climatisation
                - bâtiment . surface tertiaire
                - bâtiment . part de la surface à climatiser
          - sinon: 0
      unité: kWh

# usage interne utilisé pour récupérer les valeurs par défaut des paramètres :
# > engine.evaluate({ valeur: "ma règle", contexte: { "ma règle": "non défini" }})
non défini:
