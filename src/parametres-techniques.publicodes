# --- Généraux ---

code département:
  # fourni via l'adresse
  question: code département de l'utilisateur

département:
département . degré jours unifié spécifique chaud: département . degré jours unifié spécifique chaud # se fait remplacer par les données département
degré jours unifié spécifique chaud:
  par défaut: département . degré jours unifié spécifique chaud
  unité: °C
département . degré jours unifié spécifique froid: département . degré jours unifié spécifique froid # se fait remplacer par les données département
degré jours unifié spécifique froid:
  par défaut: département . degré jours unifié spécifique froid
  unité: °C

température de référence chaud commune:
  # défini en externe via la commune
  unité: °C
température de référence chaud:
  par défaut: climat . température de référence chaud commune
  unité: °C
augmenter la température de chauffe:
  par défaut: 0
  unité: °C

nom département: nom département # se fait remplacer par les données département
zone climatique:
  par défaut: climat . zone # se fait remplacer par les données département
  une possibilité:
    - "'H1'"
    - "'H2'"
    - "'H3'"
sous zone climatique:
  par défaut: climat . sous zone # se fait remplacer par les données département
  une possibilité:
    - "'H1a'"
    - "'H1b'"
    - "'H1c'"
    - "'H2a'"
    - "'H2b'"
    - "'H2c'"
    - "'H2d'"
    - "'H3'"

# --- Réseaux de chaleur et de froid ---

contenu CO2 réseau de chaleur:
  par défaut: réseau de chaleur . caractéristiques . contenu CO2 ACV - réseau de chaleur . ratios . CO2 installation
  note: Contenu_CO2_RCU

# --- Choix du bâtiment ---

type de bâtiment:
  par défaut: "'résidentiel'"
  une possibilité:
    - "'résidentiel'"
    - "'tertiaire'"

nombre de logements dans l'immeuble concerné:
  par défaut:
    variations:
      - si: bâtiment . type = 'tertiaire'
        alors: 1
      - sinon: ratios . GNRL Nombre de logement dans l'immeuble concerné

surface logement type tertiaire:
  par défaut:
    variations:
      - si: bâtiment . type = 'résidentiel'
        alors: ratios . GNRL Surface de référence appartement
      - sinon: ratios . GNRL Surface de référence tertiaire
Nombre d'habitants moyen par appartement:
  par défaut: ratios . GNRL Nombre habitant par logement
Production eau chaude sanitaire:
  par défaut: ratios . GNRL Production ECS
  #une possibilité:
  #  - "'oui'"
  #  - "'non'"

version: 1.0

Inclure la climatisation:
  par défaut: non
  #une possibilité:
  #  - "'oui'"
  #  - "'non'"

type de production de froid:
  par défaut: "'Groupe froid'"
  une possibilité:
    - "'Groupe froid'"
    - "'Réseau de froid'"

type de production ECS:
  par défaut: "'Avec équipement chauffage'"
  une possibilité:
    - "'Avec équipement chauffage'"
    - "'Chauffe-eau électrique'"
    - "'Solaire thermique'"
Part de la surface à climatiser:
  par défaut:
    variations:
      - si: bâtiment . type = 'résidentiel'
        alors: ratios . GNRL Part surface à climatiser résidentiel
      - sinon: ratios . GNRL Part surface à climatiser tertiaire
  unité: '%'
Température émetteurs:
  par défaut: "'55'"
  une possibilité:
    - "'35'"
    - "'45'"
    - "'55'"
    - "'65'"
    - "'Plancher'"
    - "'Radiateur'"
# --- Besoins calculés ---

méthode de calcul pour les besoins en chauffage et refroidissement:
  par défaut:
    variations:
      - si: bâtiment . type = "résidentiel"
        alors: bâtiment . méthode résidentiel
      - si: bâtiment . type = "tertiaire"
        alors: bâtiment . méthode tertiaire

# quand bâtiment résidentiel
méthode résidentiel:
  par défaut: "'DPE'"
  une possibilité:
    - "'Normes thermiques et âge du bâtiment'"
    - "'DPE'"

DPE:
  par défaut: "'C'"
  une possibilité:
    - "'A'"
    - "'B'"
    - "'C'"
    - "'D'"
    - "'E'"
    - "'F'"
    - "'G'"

normes thermiques et âge du bâtiment:
  par défaut: "'de 1990 à 2000'"
  une possibilité:
    - "'RE2020 - Après 2020'"
    - "'RT2012 - Entre 2012 et 2020'"
    - "'RT2005 - Entre 2005 et 2012'"
    - "'RT2000 - Entre 2000 et 2005'"
    - "'de 1990 à 2000'"
    - "'de 1974 à 1990'"
    - "'avant 1974'"

# quand bâtiment tertiaire
méthode tertiaire:
  par défaut: "'Bureaux'"
  une possibilité:
    - "'Bureaux'"
    - "'Enseignement secondaire'"
    - "'Enseignement primaire'"
    - "'Commerces'"
    - "'Café, restaurant'"
    - "'Hôtel'"
    - "'Sport'"
    - "'EHPAD'"
    - "'Santé'"

méthode tertiaire 2026:
  par défaut: "'Bureaux'"
  une possibilité:
    - "'Bureaux'"
    - "'Enseignement'"
    - "'Santé'"
    - "'Commerces'"
    - "'Hôtellerie/Restauration'"
    - "'Autres'"

normes thermiques tertiaire:
  par défaut: "'RE2020'"
  une possibilité:
    - "'RE2020'"
    - "'RT2012'"
    - "'Moyenne française 2021'"

besoins chauffage par appartement:
  note: Besoin_cha
  par défaut:
    produit:
      - variations:
          - si: méthode de calcul pour les besoins en chauffage et refroidissement != 'Normes thermiques et âge du bâtiment'
            alors: besoins . consommation spécifique chauffage * bâtiment . surface tertiaire * climat . degré jours chaud / ratios . GNRL DJU REF chaud
          - sinon: besoins . consommation spécifique chauffage * bâtiment . surface tertiaire * climat . degré jours chaud * 24 * ratios . GNRL Hauteur / 1000
      - 1 + 0.09 * bâtiment . augmenter la température de chauffe
  unité: kWh
besoins eau chaude sanitaire par appartement:
  note: Besoin_raf
  par défaut:
    variations:
      - si: ecs . production
        alors:
          variations:
            - si: bâtiment . type = 'résidentiel'
              alors: 600 + (besoins . consommation spécifique ECS * bâtiment . habitants par logement)
            - sinon: besoins . consommation spécifique ECS * bâtiment . surface tertiaire
      - sinon: 0
  unité: kWh
besoins en climatisation par appartement:
  par défaut:
    variations:
      - si: climatisation . incluse
        alors:
          produit:
            - besoins . consommation spécifique climatisation
            - bâtiment . surface tertiaire
            - bâtiment . part de la surface à climatiser
      - sinon: 0
  unité: kWh

# usage interne utilisé pour récupérer les valeurs par défaut des paramètres :
# > engine.evaluate({ valeur: "ma règle", contexte: { "ma règle": "non défini" }})
non défini:

# --- Vue organisée des entrées utilisateur ---
# Le front écrit les clés historiques (canoniques, définies plus haut) ; ces
# namespaces en sont la vue de lecture organisée — et la table de renommage
# pour la migration du front (les références s'inverseront à ce moment-là).

bâtiment:
  description: Caractéristiques du bâtiment saisies dans le simulateur
  avec:
    type: type de bâtiment
    appartement ou maison: ratios . GNRL Appartement ou maison
    nombre de logements: nombre de logements dans l'immeuble concerné
    surface tertiaire: surface logement type tertiaire
    habitants par logement: Nombre d'habitants moyen par appartement
    méthode résidentiel: méthode résidentiel
    méthode tertiaire: méthode tertiaire
    méthode tertiaire 2026: méthode tertiaire 2026
    normes thermiques et âge: normes thermiques et âge du bâtiment
    normes thermiques tertiaire: normes thermiques tertiaire
    DPE: DPE
    température émetteurs: Température émetteurs
    part de la surface à climatiser: Part de la surface à climatiser
    augmenter la température de chauffe: augmenter la température de chauffe

climat:
  description: Localisation et données climatiques, déduites de l'adresse
  avec:
    code département: code département
    zone: zone climatique
    sous zone: sous zone climatique
    degré jours chaud: degré jours unifié spécifique chaud
    degré jours froid: degré jours unifié spécifique froid
    température de référence chaud: température de référence chaud
    température de référence chaud commune: température de référence chaud commune

besoins:
  description: Besoins énergétiques par logement (calculés, surchargeables par le front en mode avancé)
  avec:
    chauffage par logement: besoins chauffage par appartement
    ECS par logement: besoins eau chaude sanitaire par appartement
    climatisation par logement: besoins en climatisation par appartement
    consommation spécifique chauffage: consommation spécifique chauffage
    consommation spécifique ECS: consommation spécifique ECS
    consommation spécifique climatisation: consommation spécifique climatisation

ecs:
  description: Production d'eau chaude sanitaire (choix utilisateur)
  avec:
    production: Production eau chaude sanitaire
    type de production: type de production ECS

climatisation:
  description: Climatisation (choix utilisateur)
  avec:
    incluse: Inclure la climatisation
    type de production: type de production de froid
