ratios économiques:
  avec:
    #

    Investissement x Pose et mise en place de l'installation:
      formule: 30
      unité: '%'
      note: 'Source: ELCIMAI 2024'
    Investissement x TVA:
      valeur: 20
      unité: '%'
      note: 'source: ELCIMAI 2024'
    Investissement x TVA réduite:
      valeur: 5.5
      unité: '%'
    Amortissement x Taux actualisation:
      valeur: 0
      unité: '%'
      note: 'source: AMORCE'

    Groupe froid:
      # Temporaire le temps que le fichier excel soit à jour
      par défaut: 0

    Chauffe-eau x électrique à accumulation x coût investissement:
      # =IF(affichage="Technicien",XLOOKUP($D$42,'Ratios économiques - Coûts'!$B$195:$B$198,'Ratios économiques - Coûts'!$C$195:$C$198,,1),XLOOKUP($D$42,'Ratios économiques - Coûts'!$B$195:$B$198,'Ratios économiques - Coûts'!$C$195:$C$198,,1)*(1+$D$50))
      produit:
        - variations:
            - si: Puissance installation x Capacité chauffe eau électrique à accumulation <= 50
              alors: 610.8
            - si: Puissance installation x Capacité chauffe eau électrique à accumulation <= 100
              alors: 705.8
            - si: Puissance installation x Capacité chauffe eau électrique à accumulation <= 150
              alors: 802.5
            - si: Puissance installation x Capacité chauffe eau électrique à accumulation <= 200
              alors: 918.3
            - sinon: 918.3
        - 1 + ratios économiques . Investissement x TVA
      unité: €TTC
      note: 'Source: Thermor 2024'

    Chauffe-eau x solaire x coût investissement:
      valeur: ratios économiques . Chauffe-eau x électrique à accumulation x coût investissement
      unité: €TTC

    Chauffe-eau x solaire prix panneaux:
      valeur: 1300
      unité: €HT/m2
      note: 'Source: ADEME 2023'

    # pas un ratio
    Chauffe-eau x panneaux solaire thermique x coût investissement:
      # Param éco B83 =$D$44*'Ratios économiques - Coûts'!$C$207*(1+$D$50)
      produit:
        - surface de panneau nécessaire
        - Chauffe-eau x solaire prix panneaux
        - 1 + ratios économiques . Investissement x TVA
      unité: €TTC

    Coût des combustibles x Electricité:
      avec:
        Option Base:
          avec:
            Coût fournisseur en plus du TURPE souscrit au-delà de 36kVA:
              # A244
              valeur: 15
              unité: '%'
            Prix de l'énergie:
              # D247:D267
              valeur: 0.1708
              unité: €HT/kWh
              note: 'Source: AMORCE 2024'
        Heure pleine x Heure creuse:
          avec:
            Part de la consommation en HP:
              # C238
              valeur: 20
              unité: '%'
              note: 'Source: AMORCE 2024'
            Part de la consommation en HC:
              # C239
              valeur: 100% - Part de la consommation en HP
              unité: '%'
              note: 'Source: AMORCE 2024'
            Prix de l'énergie HP:
              # D273:D292
              valeur: 0.2040
              unité: €HT/kWh
              note: 'Source: ELCIMAI + TRV 2024'
            Prix de l'énergie HC:
              # E273:E292
              valeur: 0.1513
              unité: €HT/kWh
              note: 'Source: ELCIMAI + TRV 2024'
        Abonnement annuel individuel:
          # B247:B267 et C247:C267
          # B273:B292 et C273:C292
          variations:
            - si: Paramètres économiques . Electricité x Puissance souscrite indiv <= 3
              alors:
                variations:
                  - si: Paramètres économiques . Electricité x Option tarifaire = 'Option base'
                    alors: 99.88
                  - si: Paramètres économiques . Electricité x Option tarifaire = 'Heure pleine/Heure creuse'
                    alors: 99.88
