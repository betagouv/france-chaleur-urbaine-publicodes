ratios économiques:
  avec:
    #

    radiateur électrique x puissance de l'installation:
      valeur: 2
      unité: kW

    Investissement x Pose et mise en place de l'installation:
      formule: 30
      unité: '%'
      note: 'Source: ELCIMAI 2024'
    Investissement x TVA:
      valeur: 20
      unité: '%'
      note: 'source: ELCIMAI 2024'
    Investissement x TVA réduite:
      valeur: 5.5
      unité: '%'
    Amortissement x Taux actualisation:
      valeur: 0
      unité: '%'
      note: 'source: AMORCE'

    Réseaux x Coût raccordement RCU SST x Résidentiel:
      variations:
        - si: nombre de logements dans l'immeuble concerné < 25
          alors: 3709 * 25 / nombre de logements dans l'immeuble concerné
        - si: nombre de logements dans l'immeuble concerné < 42
          alors: 3709
        - si: nombre de logements dans l'immeuble concerné < 58
          alors: 2364
        - si: nombre de logements dans l'immeuble concerné < 83
          alors: 1847
        - si: nombre de logements dans l'immeuble concerné < 125
          alors: 1393
        - si: nombre de logements dans l'immeuble concerné < 167
          alors: 1027
        - si: nombre de logements dans l'immeuble concerné < 250
          alors: 857
        - si: nombre de logements dans l'immeuble concerné < 333
          alors: 701
        - sinon: 608
      unité: €HT/logement
      note: 'source: FEDENE 2024'

    Réseaux x Coût Investissement SST RCU:
      # VLOOKUP('Paramètres économiques'!$D$19;'Ratios économiques - Coûts'!$B$363:$C$382;2;TRUE)
      variations:
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 100
          alors: 21500
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 150
          alors: 22500
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 200
          alors: 23500
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 250
          alors: 24500
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 300
          alors: 25500
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 350
          alors: 26000
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 400
          alors: 27000
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 500
          alors: 28000
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 600
          alors: 30000
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 700
          alors: 32000
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 800
          alors: 33500
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 900
          alors: 35500
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 1000
          alors: 37500
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 1500
          alors: 39000
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 2000
          alors: 48500
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 2500
          alors: 57500
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 3000
          alors: 67000
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 4500
          alors: 76000
        - si: Installation x Réseaux de chaleur x Collectif . gamme de puissance existante <= 6000
          alors: 104000
        - sinon: 132000
      unité: €HT
      note: 'ELCIMAI'

    Réseaux x Coût Investissement SST RFU:
      # =VLOOKUP('Paramètres économiques'!$D$20;'Ratios économiques - Coûts'!$B$386:$C$394;2;TRUE)
      variations:
        - si: Installation x Réseaux de froid x Collectif . gamme de puissance existante < 100
          alors: 28000
        - si: Installation x Réseaux de froid x Collectif . gamme de puissance existante < 150
          alors: 29500
        - si: Installation x Réseaux de froid x Collectif . gamme de puissance existante < 200
          alors: 30500
        - si: Installation x Réseaux de froid x Collectif . gamme de puissance existante < 250
          alors: 32000
        - si: Installation x Réseaux de froid x Collectif . gamme de puissance existante < 300
          alors: 33000
        - si: Installation x Réseaux de froid x Collectif . gamme de puissance existante < 350
          alors: 34000
        - si: Installation x Réseaux de froid x Collectif . gamme de puissance existante < 400
          alors: 35000
        - si: Installation x Réseaux de froid x Collectif . gamme de puissance existante < 500
          alors: 36500
        - sinon: 39000
      unité: €HT
      note: 'ELCIMAI'

    Réseaux x Coût raccordement RCU SST x Tertiaire:
      variations:
        - si: surface logement type tertiaire < 2500
          alors: 92725
        - si: surface logement type tertiaire < 3500
          alors: 99305
        - si: surface logement type tertiaire < 5000
          alors: 107146
        - si: surface logement type tertiaire < 7500
          alors: 115621
        - si: surface logement type tertiaire < 10000
          alors: 128398
        - si: surface logement type tertiaire < 15000
          alors: 143072
        - sinon: 175203
      unité: €HT
      note: 'source: FEDENE 2024'

    Réseaux x Coût raccordement RFU x Résidentiel:
      variations:
        - si: nombre de logements dans l'immeuble concerné <= 25
          alors: 4822 * 25 / nombre de logements dans l'immeuble concerné
        - si: nombre de logements dans l'immeuble concerné <= 42
          alors: 4822
        - si: nombre de logements dans l'immeuble concerné <= 58
          alors: 3074
        - si: nombre de logements dans l'immeuble concerné <= 83
          alors: 2402
        - si: nombre de logements dans l'immeuble concerné <= 125
          alors: 1811
        - si: nombre de logements dans l'immeuble concerné <= 167
          alors: 1335
        - si: nombre de logements dans l'immeuble concerné <= 250
          alors: 1114
        - si: nombre de logements dans l'immeuble concerné <= 333
          alors: 911
        - sinon: 790
      unité: €HT/logement
      note: 'source: ELCIMAI'

    Réseaux x Coût raccordement RFU x Tertiaire:
      variations:
        - si: surface logement type tertiaire < 2500
          alors: 120543
        - si: surface logement type tertiaire < 3500
          alors: 129097
        - si: surface logement type tertiaire < 5000
          alors: 139290
        - si: surface logement type tertiaire < 7500
          alors: 150307
        - si: surface logement type tertiaire < 10000
          alors: 166917
        - si: surface logement type tertiaire < 15000
          alors: 185994
        - sinon: 227764
      unité: €HT
      note: 'Source: ELCIMAI'

    Radiateur électrique:
      avec:
        Coût investissement Puissance 2kW:
          valeur: 550
          unité: €HT
          note: 'Source: Atlantic 2023'

    # pas un ratio
    Radiateur électrique x Individuel x investissement total:
      # Param eco B78 =$D$79*'Ratios économiques - Coûts'!$C$189*(1+$D$50)
      par défaut:
        produit:
          - Radiateur électrique x Individuel x nombre de radiateurs électriques nécessaires
          - Radiateur électrique . Coût investissement Puissance 2kW
          - 1 + ratios économiques . Investissement x TVA
      unité: €TTC

    # pas un ratio
    Radiateur électrique x Individuel x nombre de radiateurs électriques nécessaires:
      # Param eco B79 =QUOTIENT('Calculs techniques'!$H$64,'Ratios économiques - Coûts'!$B$189)
      par défaut: Installation x Radiateur électrique x Individuel . gamme de puissance existante // 2

    Groupe froid:
      # Temporaire le temps que le fichier excel soit à jour
      par défaut: 0

    Chauffe-eau x électrique à accumulation x coût investissement:
      # =IF(affichage="Technicien",XLOOKUP($D$42,'Ratios économiques - Coûts'!$B$195:$B$198,'Ratios économiques - Coûts'!$C$195:$C$198,,1),XLOOKUP($D$42,'Ratios économiques - Coûts'!$B$195:$B$198,'Ratios économiques - Coûts'!$C$195:$C$198,,1)*(1+$D$50))
      produit:
        - variations:
            - si: Puissance installation x Capacité chauffe eau électrique à accumulation <= 50
              alors: 610.8
            - si: Puissance installation x Capacité chauffe eau électrique à accumulation <= 100
              alors: 705.8
            - si: Puissance installation x Capacité chauffe eau électrique à accumulation <= 150
              alors: 802.5
            - si: Puissance installation x Capacité chauffe eau électrique à accumulation <= 200
              alors: 918.3
            - sinon: 918.3
        - 1 + ratios économiques . Investissement x TVA
      unité: €TTC
      note: 'Source: Thermor 2024'

    Chauffe-eau x solaire x coût investissement:
      valeur: ratios économiques . Chauffe-eau x électrique à accumulation x coût investissement
      unité: €TTC

    Chauffe-eau x solaire prix panneaux:
      valeur: 1300
      unité: €HT/m2
      note: 'Source: ADEME 2023'

    # pas un ratio
    Chauffe-eau x panneaux solaire thermique x coût investissement:
      # Param éco B83 =$D$44*'Ratios économiques - Coûts'!$C$207*(1+$D$50)
      produit:
        - surface de panneau nécessaire
        - Chauffe-eau x solaire prix panneaux
        - 1 + ratios économiques . Investissement x TVA
      unité: €TTC

    Coût des combustibles x Electricité:
      avec:
        Option Base:
          avec:
            Coût fournisseur en plus du TURPE souscrit au-delà de 36kVA:
              # A244
              valeur: 15
              unité: '%'
            Prix de l'énergie:
              # D247:D267
              valeur: 0.1708
              unité: €HT/kWh
              note: 'Source: AMORCE 2024'
        Heure pleine x Heure creuse:
          avec:
            Part de la consommation en HP:
              # C238
              valeur: 20
              unité: '%'
              note: 'Source: AMORCE 2024'
            Part de la consommation en HC:
              # C239
              valeur: 100% - Part de la consommation en HP
              unité: '%'
              note: 'Source: AMORCE 2024'
            Prix de l'énergie HP:
              # D273:D292
              valeur: 0.2040
              unité: €HT/kWh
              note: 'Source: ELCIMAI + TRV 2024'
            Prix de l'énergie HC:
              # E273:E292
              valeur: 0.1513
              unité: €HT/kWh
              note: 'Source: ELCIMAI + TRV 2024'
        Abonnement annuel individuel:
          # B247:B267 et C247:C267
          # B273:B292 et C273:C292
