        Contribution tarifaire d'acheminement CTA:
          # B247:B267 et J247:J267 et K247:K267
          # B273:B292 et J273:J292
          variations:
            - si: Paramètres économiques . Electricité x Puissance souscrite indiv <= 3
              alors: 0
            - si: Paramètres économiques . Electricité x Puissance souscrite indiv <= 6
              alors:
                variations:
                  - si: Paramètres économiques . Electricité x Option tarifaire = 'Option base'
                    alors: 20.87
                  - si: Paramètres économiques . Electricité x Option tarifaire = 'Heure pleine/Heure creuse'
                    alors: 0
            - si: Paramètres économiques . Electricité x Puissance souscrite indiv <= 9
