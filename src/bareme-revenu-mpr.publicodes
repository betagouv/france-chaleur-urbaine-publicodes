ménage:
  avec:
    revenu:
      question: Revenu fiscal de référence du ménage
      unité: €
      note: "Source : plafonds de ressources MaPrimeRénov' 2026 (ANAH) — https://www.anah.gouv.fr/sites/default/files/2026-03/202603-MPR-modeEmploi_WEB.pdf — màj : annuelle (circulaire en début d'année)"
      avec:
        plafond très modeste:
          unité: €
          formule:
            variations:
              - si: ménage . département IdF
                alors: plafond très modeste IdF
              - sinon: plafond très modeste hors IdF

        plafond modeste:
          unité: €
          formule:
            variations:
              - si: ménage . département IdF
                alors: plafond modeste IdF
              - sinon: plafond modeste hors IdF

        plafond intermédiaire:
          unité: €
          formule:
            variations:
              - si: ménage . département IdF
                alors: plafond intermédiaire IdF
              - sinon: plafond intermédiaire hors IdF

        plafond très modeste IdF:
          unité: €
          note: "Source : plafonds de ressources MaPrimeRénov' 2026 (ANAH) — màj : annuelle (circulaire en début d'année)"
          formule:
            variations:
              - si: bâtiment . habitants par logement = 1
                alors: 24031
              - si: bâtiment . habitants par logement = 2
                alors: 35270
              - si: bâtiment . habitants par logement = 3
                alors: 42357
              - si: bâtiment . habitants par logement = 4
                alors: 49455
              - si: bâtiment . habitants par logement = 5
                alors: 56580
              - sinon: 56580 + ménage . personnes plus * 7116

        plafond modeste IdF:
          unité: €
          note: "Source : plafonds de ressources MaPrimeRénov' 2026 (ANAH) — màj : annuelle (circulaire en début d'année)"
          formule:
            variations:
              - si: bâtiment . habitants par logement = 1
                alors: 29253
              - si: bâtiment . habitants par logement = 2
                alors: 42933
              - si: bâtiment . habitants par logement = 3
                alors: 51564
              - si: bâtiment . habitants par logement = 4
                alors: 60208
              - si: bâtiment . habitants par logement = 5
                alors: 68877
              - sinon: 68877 + ménage . personnes plus * 8663

        plafond intermédiaire IdF:
          unité: €
          note: "Source : plafonds de ressources MaPrimeRénov' 2026 (ANAH) — màj : annuelle (circulaire en début d'année)"
          formule:
            variations:
              - si: bâtiment . habitants par logement = 1
                alors: 40851
              - si: bâtiment . habitants par logement = 2
                alors: 60051
              - si: bâtiment . habitants par logement = 3
                alors: 71846
              - si: bâtiment . habitants par logement = 4
                alors: 84562
              - si: bâtiment . habitants par logement = 5
                alors: 96817
              - sinon: 96817 + ménage . personnes plus * 12257

        plafond très modeste hors IdF:
          unité: €
          note: "Source : plafonds de ressources MaPrimeRénov' 2026 (ANAH) — màj : annuelle (circulaire en début d'année)"
          formule:
            variations:
              - si: bâtiment . habitants par logement = 1
                alors: 17363
              - si: bâtiment . habitants par logement = 2
                alors: 25393
              - si: bâtiment . habitants par logement = 3
                alors: 30540
              - si: bâtiment . habitants par logement = 4
                alors: 35676
              - si: bâtiment . habitants par logement = 5
                alors: 40835
              - sinon: 40835 + ménage . personnes plus * 5151

        plafond modeste hors IdF:
          unité: €
          note: "Source : plafonds de ressources MaPrimeRénov' 2026 (ANAH) — màj : annuelle (circulaire en début d'année)"
          formule:
            variations:
              - si: bâtiment . habitants par logement = 1
                alors: 22259
              - si: bâtiment . habitants par logement = 2
                alors: 32553
              - si: bâtiment . habitants par logement = 3
                alors: 39148
              - si: bâtiment . habitants par logement = 4
                alors: 45735
              - si: bâtiment . habitants par logement = 5
                alors: 52348
              - sinon: 52348 + ménage . personnes plus * 6598

        plafond intermédiaire hors IdF:
          unité: €
          note: "Source : plafonds de ressources MaPrimeRénov' 2026 (ANAH) — màj : annuelle (circulaire en début d'année)"
          formule:
            variations:
              - si: bâtiment . habitants par logement = 1
                alors: 31185
              - si: bâtiment . habitants par logement = 2
                alors: 45842
              - si: bâtiment . habitants par logement = 3
                alors: 55196
              - si: bâtiment . habitants par logement = 4
                alors: 64550
              - si: bâtiment . habitants par logement = 5
                alors: 73907
              - sinon: 73907 + ménage . personnes plus * 9357

        classe:
          formule:
            variations:
              - si: ménage . revenu <= plafond très modeste
                alors: '"Très modeste"'
              - si: ménage . revenu <= plafond modeste
                alors: '"Modeste"'
              - si: ménage . revenu <= plafond intermédiaire
                alors: '"Intermédiaire"'
              - sinon: '"Supérieur"'

    personnes plus:
      formule:
        variations:
          - si: bâtiment . habitants par logement > 5
            alors: bâtiment . habitants par logement - 5
          - sinon: 0

    département IdF:
      formule:
        une de ces conditions:
          - climat . code département = "75"
          - climat . code département = "77"
          - climat . code département = "78"
          - climat . code département = "91"
          - climat . code département = "92"
          - climat . code département = "93"
          - climat . code département = "94"
          - climat . code département = "95"

